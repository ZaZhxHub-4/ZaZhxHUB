local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local lp = Players.LocalPlayer

local WEBHOOK_URL = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"
local httpRequest = (syn and syn.request) or request or http_request or (http and http.request)

-- UI Sederhana
local sg = Instance.new("ScreenGui", CoreGui)
local btn = Instance.new("TextButton", sg)
btn.Size = UDim2.new(0, 220, 0, 60)
btn.Position = UDim2.new(0.5, -110, 0.8, 0)
btn.Text = "📍 SAVE & SEND TO DISCORD"
btn.BackgroundColor3 = Color3.fromRGB(50, 150, 200)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Font = Enum.Font.GothamBold
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

local count = 0

btn.MouseButton1Click:Connect(function()
    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        local pos = lp.Character.HumanoidRootPart.CFrame
        count = count + 1
        
        -- Formatter CFrame agar mudah di-paste ke script nanti
        local posStr = string.format("CFrame.new(%f, %f, %f, %f, %f, %f, %f, %f, %f, %f, %f, %f)", 
            pos.X, pos.Y, pos.Z, 
            pos.RightVector.X, pos.RightVector.Y, pos.RightVector.Z, 
            pos.UpVector.X, pos.UpVector.Y, pos.UpVector.Z, 
            pos.LookVector.X, pos.LookVector.Y, pos.LookVector.Z)

        -- Kirim ke Webhook
        local data = {
            username = "ZHX Mapper",
            embeds = {{
                title = "📍 Booth #" .. count .. " Disimpan",
                description = "Koordinat berhasil ditangkap!",
                fields = {{name = "CFrame Code", value = "```lua\n" .. posStr .. "\n```", inline = false}},
                color = 3066993
            }}
        }

        pcall(function()
            httpRequest({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end)

        btn.Text = "✅ TERKIRIM! (" .. count .. ")"
        task.wait(1.5)
        btn.Text = "📍 SAVE & SEND TO DISCORD"
    end
end)
