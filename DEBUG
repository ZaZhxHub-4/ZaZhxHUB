-- Drag
local UIS = game:GetService("UserInputService")
local drag4 = false; local ds4, sp4
frame.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        drag4 = true; ds4 = inp.Position; sp4 = frame.Position
        inp.Changed:Connect(function()
            if inp.UserInputState == Enum.UserInputState.End then drag4 = false end
        end)
    end
end)
UIS.InputChanged:Connect(function(inp)
    if drag4 and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
        local d = inp.Position - ds4
        local vp = workspace.CurrentCamera.ViewportSize
        frame.Position = UDim2.new(0, math.clamp(sp4.X.Offset+d.X, 0, vp.X-260),
            0, math.clamp(sp4.Y.Offset+d.Y, 0, vp.Y-170))
    end
end)

