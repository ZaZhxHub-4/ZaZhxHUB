local RS = game:GetService("ReplicatedStorage")
local LP = game:GetService("Players").LocalPlayer
local HS = game:GetService("HttpService")

local net = RS.Packages._Index["sleitnick_net@0.2.0"].net
local children = net:GetChildren()

-- Cari remote CreateSaleListing yang ter-hash
local hookTarget = nil
for i, child in ipairs(children) do
    if child.Name == "RF/Trading/CreateSaleListing" then
        local nxt = children[i+1]
        if nxt and nxt:IsA("RemoteFunction") then
            hookTarget = nxt
        end
        break
    end
end

if not hookTarget then error("Remote CreateSaleListing tidak ditemukan") end

-- State log
local logs = {}
local function addLog(line)
    table.insert(logs, line)
    if #logs > 100 then table.remove(logs, 1) end -- jaga biar gak numpuk
    if logLabel then
        logLabel.Text = table.concat(logs, "\n")
        logLabel.Size = UDim2.new(1,0,0, #logs * 16)
        scrollFrame.CanvasSize = UDim2.new(0,0,0, #logs * 16 + 4)
    end
end

-- Hook
local oldInvoke = hookTarget.InvokeServer
hookTarget.InvokeServer = function(self, ...)
    local args = {...}
    addLog("─── 📡 " .. os.date("%H:%M:%S"))
    addLog("Args: " .. #args)
    for i, arg in ipairs(args) do
        if type(arg) == "table" then
            for k, v in pairs(arg) do
                addLog(string.format("  [%d] %s = %s (%s)", i, tostring(k), tostring(v), type(v)))
            end
        else
            addLog(string.format("  [%d] %s (%s)", i, tostring(arg), type(arg)))
        end
    end
    local result = {oldInvoke(self, ...)}
    addLog("Result: " .. tostring(result[1]))
    addLog("")
    return unpack(result)
end

