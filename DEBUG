local showStats = false
local statGui   = nil
local statFrame = nil
local statLbl   = nil
local startTime = tick()
local curFPS    = 60
local fCount    = 0
local lastFT    = tick()

RunService.RenderStepped:Connect(function() fCount = fCount + 1 end)

task.spawn(function()
    while true do
        task.wait(1)
        if not showStats then continue end
        local now = tick(); local dt = now - lastFT
        if dt > 0 then curFPS = fCount / dt; fCount = 0; lastFT = now end
        local up = tick() - startTime
        local h  = math.floor(up / 3600)
        local mi = math.floor((up % 3600) / 60)
        local s  = math.floor(up % 60)
        if statLbl then
            statLbl.Text = string.format("FPS: %.1f  |  Uptime: %02d:%02d:%02d", curFPS, h, mi, s)
        end
    end
end)

