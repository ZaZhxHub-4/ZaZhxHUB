-- ══════════════════════════════════════════════════════════════════
local UIStatusSingle, UIStatusMulti = {}, {}

local function updateAllUIStatus()
    for i=1,MAX_SLOTS do
        if UIStatusSingle[i] then
            if slotData[i].itemId then
                local cnt=#getUUIDsForItemId(slotData[i].itemId, slotData[i].category)
                local txt = "Stok: "..cnt.." | "..(slotData[i].active and "✅ Aktif" or "⛔ Isi harga")
                if slotData[i].active and not slotData[i].listedUUID then txt = txt .. " (Listing...)" end
                UIStatusSingle[i]:SetContent(txt)
            else UIStatusSingle[i]:SetContent("Belum Dipilih") end
        end
    end
    for m=1,MAX_MULTI do
        if UIStatusMulti[m] then
            if #multiSlotData[m].items>0 then
                local tot=getTotalMultiStock(m)
                local txt = "Stok: "..tot.." | "..#multiSlotData[m].items.." item | "..(multiSlotData[m].active and "✅" or "⛔")
                if multiSlotData[m].active and not multiSlotData[m].listedUUID then txt = txt .. " (Listing...)" end
                UIStatusMulti[m]:SetContent(txt)
            else UIStatusMulti[m]:SetContent("Antrian kosong") end
        end
    end
end

