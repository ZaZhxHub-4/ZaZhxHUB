local origCreateWindow = UILib.CreateWindow
UILib.CreateWindow = function(self, config)
    config.Name = "ZHX Hub"
    if config.Logo == nil then config.Logo = ZHX_PNG end
    local win = origCreateWindow(self, config)
    -- Inject green theme
    task.spawn(function()
        local root = win.Root
        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("Frame") and obj.BackgroundColor3 == Color3.fromRGB(0, 255, 128) then
                    obj.BackgroundColor3 = Color3.fromRGB(72, 210, 130)
                end
                if obj:IsA("TextButton") and obj.BackgroundColor3 == Color3.fromRGB(0, 255, 128) then
                    obj.BackgroundColor3 = Color3.fromRGB(72, 210, 130)
                end
                if obj:IsA("ScrollingFrame") then
                    obj.ScrollBarImageColor3 = Color3.fromRGB(72, 210, 130)
                end
            end
        end
    end)
    return win
end

