local noclipConn = nil
local function startNoclip(char)
    if noclipConn then noclipConn:Disconnect() end
    noclipConn = RunService.Stepped:Connect(function()
        if not char or not char.Parent then noclipConn:Disconnect(); noclipConn=nil; return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end
local function stopNoclip(char)
    if noclipConn then noclipConn:Disconnect(); noclipConn=nil end
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then p.CanCollide=true end
    end
end
local function safeTeleport(hrp, char, cf)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local origWalk=hum.WalkSpeed; local origJump=hum.JumpPower; local origAuto=hum.AutoRotate
    hum.WalkSpeed=0; hum.JumpPower=0; hum.AutoRotate=false
    startNoclip(char)
    hrp.Anchored=true; hrp.CFrame=cf; task.wait(0.05); hrp.CFrame=cf; task.wait(0.1); hrp.CFrame=cf
    hrp.Anchored=false; task.wait(0.35)
    hum.WalkSpeed=origWalk; hum.JumpPower=origJump; hum.AutoRotate=origAuto
end

local function checkBoothOwnership()
    if _G.ForceBoothClaimed then return true end
    pcall(function()
        local d=PlayerData:Get("Booth")
        if type(d)=="table" and (d.Active==true or d.Claimed==true) then _G.ForceBoothClaimed=true end
        if PlayerData:Get("HasBooth")==true then _G.ForceBoothClaimed=true end
    end)
    if _G.ForceBoothClaimed then return true end
    local dn=lp.DisplayName or lp.Name
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.ActionText=="Edit Booth" then _G.ForceBoothClaimed=true; return true end
        if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and
           (obj.Text==dn.."'s Booth" or obj.Text==lp.Name.."'s Booth") then
            _G.ForceBoothClaimed=true; return true
        end
    end
    return false
end

local isClaiming=false
local function tryClaimBooth(statusCallback)
    if isClaiming then return end
    if checkBoothOwnership() then if statusCallback then statusCallback("sudah_booth") end; return end
    isClaiming=true
    if statusCallback then statusCallback("mulai") end
    local char=lp.Character; local hrp=char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then isClaiming=false; if statusCallback then statusCallback("error_char") end; return end
    local originalCF=hrp.CFrame; local claimed=false
    for _, cf in ipairs(BOOTH_CFRAMES) do
        safeTeleport(hrp,char,cf)
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.ActionText=="Claim Booth" then
                local worldPos=nil
                if obj.Parent:IsA("Attachment") then
                    pcall(function() worldPos=obj.Parent.WorldPosition end)
                    if not worldPos and obj.Parent.Parent:IsA("BasePart") then worldPos=obj.Parent.Parent.Position end
                elseif obj.Parent:IsA("BasePart") then worldPos=obj.Parent.Position end
                if worldPos and (worldPos-hrp.Position).Magnitude<=20 then
                    local oldLoS=obj.RequiresLineOfSight; local oldDist=obj.MaxActivationDistance
                    obj.RequiresLineOfSight=false; obj.MaxActivationDistance=99
                    pcall(function() fireproximityprompt(obj) end)
                    task.wait(1.5)
                    if checkBoothOwnership() or not obj:IsDescendantOf(Workspace)
                    or not obj.Enabled or obj.ActionText~="Claim Booth" then
                        claimed=true; _G.ForceBoothClaimed=true; break
                    end
                    pcall(function() obj.RequiresLineOfSight=oldLoS; obj.MaxActivationDistance=oldDist end)
                end
            end
        end
        if claimed then break end
        stopNoclip(char); task.wait(0.1)
    end
    isClaiming=false; stopNoclip(char)
    if claimed then
        lastClaimTime=tick(); _G.ForceBoothClaimed=true
        if statusCallback then statusCallback("sukses") end
    else
        pcall(function() hrp.CFrame=originalCF end)
        if statusCallback then statusCallback("penuh") end
    end
end

