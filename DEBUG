local RS = game:GetService("ReplicatedStorage")
local HS = game:GetService("HttpService")

local function sendWebhook(msg)
    pcall(function()
        request({
            Url = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HS:JSONEncode({content = msg})
        })
    end)
end

for _, m in ipairs(getloadedmodules()) do
    if m.Name == "TradeBoothController" then
        local ok, mod = pcall(require, m)
        if ok and type(mod) == "table" then
            -- Cek semua keys termasuk non-function
            local out = ""
            for k, v in pairs(mod) do
                out = out..tostring(k)..": "..type(v).."\n"
            end
            sendWebhook("TradeBoothController keys:\n"..out)
        end
        break
    end
end
