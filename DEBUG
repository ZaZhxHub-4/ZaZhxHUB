local RS = game:GetService("ReplicatedStorage")
local LP = game:GetService("Players").LocalPlayer
local UIS = game:GetService("UserInputService")

local net = RS.Packages._Index["sleitnick_net@0.2.0"].net
local children = net:GetChildren()

-- Cari remote CreateSaleListing yang ter-hash dengan aman
local hookTarget = nil
for i, child in ipairs(children) do
    if child.Name == "RF/Trading/CreateSaleListing" then
        -- Periksa apakah child ini sendiri adalah RemoteFunction
        local inside = child:FindFirstChildOfClass("RemoteFunction")
        if inside then
            hookTarget = inside
        else
            -- Ambil child berikutnya yang merupakan RemoteFunction
            for j = i+1, #children do
                if children[j]:IsA("RemoteFunction") then
                    hookTarget = children[j]
                    break
                end
            end
        end
        break
    end
end

