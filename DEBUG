send("🔍 Phase 4: Active Walk Test dimulai...")

local propsFolder = WS:FindFirstChild("Props")
if not propsFolder then send("❌ Props tidak ditemukan"); return end

local eventName = "Megalodon Hunt"
local isWalking = false

-- Fungsi walk (smooth, noclip)
local function walkTo(targetPos)
    if isWalking then return end
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    isWalking = true
    
    -- Noclip
    local noclipConn = RunService.Stepped:Connect(function()
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then pcall(function() part.CanCollide = false end) end
        end
    end)
    
    local targetCF = CFrame.new(targetPos)
    local startCF = root.CFrame
    local distance = (targetPos - startCF.Position).Magnitude
    local stepSize = 2.5
    local steps = math.max(1, math.ceil(distance / stepSize))
    
    for i = 1, steps do
        local t = i / steps
        local newCF = startCF:Lerp(targetCF, t)
        pcall(function()
            root.CFrame = newCF
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
        end)
        task.wait(0.03 * (0.9 + math.random() * 0.2))
    end
    
    -- Final
    pcall(function()
        root.Anchored = true
        root.CFrame = targetCF
        task.wait(0.3)
        root.Anchored = false
    end)
    
    noclipConn:Disconnect()
    isWalking = false
end

-- Monitor loop
local alreadyWalked = false -- agar tidak walk terus-menerus

task.spawn(function()
    while true do
        local model = propsFolder:FindFirstChild(eventName)
        if model and not alreadyWalked then
            send("🎯 " .. eventName .. " terdeteksi! Mencari posisi...")
            
            -- Cari part untuk posisi
            local primary = model.PrimaryPart
            if not primary then
                -- Cari part bernama "Color" atau part pertama
                for _, obj in ipairs(model:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        primary = obj
                        break
                    end
                end
            end
            
            if primary then
                local pos = primary.Position
                send("📍 Posisi event: " .. tostring(pos))
                send("🚶 Mulai walk ke event...")
                walkTo(pos)
                send("✅ Sampai di event")
                alreadyWalked = true
            else
                send("❌ Tidak bisa mendapatkan posisi event")
            end
        elseif not model and alreadyWalked then
            send("🏁 Event sudah hilang")
            alreadyWalked = false
        end
        
        task.wait(3)
    end
end)

send("✅ Monitor aktif. Jika Megalodon Hunt muncul, user akan otomatis walk ke sana.")
