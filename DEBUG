local PC
for _, m in ipairs(getloadedmodules()) do
    if m.Name == "PromptController" then
        local ok, r = pcall(require, m)
        if ok then PC = r end
        break
    end
end

if not PC then log("GAGAL", "PromptController tidak ada di getloadedmodules"); return end

local function dumpArg(v, depth)
    depth = depth or 0
    if depth > 2 then return "..." end
    local t = type(v)
    if t == "string" then return '"'..v..'"'
    elseif t == "number" then return tostring(v)
    elseif t == "boolean" then return tostring(v)
    elseif t == "function" then return "[function]"
    elseif t == "table" then
        local s = "{\n"
        for k, val in pairs(v) do
            s = s .. string.rep("  ", depth+1).."["..tostring(k).."] = "..dumpArg(val, depth+1).."\n"
        end
        return s .. string.rep("  ", depth).."}"
    elseif typeof(v) == "Instance" then
        return "[Instance:"..v.ClassName..":"..v.Name.."]"
    else
        return tostring(v)
    end
end

for _, funcName in ipairs({"FirePrompt", "FireChoicePrompt"}) do
    if type(PC[funcName]) == "function" then
        local old
        old = hookfunction(PC[funcName], function(...)
            local args = {...}
            local out = ""
            -- skip args[1] (self), dump sisanya
            for i = 2, #args do
                out = out .. "Arg["..i.."]: "..dumpArg(args[i]).."\n\n"
            end
            if out == "" then out = "(tidak ada argumen selain self)" end
            log("CALLED: "..funcName, "```\n"..out.."\n```")
            return old(...)
        end)
        log("HOOK OK", funcName.." berhasil di-hook. Suruh teman request trade sekarang.")
    end
end
