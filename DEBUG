    end)
    y = y + 30

    -- Scale
    local scaleLabel = Instance.new("TextLabel")
    scaleLabel.Size = UDim2.new(1,-16,0,20)
    scaleLabel.Position = UDim2.new(0,8,0,y)
    scaleLabel.BackgroundTransparency = 1
    scaleLabel.Text = "Skala UI: 1.0x"
    scaleLabel.TextColor3 = THEME.TextSecondary
    scaleLabel.TextSize = 10
    scaleLabel.Font = Enum.Font.Gotham
    scaleLabel.Parent = scroll
    y = y + 22
    local scaleRow = Instance.new("Frame")
    scaleRow.Size = UDim2.new(1,-16,0,28)
    scaleRow.Position = UDim2.new(0,8,0,y)
    scaleRow.BackgroundTransparency = 1
    scaleRow.Parent = scroll
    for _, scale in ipairs({1.0, 1.25, 1.5}) do
        local sBtn = Instance.new("TextButton")
        sBtn.Size = UDim2.new(0,50,0,26)
        sBtn.Position = UDim2.new(0, (scale==1.0 and 0 or scale==1.25 and 56 or 112), 0, 0)
        sBtn.BackgroundColor3 = globalScale==scale and THEME.Accent or THEME.TabBtnInactive
        sBtn.BorderSizePixel = 0
        sBtn.Text = scale.."x"
        sBtn.TextColor3 = THEME.TextPrimary
        sBtn.TextSize = 10
        sBtn.Font = Enum.Font.GothamBold
        sBtn.AutoButtonColor = false
        sBtn.Parent = scaleRow
        Instance.new("UICorner", sBtn).CornerRadius = UDim.new(0,4)
        sBtn.MouseButton1Click:Connect(function()
            applyGlobalScale(scale)
            scaleLabel.Text = "Skala UI: "..scale.."x"
            for _, b in ipairs(scaleRow:GetChildren()) do if b:IsA("TextButton") then b.BackgroundColor3 = THEME.TabBtnInactive end end
            sBtn.BackgroundColor3 = THEME.Accent
        end)
    end
    return content
end

