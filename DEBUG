-- Fungsi tombol
walkLockBtn.MouseButton1Click:Connect(function()
    saveCurrentPosition()
    statusLabel.Text = "Mencari event..."
    
    local model = findEventModel("Megalodon Hunt")
    if model then
        local pos = getEventPosition(model)
        if pos then
            statusLabel.Text = "Berjalan ke event..."
            -- Walk ke event (hanya posisi)
            safeWalk(CFrame.new(pos))
            lockUser()
            statusLabel.Text = "Terkunci di lokasi event!"
        else
            statusLabel.Text = "Posisi tidak ditemukan"
        end
    else
        statusLabel.Text = "Event tidak ditemukan"
    end
end)

unlockReturnBtn.MouseButton1Click:Connect(function()
    if not isLocked then
        statusLabel.Text = "User tidak terkunci"
        return
    end
    unlockUser()
    if savedPosition then
        statusLabel.Text = "Kembali ke posisi semula..."
        -- Gunakan safeWalk yang sudah teruji (dengan interpolasi + anchored di akhir)
        safeWalk(savedPosition)
        statusLabel.Text = "Sampai di posisi semula!"
        savedPosition = nil
    else
        statusLabel.Text = "Tidak ada posisi tersimpan"
    end
end)

-- Drag frame
local dragging, dragStart, startPos = false, nil, nil
frame.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = inp.Position; startPos = frame.Position
    end
end)
UIS.InputChanged:Connect(function(inp)
    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
        local delta = inp.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UIS.InputEnded:Connect(function(inp) dragging = false end)

print("Walk & Lock v11 siap. Uji Walk & Lock, lalu Unlock & Safe Return.")
