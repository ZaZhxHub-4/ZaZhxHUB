-- Dummy promise agar game tidak crash saat chain :andThen()
local dummyPromise = {
    andThen = function(self) return self end,
    catch   = function(self) return self end,
    finally = function(self) return self end,
}

tabUtil:toggle("🛡️ Auto Reject Trade Request", false, function(state)
    getgenv().AutoRejectTrade = state
    if state then
        -- Cari PromptController jika belum ditemukan
        if not _promptController then
            for _, m in ipairs(getloadedmodules()) do
                if m.Name == "PromptController" then
                    local ok, r = pcall(require, m)
                    if ok then _promptController = r end
                    break
                end
            end
        end
        if not _promptController then
            w:notify("❌ Gagal", "Fitur ini tidak tersedia di server ini.", 3)
            task.defer(function()
                pcall(function()
                    -- reset toggle
                end)
            end)
            getgenv().AutoRejectTrade = false
            return
        end
        -- Hook hanya sekali, simpan original
        if not _autoRejectHooked then
            _autoRejectHooked = true
            _origFirePrompt   = hookfunction(_promptController.FirePrompt, function(self, ...)
                local args = { ... }
                if getgenv().AutoRejectTrade and type(args[1]) == "string" then
                    if string.find(string.lower(args[1]), "trade request") then
                        -- Return dummy promise agar :andThen() tidak crash
                        return dummyPromise
                    end
                end
                -- Jika fitur OFF atau bukan trade request, jalankan normal
                return _origFirePrompt(self, ...)
            end)
        end
        w:notify("🛡️ Auto Reject", "Aktif. Popup trade tidak akan muncul.", 3)
    else
        -- Saat dimatikan, hook masih aktif tapi flag AutoRejectTrade = false
        -- sehingga semua prompt akan berjalan normal kembali
        w:notify("🛡️ Auto Reject", "Dimatikan. Popup trade kembali normal.", 2)
    end
end, "auto_reject")

