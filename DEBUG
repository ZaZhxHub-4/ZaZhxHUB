local logN = 0
local function log(txt, color)
    logN = logN + 1
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -8, 0, 0)
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.BackgroundTransparency = 1
    l.Text = "[" .. logN .. "] " .. txt
    l.TextColor3 = color or Color3.fromRGB(220, 228, 240)
    l.TextSize = 9
    l.Font = Enum.Font.Gotham
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextWrapped = true
    l.ZIndex = 902
    l.Parent = scroll
    task.defer(function()
        scroll.CanvasPosition = Vector2.new(0, math.huge)
    end)
end

clearBtn.MouseButton1Click:Connect(function()
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end
    logN = 0
    log("Cleared!", Color3.fromRGB(255, 200, 60))
end)

log("Memasang hook...", Color3.fromRGB(255, 200, 60))

local ok, err = pcall(function()
    setthreadidentity(6)
    local orig
    orig = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "InvokeServer" then
            task.spawn(function()
                local args = {...}
                local rfName = "?"
                pcall(function() rfName = self.Name end)

                local parts = {"RF: " .. rfName}
                for i, v in ipairs(args) do
                    local t = type(v)
                    local val = ""
                    if t == "string" then val = v:sub(1, 36)
                    elseif t == "number" or t == "boolean" then val = tostring(v)
                    else val = "[" .. t .. "]" end
                    table.insert(parts, "A"..i.."="..val)
                end

                local hasUUID = false
                for _, v in ipairs(args) do
                    if type(v) == "string" and #v == 36 then hasUUID = true end
                end

                local color = hasUUID
                    and Color3.fromRGB(80, 255, 150)
                    or Color3.fromRGB(160, 160, 180)

                log(table.concat(parts, " | "), color)
            end)
        end
        return orig(self, ...)
    end))
end)

if ok then
    log("✅ Hook terpasang! Buka booth → hapus 1 item", Color3.fromRGB(80, 255, 150))
else
    log("❌ Hook gagal: " .. tostring(err), Color3.fromRGB(255, 80, 80))
end
