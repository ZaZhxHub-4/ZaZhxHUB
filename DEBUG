                            sendEmbed("Terjual Slot "..i, soldName.."\nHarga: "..soldPrice.."\nSisa: "..rem, 3066993)
                            if rem > 0 then
                                task.delay(0.5, function()
                                    if autoOn and not slotListing[i] then listSingleSlot(i); updateAllUIStatus() end
                                end)
                            else
                                s.active = false
                                updateAllUIStatus()
                            end
                        elseif not s.listedUUID and not slotListing[i] then
                            task.spawn(function() if autoOn and not slotListing[i] then listSingleSlot(i); updateAllUIStatus() end end)
                        end
                    end
                    for m = 1, MAX_MULTI do
                        local ms = multiSlotData[m]
                        if not ms.active or #ms.items == 0 then continue end
                        if ms.listedUUID and not snap[ms.listedUUID] then
                            local ci = ms.currentItemIdx
                            local soldName = (ms.items[ci] and ms.items[ci].itemName) or "?"
                            ms.listedUUID = nil
                            ms.currentItemIdx = ci + 1
                            if ms.currentItemIdx > #ms.items then ms.currentItemIdx = 1 end
                            local totalStock = getTotalMultiStock(m)
                            sendEmbed("Terjual Multi "..m, soldName.."\nHarga: "..ms.price.."\nSisa antrian: "..totalStock, 3066993)
                            if totalStock == 0 then
                                ms.active = false
                                updateAllUIStatus()
                            else
                                task.delay(0.5, function() if autoOn and not multiListing[m] then listMultiSlot(m); updateAllUIStatus() end end)
                            end
                        elseif not ms.listedUUID and not multiListing[m] then
                            task.spawn(function() if autoOn and not multiListing[m] then listMultiSlot(m); updateAllUIStatus() end end)
                        end
                    end
                    updateAllUIStatus()
                end
            end)
        else
            autoOn = false
            boothInitializing = false
            Fluent:Notify({Title="Auto Booth OFF", Content="Dihentikan.", Type="Warning", Duration=2})
        end
    end
})

