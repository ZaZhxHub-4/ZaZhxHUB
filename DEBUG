local WEBHOOK = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"
local HS = game:GetService("HttpService")

local function sendLog(title, desc)
    pcall(function()
        request({
            Url = WEBHOOK, Method = "POST", Headers = {["Content-Type"] = "application/json"},
            Body = HS:JSONEncode({ embeds = {{ title = title, description = "```\n" .. string.sub(tostring(desc), 1, 3900) .. "\n```", color = 16776960, footer = { text = "ZHX Debugger" } }} })
        })
    end)
end

local out = {"🔬 START TEST FASE 3 (UI CLEANUP)"}

-- Load UI
local kyri = loadstring(game:HttpGet("https://kyrilib.dev/kyrilib/"))()
local w = kyri.new("ZHX Fase 3 Test", {Theme = {}})
w:tab("Test Area", "box")

-- Beri waktu UI untuk ter-render penuh sebelum dibedah
task.wait(1.5)

local targetGui
for _, child in ipairs(game:GetService("CoreGui"):GetChildren()) do
    if child:IsA("ScreenGui") and (child.Name:lower():find("kyri") or child.Name:lower():find("zhx")) then
        targetGui = child
        break
    end
end
if not targetGui then
    for _, child in ipairs(game.Players.LocalPlayer.PlayerGui:GetChildren()) do
        if child:IsA("ScreenGui") and (child.Name:lower():find("kyri") or child.Name:lower():find("zhx")) then
            targetGui = child
            break
        end
    end
end

if targetGui then
    table.insert(out, "✅ GUI Utama Ditemukan: " .. targetGui.Name)
    
    -- 1. Bunuh Layar/Logo Loading
    local introFound = false
    for _, obj in ipairs(targetGui:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Text:lower():find("kyri") then
            -- Cari parent frame yang menutupi layar
            if obj.Parent:IsA("Frame") and obj.Parent.Size.X.Scale > 0.5 then
                obj.Parent:Destroy()
                introFound = true
                table.insert(out, "✅ Logo Loading Berhasil Dihancurkan.")
                break
            end
        end
    end
    if not introFound then table.insert(out, "⚠️ Logo Loading tidak ditemukan (mungkin sudah hilang/transparan).") end

    -- 2. Bunuh Tombol Mobile Bawaan
    local mobileBtnFound = false
    for _, obj in ipairs(targetGui:GetDescendants()) do
        if (obj:IsA("ImageButton") or obj:IsA("TextButton")) then
            -- Tombol mobile biasanya memiliki ciri khas ukuran spesifik atau nama
            if obj.AbsoluteSize.X < 50 and obj.AbsoluteSize.Y < 50 and obj.Position.Y.Offset < 150 then
                -- Bypass tombol minimize, cari yang stand-alone
                if not obj.Parent:IsA("Frame") or obj.Parent.AbsoluteSize.X > 200 then
                     obj:Destroy()
                     mobileBtnFound = true
                     table.insert(out, "✅ Tombol Mobile Bawaan Berhasil Dibunuh.")
                end
            end
        end
    end
    if not mobileBtnFound then table.insert(out, "⚠️ Tombol Mobile spesifik tidak terdeteksi. (Mohon cek layar Anda di HP)") end

    -- 3. Override Minimize (Hide Penuh)
    local minimizeFound = false
    for _, obj in ipairs(targetGui:GetDescendants()) do
        if obj:IsA("TextButton") and (obj.Text == "−" or obj.Text == "-" or obj.Text == "_") then
            obj.MouseButton1Click:Connect(function()
                task.wait(0.05) -- Tunggu animasi bawaan
                targetGui.Enabled = false
                sendLog("🔍 MINIMIZE TEST", "Tombol minimize bawaan KyriLib ditekan.")
            end)
            minimizeFound = true
            table.insert(out, "✅ Tombol Minimize Di-override menjadi Hide Penuh.")
            break
        end
    end
else
    table.insert(out, "❌ GUI KyriLib Tidak Ditemukan.")
end

sendLog("🔬 HASIL FASE 3", table.concat(out, "\n\n"))
