-- DEBUG: Monitor ProximityPrompt saat claim booth manual
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local char = lp.Character or lp.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")

-- Log semua PP dalam radius 20 setiap 1 detik
game:GetService("RunService").Heartbeat:Connect(function()
    task.wait(1)
end)

local function scanPP()
    local pos = hrp.Position
    print("=== SCAN PP ===")
    for _, obj in ipairs(game:GetService("Workspace"):GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local part = obj.Parent
            if part and part:IsA("BasePart") then
                local dist = (part.Position - pos).Magnitude
                if dist <= 20 then
                    print(string.format("PP: [%s] | Parent: %s | Dist: %.1f | ActionText: %s", 
                        obj.Name, part.Name, dist, obj.ActionText))
                end
            end
        end
    end
    print("=== END ===")
end

-- Scan tiap 2 detik
while task.wait(2) do
    scanPP()
end
