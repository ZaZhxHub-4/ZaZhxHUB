-- Taruh di LocalScript (misal di StarterPlayerScripts atau di dalam tombol GUI)
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- Place ID game kamu (harus sama dengan game tempat private server ini dibuat)
local placeId = game.PlaceId

-- Kode private server, diambil dari link share kamu
local privateServerCode = "6e6946b03820de48bca3d3f833927b2b"

local function joinPrivateServer()
	local success, errMsg = pcall(function()
		TeleportService:TeleportToPrivateServer(placeId, privateServerCode, {player})
	end)

	if not success then
		warn("Gagal teleport ke private server: " .. tostring(errMsg))
	end
end

joinPrivateServer()
