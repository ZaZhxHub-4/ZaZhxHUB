                    if sn then
                        for _,p in ipairs(Players:GetPlayers()) do if p.Name==sn or p.DisplayName==sn then sp=p; break end end
                    end
                    if sp and _declineRF then task.spawn(function() pcall(function() _declineRF:InvokeServer(sp) end) end) end
                    return nil
                end
                return oldFP(self,...)
            end)
        end
