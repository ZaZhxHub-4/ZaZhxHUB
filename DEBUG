-- ─── 5. Watch BindableEvent ───
local function hookBindables(parent)
    pcall(function()
        for _, obj in ipairs(parent:GetDescendants()) do
            if obj:IsA("BindableEvent") or obj:IsA("BindableFunction") then
                pcall(function()
                    if obj:IsA("BindableEvent") then
                        obj.Event:Connect(function(...)
                            if monitoring then
                                local argStr=""
                                pcall(function() argStr=HS:JSONEncode({...}):sub(1,200) end)
                                addLog("BindableEvent", obj.Name, obj:GetFullName(), argStr)
                            end
                        end)
                    end
                end)
            end
        end
    end)
end
