-- TESTER FINAL v2: AUTO REJECT TRADE (PURE HOOKING)
-- Target: FireChoicePrompt
-- 100% Stealth / Anti-Cheat Safe
-- ====================================================

local HttpService = game:GetService("HttpService")
local WebhookURL = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"

-- Global Toggle
getgenv().AutoRejectTrade = true 

local function sendLog(title, desc, color)
    pcall(function()
        request({
            Url = WebhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                username = "🛡️ Trade Blocker",
                embeds = {{
                    title = title,
                    description = desc,
                    color = color or 16711680,
                    footer = {text = "Fish It Auto Reject • " .. os.date("%H:%M:%S")}
                }}
            })
        })
    end)
end

-- Ambil Module langsung dari path yang sudah kita temukan
local RS = game:GetService("ReplicatedStorage")
local targetModule = RS:WaitForChild("Controllers"):WaitForChild("PromptController")
local PromptController = require(targetModule)

if PromptController and type(PromptController.FireChoicePrompt) == "function" then
    
    local oldFireChoice
    oldFireChoice = hookfunction(PromptController.FireChoicePrompt, function(...)
        local args = {...}
        local isTrade = false
        local declineCallback = nil
        local foundText = "Tidak ada teks"

        -- Fungsi detektif untuk membedah argumen yang dikirim game
        local function scanData(data)
            for k, v in pairs(data) do
                local typeV = type(v)
                local strV = tostring(v)
                
                -- Cari indikasi pesan Trade
                if typeV == "string" then
                    local lowerStr = string.lower(strV)
                    if string.find(lowerStr, "trade") or string.find(lowerStr, "request from") then
                        isTrade = true
                        foundText = strV
                    end
                    
                -- Cari fungsi callback untuk tombol Decline/No
                elseif typeV == "function" then
                    local lowerK = string.lower(tostring(k))
                    -- Game biasanya menamai indeks callback dengan "No", "Decline", atau "Cancel"
                    if string.find(lowerK, "no") or string.find(lowerK, "decline") or string.find(lowerK, "cancel") then
                        declineCallback = v
                    end
                
                -- Jika ada table di dalam table, bongkar lagi
                elseif typeV == "table" then
                    scanData(v)
                end
            end
        end

        -- Mulai pembedahan jika fitur menyala
        if getgenv().AutoRejectTrade then
            for _, v in ipairs(args) do
                if type(v) == "table" then
                    scanData(v)
                elseif type(v) == "string" then
                    local lowerStr = string.lower(tostring(v))
                    if string.find(lowerStr, "trade") or string.find(lowerStr, "request from") then
                        isTrade = true
                        foundText = tostring(v)
                    end
                end
            end
        end

        -- EKSEKUSI BLOKIR
        if getgenv().AutoRejectTrade and isTrade then
            local actionLog = "**Pesan Terdeteksi:**\n" .. foundText
            
            -- Jika kita menemukan fungsi tombol "No", paksa eksekusi secara background!
            if declineCallback then
                task.spawn(function()
                    pcall(declineCallback)
                end)
                actionLog = actionLog .. "\n\n✅ *Sistem berhasil menemukan dan menekan tombol 'No' (Decline) secara virtual ke server.*"
            else
                actionLog = actionLog .. "\n\n⚠️ *Fungsi Decline spesifik tidak ditemukan di memori, tapi UI tetap diblokir.*"
            end

            -- Kirim laporan ke Discord
            sendLog("⛔ TRADE DIBLOKIR TOTAL", actionLog, 16711680)
            
            -- RETURN NIL: Ini akan memotong render UI, layar akan tetap bersih!
            return nil
        end

        -- Jika bukan trade request, biarkan UI-nya tetap berjalan seperti biasa
        return oldFireChoice(...)
    end)
    
    sendLog("🎯 AUTO REJECT SIAP!", "Hook berhasil ditanam ke dalam 'FireChoicePrompt'. Menunggu korban...", 3066993)
else
    sendLog("❌ Gagal Hook", "Fungsi FireChoicePrompt tidak terdeteksi meskipun module ditemukan.", 16711680)
end
