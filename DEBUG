stopBtn.MouseButton1Click:Connect(function()
    monitoring=false
    statusLbl.Text="STOP"; statusLbl.TextColor3=Color3.fromRGB(160,170,165)
    startBtn.BackgroundColor3=Color3.fromRGB(20,65,40)
    if #firedLog==0 then
        send("⚠ Kosong","Tidak ada yang tertangkap.\nCoba tekan 'Tangkap SEMUA' lalu rekam ulang.",16776960); return
    end
    send("⏹ Selesai","Total: **"..#firedLog.."**",3066993)
    task.wait(0.3)
    local lines={}
    for i,e in ipairs(firedLog) do
        table.insert(lines,string.format("[%d] **%s** `%s`\nPath: `%s`\nArgs: `%s`",
            i,e.method,e.name,e.path:sub(1,80),e.args~="" and e.args or "(kosong)"))
    end
    local chunk=""; local msgNum=0
    for _,line in ipairs(lines) do
        if #chunk+#line+2>1800 then
            msgNum=msgNum+1; send("📋 Log #"..msgNum,chunk,3447003); task.wait(0.4); chunk=line.."\n\n"
        else chunk=chunk..line.."\n\n" end
    end
    if chunk~="" then msgNum=msgNum+1; send("📋 Log #"..msgNum,chunk,3447003) end
    task.wait(0.3)
    local names={}; local seen={}
    for _,e in ipairs(firedLog) do
        if not seen[e.name] then seen[e.name]=true
            table.insert(names,"• `"..e.name.."` ("..e.method..")") end
    end
    send("📌 Rangkuman Unik",table.concat(names,"\n"),16776960)
end)

