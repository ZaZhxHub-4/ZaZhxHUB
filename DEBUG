-- =====================
-- FUNGSI KIRIM KE WEBHOOK
-- =====================
local function sendToWebhook(remoteName, className, method, args)
    local argStr = ""
    for i, v in ipairs(args) do
        local valType = typeof(v)
        local valStr = tostring(v)
        if valType == "Instance" then
            valStr = "Instance [" .. v.ClassName .. "] -> " .. v.Name
        elseif valType == "string" then
            valStr = '"' .. v .. '"'
        end
        argStr = argStr .. "Arg[" .. i .. "]: " .. valStr .. " (" .. valType .. ")\n"
    end
    if argStr == "" then argStr = "Tidak ada argumen (Kosong)" end

    local data = {
        username = "ZHX Debugger",
        content = "🔍 **Data Trade Berhasil Ditangkap!**",
        embeds = {{
            title = "📡 Remote Terdeteksi: " .. remoteName,
            color = 16711680, -- Merah
            fields = {
                {name = "Tipe", value = className, inline = true},
                {name = "Method", value = method, inline = true},
                {name = "Arguments Fired", value = "```lua\n" .. argStr .. "\n```", inline = false}
            },
            footer = {text = "Waktu: " .. os.date("%H:%M:%S")}
        }}
    }

    local success, err = pcall(function()
        httpRequest({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
    end)
end

-- =====================
-- HOOK NAMECALL (MEMATA-MATAI GAME)
-- =====================
local origNamecall
origNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    -- Hanya catat jika tombol REC sedang aktif, dan ini dari game (bukan dari eksekutor)
    if recording and not checkcaller() then
        if method == "FireServer" or method == "InvokeServer" then
            task.spawn(sendToWebhook, self.Name, self.ClassName, method, args)
        end
    end

    return origNamecall(self, ...)
end))

