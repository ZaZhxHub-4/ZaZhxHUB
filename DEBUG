-- Anti-Crash Table Dumper
local function safeDump(val, depth, seen)
    depth = depth or 0
    seen = seen or {}
    
    -- Batasi kedalaman agar tidak membebani executor
    if depth > 3 then return "{...}" end
    
    if type(val) == "table" then
        if seen[val] then return "{Cyclic/Berulang}" end
        seen[val] = true
        
        local str = "{\n"
        for k, v in pairs(val) do
            str = str .. string.rep("  ", depth + 1) .. "[" .. tostring(k) .. "] = " .. safeDump(v, depth + 1, seen) .. ",\n"
        end
        return str .. string.rep("  ", depth) .. "}"
    elseif type(val) == "string" then
        return '"' .. val .. '"'
    elseif type(val) == "function" then
        return "[Function]"
    elseif typeof(val) == "Instance" then
        return "[Instance: " .. val.ClassName .. "]"
    else
        return tostring(val)
    end
end

if type(PromptController.FireChoicePrompt) == "function" then
