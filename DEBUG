local RS = game:GetService("ReplicatedStorage")
local targetModule = RS:WaitForChild("Controllers"):WaitForChild("PromptController")
local PromptController = require(targetModule)

-- Fungsi untuk membongkar isi table sampai ke dalam (Deep Dump)
local function serialize(val, depth)
    depth = depth or 0
    if depth > 4 then return tostring(val) end -- Batasi kedalaman agar tidak crash
    
    if type(val) == "table" then
        local str = "{\n"
        for k, v in pairs(val) do
            str = str .. string.rep("  ", depth + 1) .. "[" .. tostring(k) .. "] = " .. serialize(v, depth + 1) .. ",\n"
        end
        return str .. string.rep("  ", depth) .. "}"
    elseif type(val) == "string" then
        return '"' .. val .. '"'
    elseif type(val) == "function" then
        return "[Function]"
    elseif typeof(val) == "Instance" then
        return "[Instance: " .. val.ClassName .. " | " .. val.Name .. "]"
    else
        return tostring(val)
    end
end

-- Pasang CCTV di SEMUA fungsi dalam PromptController
local hookedCount = 0
for funcName, funcObj in pairs(PromptController) do
    if type(funcObj) == "function" then
        local oldFunc
        oldFunc = hookfunction(PromptController[funcName], function(...)
            local args = {...}
            local dumpStr = ""
            local isTradeRelated = false

            -- Bongkar semua argumen
            for i, v in ipairs(args) do
                local serializedData = serialize(v)
                dumpStr = dumpStr .. "Arg["..i.."]: " .. serializedData .. "\n\n"
                
                -- Jika di dalam data ini ada kata "trade", tandai untuk direkam!
                if string.find(string.lower(serializedData), "trade") then
                    isTradeRelated = true
                end
            end

            -- Jika ini berhubungan dengan Trade, kirim rekamannya ke Discord
            if isTradeRelated then
                sendLog("🎥 TEREKAM: " .. tostring(funcName), "```lua\n" .. dumpStr .. "\n
```")
            end

            -- Kembalikan fungsi asli agar game berjalan normal (kamu bisa klik 'No' secara manual)
            return oldFunc(...)
        end)
        hookedCount = hookedCount + 1
    end
end

sendLog("🎥 RECORDER SIAP!", "CCTV dipasang pada " .. hookedCount .. " fungsi PromptController.\n\nSilakan test: Suruh temanmu ajak Trade -> Biarkan muncul -> Klik tombol 'No'. Kita lihat log aslinya!")
