-- ========== SAVE / LOAD CONFIG FOR SAVED POSITIONS ==========
local CONFIG_FOLDER = "ZHX_Configs"
local CONFIG_FILE   = CONFIG_FOLDER .. "/SafeWalkSavedPositions.json"

local function ensureFolder()
    if not isfolder or not makefolder then return false end
    if not isfolder(CONFIG_FOLDER) then
        pcall(function() makefolder(CONFIG_FOLDER) end)
    end
    return isfolder(CONFIG_FOLDER)
end

local function saveSavedPositions()
    if not writefile or not ensureFolder() then return end
    local data = {}
    for _, saved in ipairs(state.savedPositions) do
        local cf = saved.cf
        table.insert(data, {
            name = saved.name,
            x = cf.X, y = cf.Y, z = cf.Z,
            r00 = cf.RightVector.X, r01 = cf.RightVector.Y, r02 = cf.RightVector.Z,
            r10 = cf.UpVector.X, r11 = cf.UpVector.Y, r12 = cf.UpVector.Z,
            r20 = -cf.LookVector.X, r21 = -cf.LookVector.Y, r22 = -cf.LookVector.Z,
        })
    end
    pcall(function()
        writefile(CONFIG_FILE, game:GetService("HttpService"):JSONEncode(data))
    end)
end

local function loadSavedPositions()
    if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
    pcall(function()
        local data = game:GetService("HttpService"):JSONDecode(readfile(CONFIG_FILE))
        state.savedPositions = {}
        for _, item in ipairs(data) do
            table.insert(state.savedPositions, {
                name = item.name,
                cf = CFrame.new(item.x, item.y, item.z, item.r00, item.r01, item.r02, item.r10, item.r11, item.r12, item.r20, item.r21, item.r22)
            })
        end
    end)
end

-- ========== NOKLIP AGRESIF ==========
local function enableNoclip()
    if state.noclipConn then return end
    state.noclipConn = RunService.Stepped:Connect(function()
        local char = LP.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanCollide = false end)
            end
        end
    end)
end

local function disableNoclip()
    if state.noclipConn then
        state.noclipConn:Disconnect()
        state.noclipConn = nil
    end
end

-- ========== DAMAGE PROTECTION ==========
local function protectCharacter()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.MaxHealth = 1e9; hum.Health = 1e9 end)
        hum.PlatformStand = true
    end
end

local function unprotectCharacter()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.MaxHealth = 100; hum.Health = 100 end)
        hum.PlatformStand = false
    end
end

-- ========== SMOOTH WALK (WALKSPEED HIGH) ==========
local function smoothWalk(targetCF)
    if state.isWalking then return end
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    state.isWalking = true
    state.stopRequested = false
    enableNoclip()
    protectCharacter()

    -- Simpan walk speed asli
    local origWalkSpeed = hum.WalkSpeed

    -- Set walk speed tinggi agar gerakan cepat & halus
    hum.WalkSpeed = 50

    -- Hitung jarak
    local distance = (targetCF.Position - root.Position).Magnitude
    local travelTime = distance / hum.WalkSpeed

    -- Gerakkan karakter ke target via Humanoid:MoveTo
    hum:MoveTo(targetCF.Position)

    -- Tunggu sampai dekat atau stop diminta
    local startTime = tick()
    while state.isWalking and not state.stopRequested and (tick() - startTime) < travelTime + 5 do
        if (root.Position - targetCF.Position).Magnitude < 5 then break end
        task.wait(0.1)
    end

    -- Set posisi & rotasi akhir
    if not state.stopRequested then
        pcall(function()
            root.Anchored = true
            root.CFrame = targetCF
            task.wait(0.2)
            root.Anchored = false
        end)
    end

    -- Kembalikan walk speed
    hum.WalkSpeed = origWalkSpeed
    unprotectCharacter()
    disableNoclip()
    state.isWalking = false
    state.stopRequested = false
end

local function stopWalking()
    state.stopRequested = true
    state.isWalking = false
    disableNoclip()
    unprotectCharacter()
end

LP.CharacterAdded:Connect(function()
    state.isWalking = false
