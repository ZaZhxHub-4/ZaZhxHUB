local function getAvailableUUIDForItem(itemId, category, excludeUUIDs)
    excludeUUIDs = excludeUUIDs or {}
    local snap = getInventorySnapshot()
    for _, uuid in ipairs(getUUIDsForItemId(itemId, category)) do
        -- CEK BLACKLIST DISINI AGAR TIDAK LOOPING ITEM YANG DITOLAK
        if snap[uuid] and not excludeUUIDs[uuid] and not blacklistedUUIDs[uuid] then 
            return uuid 
        end
    end
    return nil
end

local function getAllUsedUUIDs(exceptType, exceptIdx)
    local used={}
    for i=1,MAX_SLOTS do if not(exceptType=="single" and i==exceptIdx) and slotData[i].listedUUID then used[slotData[i].listedUUID]=true end end
    for m=1,MAX_MULTI do if not(exceptType=="multi" and m==exceptIdx) and multiSlotData[m].listedUUID then used[multiSlotData[m].listedUUID]=true end end
    return used
end

local function listSingleSlot(idx)
    local s = slotData[idx]
    if not s.itemId or not s.active or slotListing[idx] or not capturedRF then return false end
    
    local uuid = getAvailableUUIDForItem(s.itemId, s.category, getAllUsedUUIDs("single",idx))
    if not uuid then 
        s.active = false
        Notifier.new({ Title="Info Slot "..idx, Content="Stok "..s.itemName.." habis atau semua terkunci.", Duration=3, Icon=ZHX_PNG })
        return false, "Habis" 
    end
    
    slotListing[idx] = true
    -- DIPASTIKAN HARGA DIBULATKAN KE INTEGER (math.floor)
    local ok, result = pcall(function() return capturedRF:InvokeServer("Booth", s.category, uuid, math.floor(s.price)) end)
    slotListing[idx] = false
    
    -- JIKA ERROR LUA ATAU SERVER TEGAS MENGEMBALIKAN FALSE/STRING ERROR
    if not ok or result == false or type(result) == "string" then
        blacklistedUUIDs[uuid] = true -- BLACKLIST UUID INI AGAR TIDAK DICOBA LAGI!
        Notifier.new({ Title="Ditolak", Content="Item Slot "..idx.." terkunci (Equipped?). Mencoba UUID lain...", Duration=2, Icon=ZHX_PNG })
        s.listedUUID = nil
        return false
    end
    
    -- SUKSES!
    s.listedUUID = uuid
    return true
end

local function listMultiSlot(mIdx)
    local ms = multiSlotData[mIdx]
    if not ms.active or #ms.items==0 or multiListing[mIdx] or not capturedRF then return false end
    
    local total = #ms.items; local found = false
    for _=1,total do
        if ms.currentItemIdx>total then ms.currentItemIdx=1 end
        local it=ms.items[ms.currentItemIdx]
        if it and #getUUIDsForItemId(it.itemId, it.category)>0 then found=true; break
        else ms.currentItemIdx=ms.currentItemIdx+1 end
    end
    if not found then ms.active=false; return false,"Habis" end
    
    local it = ms.items[ms.currentItemIdx]
    local uuid = getAvailableUUIDForItem(it.itemId, it.category, getAllUsedUUIDs("multi",mIdx))
    if not uuid then
        ms.currentItemIdx = ms.currentItemIdx+1
        if ms.currentItemIdx > total then ms.currentItemIdx=1 end
        return false
    end
    
    multiListing[mIdx] = true
    local ok, result = pcall(function() return capturedRF:InvokeServer("Booth", it.category, uuid, math.floor(ms.price)) end)
    multiListing[mIdx] = false
    
    if not ok or result == false or type(result) == "string" then
        blacklistedUUIDs[uuid] = true -- BLACKLIST UUID
        Notifier.new({ Title="Ditolak", Content="Item Multi-"..mIdx.." ditolak. Mencoba UUID lain...", Duration=2, Icon=ZHX_PNG })
        ms.listedUUID = nil
        return false
    end
    
    ms.listedUUID = uuid
    return true
end

local function getTotalMultiStock(mIdx)
    local t=0; for _,it in ipairs(multiSlotData[mIdx].items) do t=t+#getUUIDsForItemId(it.itemId, it.category) end; return t
end

