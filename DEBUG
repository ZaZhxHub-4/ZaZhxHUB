-- Fungsi kirim ke Discord
local function sendToDiscord(title, description, color)
    pcall(function()
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                username = "🔧 Debug Equip/Unequip",
                embeds = {{
                    title = title,
                    description = description,
                    color = color or 3066993,
                    footer = {text = os.date("%H:%M:%S")}
                }}
            })
        })
    end)
end

-- Hook EquipToolFromHotbar
local oldEquipFire = equipRemote.FireServer
equipRemote.FireServer = function(self, ...)
    local args = {...}
    local argsStr = {}
    for i, arg in ipairs(args) do
        if type(arg) == "string" then
            argsStr[i] = string.format("[%d] = %q", i, arg)
        elseif type(arg) == "number" then
            argsStr[i] = string.format("[%d] = %s", i, tostring(arg))
        elseif type(arg) == "boolean" then
            argsStr[i] = string.format("[%d] = %s", i, tostring(arg))
        elseif type(arg) == "table" then
            -- Coba lihat isi table (mungkin berisi tool UUID atau itemId)
            local tblStr = {}
            for k, v in pairs(arg) do
                if type(v) == "string" then
                    tblStr[#tblStr+1] = string.format("%s = %q", tostring(k), v)
                else
                    tblStr[#tblStr+1] = string.format("%s = %s", tostring(k), tostring(v))
                end
            end
            argsStr[i] = string.format("[%d] = { %s }", i, table.concat(tblStr, ", "))
        else
            argsStr[i] = string.format("[%d] = %s", i, tostring(arg))
        end
    end
    sendToDiscord("🎣 EQUIP ROD", string.format("**Remote:** EquipToolFromHotbar\n**Args:**\n%s", table.concat(argsStr, "\n")), 65280)
    return oldEquipFire(self, ...)
end

