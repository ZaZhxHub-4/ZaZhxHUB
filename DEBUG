-- ── INVENTORY: ambil data & bedakan inventory category vs listing category ──
local function fetchItemData(category, id)
    local IU = ItemUtility
    local ok, data = false, nil
    if category == "Pets" and IU.GetPetData then ok, data = pcall(function() return IU:GetPetData(id) end)
    elseif category == "Boats" and IU.GetBoatData then ok, data = pcall(function() return IU:GetBoatData(id) end)
    elseif category == "Emotes" and IU.GetEmoteData then ok, data = pcall(function() return IU:GetEmoteData(id) end)
    elseif category == "Halos" and IU.GetHaloData then ok, data = pcall(function() return IU:GetHaloData(id) end)
    elseif category == "Booths" and IU.GetBoothData then ok, data = pcall(function() return IU:GetBoothData(id) end)
    elseif category == "Totems" and IU.GetTotemData then ok, data = pcall(function() return IU:GetTotemData(id) end)
    elseif category == "Charms" and IU.GetCharmData then ok, data = pcall(function() return IU:GetCharmData(id) end)
    elseif category == "Potions" and IU.GetPotionData then ok, data = pcall(function() return IU:GetPotionData(id) end)
    elseif category == "Baits" and IU.GetBaitData then ok, data = pcall(function() return IU:GetBaitData(id) end)
    elseif category == "Lanterns" and IU.GetLanternData then ok, data = pcall(function() return IU:GetLanternData(id) end)
    elseif category == "Pet Eggs" and IU.GetPetEggData then ok, data = pcall(function() return IU:GetPetEggData(id) end)
    end
    
    if ok and data then return data end
    
    if IU.GetItemDataFromItemType then
        ok, data = pcall(function() return IU:GetItemDataFromItemType(category, id) end)
        if ok and data then return data end
    end
    
    ok, data = pcall(function() return IU:GetItemData(id) end)
    if ok and data then return data end
    return nil
end

local function getTrueListingCategory(data, fallback)
    if not data then return fallback end
    if data.Data then
        if data.Data.Type then return data.Data.Type end
        if data.Data.Category then return data.Data.Category end
        if data.Data.ItemType then return data.Data.ItemType end
    end
    if data.Type then return data.Type end
    if data.Category then return data.Category end
    if data.ItemType then return data.ItemType end
    return fallback
end

local function getInventorySnapshot()
    local inv = PlayerData:Get("Inventory")
    if not inv then return {} end
    local t = {}
    for catName, catData in pairs(inv) do
        if type(catData) == "table" then
            local firstVal = catData[1]
            if type(firstVal) == "table" and firstVal.Id and firstVal.UUID then
                for _, item in ipairs(catData) do t[item.UUID] = item.Id end
            else
                for _, subItem in pairs(catData) do
                    if type(subItem) == "table" and subItem.Id and subItem.UUID then
                        t[subItem.UUID] = subItem.Id
                    end
                end
            end
        end
    end
    return t
end

local function getUUIDsForItemId(itemId, inventoryCategory)
    local inv = PlayerData:Get("Inventory")
    if not inv then return {} end
    local uuids = {}
    local catData = inv[inventoryCategory]
    if not catData then return uuids end
    local firstVal = catData[1]
    if type(firstVal) == "table" and firstVal.Id and firstVal.UUID then
        for _, item in ipairs(catData) do
            if item.Id == itemId and item.UUID then table.insert(uuids, item.UUID) end
        end
    else
        for _, subItem in pairs(catData) do
            if type(subItem) == "table" and subItem.Id == itemId and subItem.UUID then table.insert(uuids, subItem.UUID) end
        end
    end
    return uuids
end

local function getInventoryItemListFull()
    local inv = PlayerData:Get("Inventory")
    if not inv then return {} end
    
    local items = {}
    local seen = {}
    
    local function processItem(item, inventoryCat)
        if type(item) == "table" and item.Id and item.UUID then
            local id = item.Id
            local key = inventoryCat .. "_" .. id
            if not seen[key] then
                local data = fetchItemData(inventoryCat, id)
                if data then
                    local name = data.Name or (data.Data and data.Data.Name) or (inventoryCat .. " ID " .. id)
                    local listingCat = getTrueListingCategory(data, inventoryCat)
                    local count = #getUUIDsForItemId(id, inventoryCat)
                    table.insert(items, {
                        name = name,
                        itemId = id,
                        category = listingCat,               -- untuk tampilan & listing
                        inventoryCategory = inventoryCat,     -- untuk cari UUID
                        count = count
                    })
                    seen[key] = true
                end
            end
        end
    end

    for inventoryCat, catData in pairs(inv) do
        if type(catData) == "table" then
            local firstVal = catData[1]
            if type(firstVal) == "table" and firstVal.Id and firstVal.UUID then
                for _, item in ipairs(catData) do processItem(item, inventoryCat) end
            else
                for _, subItem in pairs(catData) do processItem(subItem, inventoryCat) end
            end
        end
    end
    
    -- Urutkan berdasarkan listing category lalu nama
    table.sort(items, function(a, b)
        if a.category ~= b.category then return a.category < b.category end
        return a.name < b.name
    end)
    
    return items
end

local function getInventoryItemList() return getInventoryItemListFull() end

