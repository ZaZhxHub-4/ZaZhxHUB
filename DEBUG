-- STEP 4: Cek getUUIDsForItemId lama (hanya scan inv.Items)
--         vs scan universal — bandingkan untuk beberapa item
-- ============================================================
print("\n=== STEP 4: Perbandingan getUUIDs lama vs universal ===")

-- Fungsi lama (hanya inv.Items)
local function getUUIDsOld(itemId)
    if not inv.Items then return {} end
    local uuids = {}
    for _, item in ipairs(inv.Items) do
        if item.Id == itemId then table.insert(uuids, item.UUID) end
    end
    return uuids
end

-- Fungsi baru (scan semua)
local function getUUIDsNew(itemId)
    local uuids = {}
    for uuid, data in pairs(allUUIDs) do
        if data.Id == itemId then table.insert(uuids, uuid) end
    end
    return uuids
end

