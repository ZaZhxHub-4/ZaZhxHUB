local function getItemName(itemId)
    local ok, data = pcall(function() return ItemUtility:GetItemData(itemId) end)
    if ok and data then
        if data.Data and data.Data.Name then return data.Data.Name end
        if data.Name then return data.Name end
        if type(data) == "string" then return data end
    end
    return "Item#"..tostring(itemId)
end

local function getItemCategory(itemId)
    local ok, data = pcall(function() return ItemUtility:GetItemData(itemId) end)
    if ok and data then
        if data.Data and data.Data.Type then return data.Data.Type end
        if data.Type then return data.Type end
    end
    return "Fish"
end

local function getInventorySnapshot()
    local inv = PlayerData:Get("Inventory")
    if not inv or not inv.Items then return {} end
    local t = {}
    for _, item in ipairs(inv.Items) do t[item.UUID] = item.Id end
    return t
end

local function getUUIDsForItemId(itemId)
    local inv = PlayerData:Get("Inventory")
    if not inv or not inv.Items then return {} end
    local uuids = {}
    for _, item in ipairs(inv.Items) do
        if item.Id == itemId then table.insert(uuids, item.UUID) end
    end
    return uuids
end

local function getInventoryItemList()
    local inv = PlayerData:Get("Inventory")
    if not inv or not inv.Items then return {} end
    local seen, list = {}, {}
    for _, item in ipairs(inv.Items) do
        if item and item.Id and not seen[item.Id] then
            seen[item.Id] = true
            local ok, nameResult = pcall(getItemName, item.Id)
            local ok2, catResult = pcall(getItemCategory, item.Id)
            local itemName = (ok and nameResult) or ("Item#"..tostring(item.Id))
            local itemCat = (ok2 and catResult) or "Fish"
            local count = #getUUIDsForItemId(item.Id)
            table.insert(list, {itemId=item.Id, name=itemName, category=itemCat, count=count})
        end
    end
    table.sort(list, function(a,b) return a.name < b.name end)
    return list
end

local function invokeRemote(remote, ...)
    if not remote then return false end
    if remote:IsA("RemoteFunction") then
        return pcall(function() return remote:InvokeServer(...) end)
    elseif remote:IsA("RemoteEvent") then
        return pcall(function() return remote:FireServer(...) end)
    end
    return false
end

local function getAvailableUUIDForItem(itemId, excludeUUIDs)
    excludeUUIDs = excludeUUIDs or {}
    local snap = getInventorySnapshot()
    local uuids = getUUIDsForItemId(itemId)
    for _, uuid in ipairs(uuids) do
        if snap[uuid] and not excludeUUIDs[uuid] then return uuid end
    end
    return nil
end

local function getAllUsedUUIDs(exceptType, exceptIdx)
    local used = {}
    for i = 1, MAX_SLOTS do
        if not (exceptType=="single" and i==exceptIdx) and slotData[i].listedUUID then
            used[slotData[i].listedUUID] = true
        end
    end
    for m = 1, MAX_MULTI do
        if not (exceptType=="multi" and m==exceptIdx) and multiSlotData[m].listedUUID then
            used[multiSlotData[m].listedUUID] = true
        end
    end
    return used
end

local function isItemUsed(itemId, excludeSingleIdx, excludeMultiIdx)
    for i = 1, MAX_SLOTS do
        if i ~= excludeSingleIdx and slotData[i].itemId == itemId then return true end
    end
    for m = 1, MAX_MULTI do
        if m ~= excludeMultiIdx then
            for _, it in ipairs(multiSlotData[m].items) do
                if it.itemId == itemId then return true end
            end
        end
    end
    return false
end

local function listSingleSlot(idx)
    local s = slotData[idx]
    if not s.itemId or not s.active or slotListing[idx] or not Remotes.Create then return false end
    local uuid = getAvailableUUIDForItem(s.itemId, getAllUsedUUIDs("single", idx))
    if not uuid then s.active=false; return false end
    slotListing[idx] = true
    local ok = invokeRemote(Remotes.Create, s.category, uuid, math.floor(s.price))
    slotListing[idx] = false
    if ok then s.listedUUID = uuid; return true
    else s.listedUUID = nil; return false end
end

local function listMultiSlot(mIdx)
    local ms = multiSlotData[mIdx]
    if not ms.active or #ms.items==0 or multiListing[mIdx] or not Remotes.Create then return false end
    local totalItems = #ms.items
    local found = false
    for _ = 1, totalItems do
        if ms.currentItemIdx > totalItems then ms.currentItemIdx = 1 end
        local it = ms.items[ms.currentItemIdx]
        if it and #getUUIDsForItemId(it.itemId) > 0 then found = true; break
        else ms.currentItemIdx = ms.currentItemIdx + 1 end
    end
    if not found then ms.active=false; return false end
    local it = ms.items[ms.currentItemIdx]
    local used = getAllUsedUUIDs("multi", mIdx)
    local uuid = getAvailableUUIDForItem(it.itemId, used)
    if not uuid then
        ms.currentItemIdx = ms.currentItemIdx + 1
        if ms.currentItemIdx > totalItems then ms.currentItemIdx = 1 end
        return false
    end
    multiListing[mIdx] = true
    local ok = invokeRemote(Remotes.Create, it.category, uuid, math.floor(ms.price))
    multiListing[mIdx] = false
    if ok then ms.listedUUID = uuid; return true
    else ms.listedUUID = nil; return false end
end

local function getTotalMultiStock(mIdx)
    local total = 0
    for _, it in ipairs(multiSlotData[mIdx].items) do
        total = total + #getUUIDsForItemId(it.itemId)
    end
    return total
end

local function updateAllUIStatus()
    for i = 1, MAX_SLOTS do
        if UIElements.SingleStatus[i] then
            if slotData[i].itemId then
                local cnt = #getUUIDsForItemId(slotData[i].itemId)
                UIElements.SingleStatus[i]:SetDesc("Stok: "..cnt.." | "..(slotData[i].active and "Aktif" or "Mati"))
            else
                UIElements.SingleStatus[i]:SetDesc("Kosong")
            end
        end
    end
    for m = 1, MAX_MULTI do
        if UIElements.MultiStatus[m] then
            if #multiSlotData[m].items > 0 then
                local tot = getTotalMultiStock(m)
                UIElements.MultiStatus[m]:SetDesc("Stok: "..tot.." | "..#multiSlotData[m].items.." item | "..(multiSlotData[m].active and "Aktif" or "Mati"))
            else
                UIElements.MultiStatus[m]:SetDesc("Kosong")
            end
        end
    end
end

