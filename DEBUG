-- Script ini akan mengeksekusi Lynx Fish It, lalu secara otomatis mengganti:
-- - Semua teks "Lynx" menjadi "ZHX Hub"
-- - Warna oranye menjadi hijau
-- - Asset ID logo/gambar menjadi rbxassetid://78392602281326

local target_url = "https://raw.githubusercontent.com/4LynxX/all_Game/refs/heads/main/Fish_It.lua"
local MY_ASSET_ID = "rbxassetid://78392602281326"
local MY_NAME = "ZHX Hub"
local GREEN = Color3.fromRGB(0, 255, 85)   -- hijau terang
local ORANGE = Color3.fromRGB(255, 165, 0) -- warna oranye asli Lynx (perkiraan)

-- Fungsi untuk mengganti warna (bisa diperluas)
local function replaceColor(c)
    if c and typeof(c) == "Color3" then
        -- Jika warna mendekati oranye, ganti ke hijau
        if c.r > 0.5 and c.g < 0.5 and c.b < 0.2 then
            return GREEN
        end
    end
    return c
end

-- Hook UI library (contoh untuk Kavo, Aero, dll)
local ui_funcs = {"MakeWindow", "CreateWindow", "AddButton", "AddToggle", "AddSlider", "AddLabel", "AddTab", "NewWindow"}
for _, func_name in ipairs(ui_funcs) do
    if _G[func_name] and type(_G[func_name]) == "function" then
        local old_func = _G[func_name]
        _G[func_name] = function(...)
            local args = {...}
            -- Ubah argumen string
            for i, arg in ipairs(args) do
                if type(arg) == "string" then
                    -- Ganti teks "Lynx" (case-insensitive)
                    arg = arg:gsub("[Ll][Yy][Nn][Xx]", MY_NAME)
                    arg = arg:gsub("lynx", MY_NAME)
                    arg = arg:gsub("LYNX", MY_NAME)
                    args[i] = arg
                elseif type(arg) == "table" then
                    -- Jika ada tabel properti, cari field Text, Color, dll
                    if arg.Text and type(arg.Text) == "string" then
                        arg.Text = arg.Text:gsub("[Ll][Yy][Nn][Xx]", MY_NAME)
                    end
                    if arg.Color and replaceColor(arg.Color) ~= arg.Color then
                        arg.Color = GREEN
                    end
                    if arg.Image and type(arg.Image) == "string" and arg.Image:match("rbxassetid://") then
                        arg.Image = MY_ASSET_ID
                    end
                end
            end
            return old_func(unpack(args))
        end
    end
end

-- Hook Instance.new untuk menangkap ImageLabel, Decal, dll.
local old_new = Instance.new
Instance.new = function(className, parent)
    local inst = old_new(className, parent)
    if className == "ImageLabel" or className == "Decal" or className == "ImageButton" then
        local old_prop = inst.Image
        inst.Image = MY_ASSET_ID
        -- Optional: catat perubahan
        -- print("[ZHX] Replaced image:", old_prop, "->", MY_ASSET_ID)
    elseif className == "TextLabel" or className == "TextButton" or className == "TextBox" then
        -- Hook perubahan teks (tidak langsung, tapi bisa pakai getset)
        local old_text = inst.Text
        if old_text and type(old_text) == "string" then
            inst.Text = old_text:gsub("[Ll][Yy][Nn][Xx]", MY_NAME)
        end
        -- Hook warna
        local old_color = inst.TextColor3
        if old_color and replaceColor(old_color) ~= old_color then
            inst.TextColor3 = GREEN
        end
    end
    return inst
end

-- Hook Color3 baru (untuk color picker)
local old_Color3 = Color3.new
Color3.new = function(r, g, b)
    local c = old_Color3(r, g, b)
    -- Jika warna mendekati oranye (255,165,0) dengan toleransi
    if math.abs(r - 1) < 0.1 and math.abs(g - 0.65) < 0.1 and math.abs(b - 0) < 0.1 then
        return GREEN
    end
    return c
end

-- Load dan jalankan script Lynx
local raw = game:HttpGet(target_url)
local fn, err = loadstring(raw)
if fn then
    print("[ZHX] Memuat script Lynx yang sudah di-rebrand...")
    pcall(fn)
else
    warn("Gagal load script: " .. tostring(err))
end

-- Opsional: setelah script berjalan, cari GUI yang sudah ada dan ganti langsung
task.wait(5)
local function scan_and_replace(gui)
    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local txt = obj.Text
            if txt and txt:find("[Ll][Yy][Nn][Xx]") then
                obj.Text = txt:gsub("[Ll][Yy][Nn][Xx]", MY_NAME)
            end
            if obj.TextColor3 and replaceColor(obj.TextColor3) ~= obj.TextColor3 then
                obj.TextColor3 = GREEN
            end
        elseif obj:IsA("ImageLabel") or obj:IsA("Decal") then
            if obj.Image and obj.Image:match("rbxassetid://") then
                obj.Image = MY_ASSET_ID
            end
        elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
            if obj.BackgroundColor3 and replaceColor(obj.BackgroundColor3) ~= obj.BackgroundColor3 then
                obj.BackgroundColor3 = GREEN
            end
            if obj.BorderColor3 and replaceColor(obj.BorderColor3) ~= obj.BorderColor3 then
                obj.BorderColor3 = GREEN
            end
        end
    end
end

-- Cari ScreenGui utama
for _, gui in ipairs(game.Players.LocalPlayer.PlayerGui:GetChildren()) do
    if gui:IsA("ScreenGui") then
        scan_and_replace(gui)
    end
end

print("[ZHX] Rebranding selesai. UI sekarang mengatasnamakan ZHX Hub.")
