    end
    for m = 1, MAX_MULTI do
        if not (exceptType == "multi" and m == exceptIdx) and multiSlotData[m].listedUUID then
            used[multiSlotData[m].listedUUID] = true
        end
    end
    return used
end

local function listSingleSlot(idx)
    local s = slotData[idx]
    if not s.itemId or not s.active or slotListing[idx] or not capturedRF then return false end
    local uuid = getAvailableUUIDForItem(s.itemId, s.inventoryCategory, getAllUsedUUIDs("single", idx))
    if not uuid then
        s.active = false
        Notifier.new({ Title = "❌ Slot "..idx, Content = "Stok habis atau UUID tidak ditemukan!", Duration = 3, Icon = ZHX_PNG })
        return false, "Habis"
    end
    slotListing[idx] = true
    local success, result = pcall(function()
        return capturedRF:InvokeServer("Booth", s.category, uuid, s.price)  -- s.category = listing category
    end)
    slotListing[idx] = false
    if success and result then
        s.listedUUID = uuid
        return true
    else
        s.listedUUID = nil
        local msg = "Server menolak " .. s.itemName
        if type(result) == "string" then msg = msg .. " (" .. result .. ")" end
        Notifier.new({ Title = "❌ Gagal Pajang", Content = msg, Duration = 3, Icon = ZHX_PNG })
        return false
    end
end

local function listMultiSlot(mIdx)
    local ms = multiSlotData[mIdx]
    if not ms.active or #ms.items == 0 or multiListing[mIdx] or not capturedRF then return false end
    local total = #ms.items
    local found = false
    for _ = 1, total do
        if ms.currentItemIdx > total then ms.currentItemIdx = 1 end
        local it = ms.items[ms.currentItemIdx]
        if it and #getUUIDsForItemId(it.itemId, it.inventoryCategory) > 0 then found = true; break
        else ms.currentItemIdx = ms.currentItemIdx + 1 end
    end
    if not found then
        ms.active = false
        Notifier.new({ Title = "❌ Multi "..mIdx, Content = "Semua item habis.", Duration = 3, Icon = ZHX_PNG })
        return false, "Habis"
    end
    local it = ms.items[ms.currentItemIdx]
    local uuid = getAvailableUUIDForItem(it.itemId, it.inventoryCategory, getAllUsedUUIDs("multi", mIdx))
    if not uuid then
        ms.currentItemIdx = ms.currentItemIdx + 1
        if ms.currentItemIdx > total then ms.currentItemIdx = 1 end
        return false
    end
    multiListing[mIdx] = true
    local success, result = pcall(function()
        return capturedRF:InvokeServer("Booth", it.category, uuid, ms.price)  -- it.category = listing category
    end)
    multiListing[mIdx] = false
    if success and result then
        ms.listedUUID = uuid
        return true
    else
        ms.listedUUID = nil
        local msg = "Server menolak " .. it.itemName
        if type(result) == "string" then msg = msg .. " (" .. result .. ")" end
        Notifier.new({ Title = "❌ Gagal Multi "..mIdx, Content = msg, Duration = 3, Icon = ZHX_PNG })
        return false
    end
end

local function getTotalMultiStock(mIdx)
    local t = 0
    for _, it in ipairs(multiSlotData[mIdx].items) do t = t + #getUUIDsForItemId(it.itemId, it.inventoryCategory) end
    return t
end

