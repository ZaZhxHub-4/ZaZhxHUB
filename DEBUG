tabConfig:button("💾 SIMPAN CONFIG", function()
    local name = cfgNameInp.input.Text
    if not name or name:match("^%s*$") then SendNotify("Error", "Isi nama config!", 3); return end
    local cfg={single={},multi={},webhook=webhookURL}
    local hasAny=false
    for i=1,MAX_SLOTS do
        if slotData[i].itemId and slotData[i].price>0 then
            cfg.single[i]={itemId=slotData[i].itemId,itemName=slotData[i].itemName,category=slotData[i].category,price=slotData[i].price}
            hasAny=true
        end
    end
    for mm=1,MAX_MULTI do
        if #multiSlotData[mm].items>0 then
            cfg.multi[mm]={items={},price=multiSlotData[mm].price}
            for _,it in ipairs(multiSlotData[mm].items) do table.insert(cfg.multi[mm].items,{itemId=it.itemId,itemName=it.itemName,category=it.category}) end
            hasAny=true
        end
    end
    if not hasAny then SendNotify("Error", "Tidak ada slot aktif yang valid!", 3); return end
    savedConfigs[name]=cfg
    if not table.find(configNameList,name) then table.insert(configNameList,name) end
    saveConfigsToFile()
    SendNotify("Tersimpan", "Config '"..name.."' disimpan.", 3)
end)

tabConfig:button("📂 LOAD CONFIG", function()
    local name = cfgNameInp.input.Text
    if not name or not savedConfigs[name] then SendNotify("Error", "Config tidak ditemukan!", 3); return end
    if autoOn then SendNotify("Terkunci", "Matikan Auto Booth dulu!", 3); return end
    if not slotsCreated then SendNotify("Belum Siap", "Tekan MUAT DAFTAR ITEM dulu di Setup!", 3); return end
    
    local cfg=savedConfigs[name]
    for i=1,MAX_SLOTS do
        slotData[i]={itemId=nil,itemName=nil,category=nil,price=0,active=false,listedUUID=nil}
        if cfg.single and cfg.single[i] and nameToIdMap[cfg.single[i].itemName] then
            local s=cfg.single[i]
            slotData[i]={itemId=s.itemId,itemName=s.itemName,category=s.category,price=s.price,active=s.price>0,listedUUID=nil}
        end
        if singleUI[i] then
            if singleUI[i].dd and singleUI[i].dd.set then pcall(function() singleUI[i].dd:set(slotData[i].itemName or "- Kosongkan -") end) end
            if singleUI[i].pr and singleUI[i].pr.input then pcall(function() singleUI[i].pr.input.Text = tostring(slotData[i].price > 0 and slotData[i].price or "") end) end
        end
    end
    
    for mm=1,MAX_MULTI do
        multiSlotData[mm]={items={},price=0,active=false,currentItemIdx=1,listedUUID=nil}
        local validSelections = {}
        if cfg.multi and cfg.multi[mm] and #cfg.multi[mm].items>0 then
            local valid={}
            for _,it in ipairs(cfg.multi[mm].items) do
                if nameToIdMap[it.itemName] then 
                    table.insert(valid,{itemId=it.itemId,itemName=it.itemName,category=it.category}) 
                    table.insert(validSelections, it.itemName)
                end
            end
            if #valid>0 then
                multiSlotData[mm].items=valid; multiSlotData[mm].price=cfg.multi[mm].price
                multiSlotData[mm].active=(cfg.multi[mm].price>0)
            end
        end
        if multiUI[mm] then
            if multiUI[mm].msUI and multiUI[mm].msUI.set then pcall(function() multiUI[mm].msUI:set(validSelections) end) end
            if multiUI[mm].pr and multiUI[mm].pr.input then pcall(function() multiUI[mm].pr.input.Text = tostring(multiSlotData[mm].price > 0 and multiSlotData[mm].price or "") end) end
        end
    end
    
    if cfg.webhook and cfg.webhook~="" then webhookURL=cfg.webhook end
    updateAllUIStatus()
    SendNotify("Dimuat", "Config '"..name.."' berhasil dimuat!", 3)
end)

