-- SCRIPT DEBUG LAPIS 2: Ekstraksi Memori Booth
local gc = getgc(true)
local found = false

for _, v in pairs(gc) do
    if type(v) == "table" then
        -- Mencari tabel yang mengurus data pengiriman Booth
        if rawget(v, "CreateSaleListing") or rawget(v, "ListMenu") or rawget(v, "BoothController") then
            warn("[DEBUG] Tabel Modul Booth Ditemukan!")
            for k, val in pairs(v) do
                print("  -> Kunci:", k, "| Tipe:", type(val))
            end
            found = true
        end
    elseif type(v) == "function" then
        local info = debug.getinfo(v)
        if info.name == "CreateSaleListing" or info.name == "SellItem" then
            warn("[DEBUG] Fungsi Pengirim Ditemukan!")
            for i, upval in pairs(debug.getupvalues(v)) do
                print("  -> Upvalue", i, ":", type(upval), tostring(upval))
            end
            found = true
        end
    end
end

if not found then
    print("[DEBUG] Modul Lapis 2 tersembunyi lebih dalam atau belum dimuat oleh game.")
end
