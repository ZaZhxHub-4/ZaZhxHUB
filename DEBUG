        end
        if not getgenv()._autoRejectHooked then
            getgenv()._autoRejectHooked=true
            local oldFP
            oldFP=hookfunction(_promptController.FirePrompt,function(self,...)
                local args={...}
                if getgenv().AutoRejectTrade and type(args[1])=="string" and string.find(string.lower(args[1]),"trade request") then
