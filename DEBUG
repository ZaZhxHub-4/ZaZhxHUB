    saveBtn.TextColor3 = THEME.TextPrimary
    saveBtn.TextSize = 11
    saveBtn.Font = Enum.Font.GothamBold
    saveBtn.AutoButtonColor = false
    saveBtn.Parent = content
    Instance.new("UICorner", saveBtn).CornerRadius = UDim.new(0,5)
    saveBtn.MouseButton1Click:Connect(function()
        local name = cfgNameInput.Text:gsub("%s+","")
        if name=="" then notify("Isi nama config!"); return end
        local hasAny=false
        for i=1,MAX_SLOTS do if slotData[i].itemId and slotData[i].price>0 then hasAny=true; break end end
        if not hasAny then for m=1,MAX_MULTI do if #multiSlotData[m].items>0 and multiSlotData[m].price>0 then hasAny=true; break end end end
        if not hasAny then notify("Tidak ada slot aktif!"); return end
        local cfg={single={},multi={},webhook=webhookURL}
        for i=1,MAX_SLOTS do if slotData[i].itemId and slotData[i].price>0 then cfg.single[i]={itemId=slotData[i].itemId,itemName=slotData[i].itemName,category=slotData[i].category,price=slotData[i].price} end end
        for mm=1,MAX_MULTI do if #multiSlotData[mm].items>0 then cfg.multi[mm]={items={},price=multiSlotData[mm].price}; for _,it in ipairs(multiSlotData[mm].items) do table.insert(cfg.multi[mm].items,{itemId=it.itemId,itemName=it.itemName,category=it.category}) end end end
        savedConfigs[name]=cfg
        if not table.find(configNameList,name) then table.insert(configNameList,name) end
        if configNameList[1]=="- Belum Ada Config -" then table.remove(configNameList,1) end
        saveConfigsToFile()
        refreshCfgDropdown()
        notify("💾 Config '"..name.."' disimpan.")
    end)
    y = y + 30
    local loadBtn = Instance.new("TextButton")
    loadBtn.Size = UDim2.new(1,-16,0,26)
    loadBtn.Position = UDim2.new(0,8,0,y)
    loadBtn.BackgroundColor3 = THEME.BtnAction
    loadBtn.BorderSizePixel = 0
    loadBtn.Text = "📂 LOAD CONFIG"
    loadBtn.TextColor3 = THEME.TextPrimary
    loadBtn.TextSize = 11
    loadBtn.Font = Enum.Font.GothamBold
    loadBtn.AutoButtonColor = false
    loadBtn.Parent = content
    Instance.new("UICorner", loadBtn).CornerRadius = UDim.new(0,5)
    loadBtn.MouseButton1Click:Connect(function()
        local name = cfgListBtn.Text
        if not name or not savedConfigs[name] then notify("Pilih config valid!"); return end
        if autoOn then notify("Matikan Auto Booth dulu!"); return end
        local ok2,list=pcall(getInventoryItemListFull); if not ok2 then list={} end
        allItemsCache=list; nameToIdMap={}
        for _,it in ipairs(list) do if it.name~="" then nameToIdMap[it.name]={id=it.itemId,cat=it.category} end end
        isLoadingConfig=true
        local cfg=savedConfigs[name]
        for i=1,MAX_SLOTS do
            slotData[i]={itemId=nil,itemName=nil,category=nil,price=0,active=false,listedUUID=nil}
            if cfg.single and cfg.single[i] and nameToIdMap[cfg.single[i].itemName] then
                local s=cfg.single[i]
                slotData[i]={itemId=s.itemId,itemName=s.itemName,category=s.category,price=s.price,active=s.price>0,listedUUID=nil}
            end
        end
        for mm=1,MAX_MULTI do
            multiSlotData[mm]={items={},price=0,active=false,currentItemIdx=1,listedUUID=nil}
            if cfg.multi and cfg.multi[mm] and #cfg.multi[mm].items>0 then
                local valid={}
                for _,it in ipairs(cfg.multi[mm].items) do if nameToIdMap[it.itemName] then table.insert(valid,{itemId=it.itemId,itemName=it.itemName,category=it.category}) end end
                if #valid>0 then multiSlotData[mm].items=valid; multiSlotData[mm].price=cfg.multi[mm].price; multiSlotData[mm].active=(cfg.multi[mm].price>0) end
            end
        end
        if cfg.webhook and cfg.webhook~="" then webhookURL=cfg.webhook; urlInput.Text=cfg.webhook end
        isLoadingConfig=false; updateAllUIStatus()
        notify("📂 Config '"..name.."' dimuat!")
    end)
    y = y + 30
    local delBtn = Instance.new("TextButton")
    delBtn.Size = UDim2.new(1,-16,0,26)
    delBtn.Position = UDim2.new(0,8,0,y)
    delBtn.BackgroundColor3 = THEME.BtnDanger
    delBtn.BorderSizePixel = 0
    delBtn.Text = "🗑 HAPUS CONFIG"
    delBtn.TextColor3 = THEME.TextPrimary
    delBtn.TextSize = 11
    delBtn.Font = Enum.Font.GothamBold
    delBtn.AutoButtonColor = false
    delBtn.Parent = content
    Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0,5)
    delBtn.MouseButton1Click:Connect(function()
        local name = cfgListBtn.Text
        if not name or not savedConfigs[name] then notify("Pilih config valid!"); return end
        savedConfigs[name]=nil
        for i,n in ipairs(configNameList) do if n==name then table.remove(configNameList,i); break end end
        if #configNameList==0 then table.insert(configNameList,"- Belum Ada Config -") end
        saveConfigsToFile()
        refreshCfgDropdown()
        cfgListBtn.Text = configNameList[1]
        notify("🗑 Config '"..name.."' dihapus.")
    end)
    return content
end

