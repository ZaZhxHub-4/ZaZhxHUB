                    return
                end
                local p = tonumber(val) or 0
                multiSlotData[m].price = p; multiSlotData[m].active = (#multiSlotData[m].items > 0 and p > 0)
                updateAllUIStatus()
            end)
            
            multiUI[m] = {statInp=statInp, msUI=msUI, pr=pr}
        end
        SendNotify("✅ Tab Siap", "Tab Single & Multi Slots berhasil dimunculkan!", 3)
