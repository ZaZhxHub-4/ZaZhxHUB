-- SCRIPT AUTO-PANCING [NO MANUAL ACTION]
local RS = game:GetService("ReplicatedStorage")
local ItemUtility = require(RS.Shared.ItemUtility)
local Replion = require(RS.Packages.Replion)

local function getEnchantStoneData()
    local inv = Replion.Client:WaitReplion("Data"):Get("Inventory")
    for _, item in ipairs(inv.Items) do
        local data = ItemUtility:GetItemData(item.Id)
        local n = (data and data.Data and data.Data.Name) or (data and data.Name)
        if n == "Enchant Stone" then return item.UUID, (data and data.Data and data.Data.Type) or "Item" end
    end
    return nil, nil
end

local function autoPancing()
    local uuid, cat = getEnchantStoneData()
    if not uuid then print("[-] Enchant Stone tidak ditemukan di tas.") return end

    -- Cari Remote di memory
    local RF = nil
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "CreateSaleListing") then
            RF = rawget(v, "CreateSaleListing")
            break
        end
    end

    if RF then
        print("[+] Memulai pancingan otomatis...")
        -- Tembak sekali untuk pancing pola (otomatis)
        pcall(function() RF:InvokeServer(uuid, 500) end) 
        print("[+] Pancingan selesai. Pola sekarang tersimpan di cache script.")
    end
end

-- Eksekusi saat script jalan
autoPancing()
