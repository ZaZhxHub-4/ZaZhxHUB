-- ║   ZHX MEMORY SCANNER: HUNTING THE HASHED REMOTES                 ║
-- ╚══════════════════════════════════════════════════════════════════╝
local CoreGui = game:GetService("CoreGui")

local sg = Instance.new("ScreenGui")
sg.Name = "ZHX_MemoryScanner"
pcall(function() sg.Parent = CoreGui end)
if not sg.Parent then sg.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui") end

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 250, 0, 50)
btn.Position = UDim2.new(0.5, -125, 0, 20)
btn.BackgroundColor3 = Color3.fromRGB(50, 50, 200)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 12
btn.Text = "🔍 SCAN MEMORY (CARI KAMUS REMOTE)"
btn.Parent = sg
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

btn.MouseButton1Click:Connect(function()
    btn.Text = "MENCARI... (AWAS NGE-LAG BENTAR)"
    btn.BackgroundColor3 = Color3.fromRGB(200, 150, 50)
    task.wait(0.1)

    local foundTables = 0
    local remoteDictionary = nil

    -- Mengambil seluruh data di memori game
    local gc = getgc(true)
    
    for i, v in pairs(gc) do
        -- Kita mencari tipe "table"
        if type(v) == "table" then
            local hasRemote = false
            local hasStringKey = false
            
            -- Kita cek secara aman apakah isi tabel ini mengandung Remote
            pcall(function()
                for key, val in pairs(v) do
                    if type(key) == "string" and typeof(val) == "Instance" then
                        if val:IsA("RemoteEvent") or val:IsA("RemoteFunction") then
                            hasRemote = true
                            hasStringKey = true
                            break
                        end
                    end
                end
            end)

            -- Jika tabel ini berisi string (misal: "Trade") dan isinya RemoteFunction, ini target kita!
            if hasRemote and hasStringKey then
                foundTables = foundTables + 1
                warn("-----------------------------------------")
                warn("TABEL KANDIDAT #" .. foundTables .. " DITEMUKAN DI MEMORI!")
                
                -- Print isi tabelnya ke console (F9)
                for key, val in pairs(v) do
                    if type(key) == "string" and typeof(val) == "Instance" then
                        print("🔑 Kunci: [" .. key .. "] ---> Remote: " .. val.Name)
                    end
                end
            end
        end
    end

    btn.Text = "✅ SELESAI! BUKA F9 (CONSOLE)"
    btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    print("-----------------------------------------")
    print("PENCARIAN SELESAI. Total tabel mencurigakan:", foundTables)
    print("Silakan cari tulisan seperti 'Trade', 'Decline', 'Booth', atau 'List' di atas!")
    
    task.delay(4, function() sg:Destroy() end)
end)
