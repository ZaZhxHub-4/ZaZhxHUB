local function sendLog(title, desc, color)
    pcall(function()
        request({
            Url = WebhookURL, Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                username = "🛡️ Smart Blocker",
                embeds = {{ title = title, description = desc, color = color or 16711680 }}
            })
        })
    end)
end

-- Ambil PromptController dari memori
local PromptController = nil
for _, mod in ipairs(getloadedmodules()) do
    if mod.Name == "PromptController" then
        pcall(function() PromptController = require(mod) end)
        break
    end
end

if PromptController and type(PromptController.FirePrompt) == "function" then
    local oldFirePrompt
    oldFirePrompt = hookfunction(PromptController.FirePrompt, function(self, ...)
        local args = {...}
        
        -- Filter berdasarkan log asli: Argumen ke-2 adalah string pesan
        if getgenv().AutoRejectTrade and type(args[1]) == "string" then
            local msg = string.lower(args[1])
            if string.find(msg, "trade request") then
                sendLog("⛔ TRADE BLOCKED", "UI Trade berhasil diblokir!\nPesan: **" .. args[1] .. "**", 16711680)
                return nil -- Memotong eksekusi agar UI tidak muncul
            end
        end
        
        return oldFirePrompt(self, ...)
    end)
    
    sendLog("✅ SMART REJECT V5 AKTIF", "Sistem siap memblokir FirePrompt secara stealth.", 3066993)
else
    sendLog("❌ GAGAL HOOK", "FirePrompt tidak ditemukan di PromptController.", 16711680)
