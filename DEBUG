-- FUNGSI MEMBUAT FLOATING BUTTON ZHX (seperti di v16 Anda)
-- ══════════════════════════════════════════════════════════════════
local function createFloatingButton()
    floatingGui = Instance.new("ScreenGui")
    floatingGui.Name           = "ZHX_ToggleGui"
    floatingGui.ResetOnSpawn   = false
    floatingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    floatingGui.Enabled        = true
    floatingGui.Parent         = pg

    zhxBtn = Instance.new("ImageButton")
    zhxBtn.Size             = UDim2.new(0, 46, 0, 46)
    zhxBtn.Position         = UDim2.new(0, 12, 0, 100)
    zhxBtn.BackgroundColor3 = Color3.fromRGB(15, 18, 26)
    zhxBtn.BorderSizePixel  = 0
    zhxBtn.Image            = ZHX_FLOAT
    zhxBtn.ScaleType        = Enum.ScaleType.Fit
    zhxBtn.ZIndex           = 9999
    zhxBtn.Parent           = floatingGui

    Instance.new("UICorner", zhxBtn).CornerRadius = UDim.new(0, 10)

    local stroke = Instance.new("UIStroke", zhxBtn)
    stroke.Color     = Color3.fromRGB(72, 210, 130)
    stroke.Thickness = 1.5

    -- Drag support
    local dragStart, startPos
    local clickStartPos = Vector2.new()

    zhxBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragStart     = input.Position
            startPos      = zhxBtn.Position
            clickStartPos = Vector2.new(input.Position.X, input.Position.Y)
        end
    end)

    zhxBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            local currentPos = Vector2.new(input.Position.X, input.Position.Y)
            local distance   = (currentPos - clickStartPos).Magnitude
            -- Jika hampir tidak ada gerakan, anggap sebagai klik
            if distance < 6 then
                -- Toggle panel Orion
                if OrionWindow then
                    -- Orion Window punya flag Visible, kita bisa set langsung
                    OrionWindow.Visible = not OrionWindow.Visible
                end
            end
            dragStart = nil
            startPos  = nil
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragStart and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta      = input.Position - dragStart
            local viewport   = Workspace.CurrentCamera.ViewportSize
            local newX       = math.clamp(startPos.X.Offset + delta.X, 0, viewport.X - 46)
            local newY       = math.clamp(startPos.Y.Offset + delta.Y, 0, viewport.Y - 46)
            zhxBtn.Position  = UDim2.new(0, newX, 0, newY)
        end
    end)
end

