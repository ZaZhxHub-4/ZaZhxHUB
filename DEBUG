-- ─── Kirim ke Discord ───
local function sendToDiscord(content)
    pcall(function()
        request({
            Url     = WEBHOOK_URL,
            Method  = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body    = HS:JSONEncode({
                username = "📍 ZHX Coord Recorder",
                content  = content
            })
        })
    end)
end

local function sendEmbedDiscord(title, desc)
    pcall(function()
        request({
            Url     = WEBHOOK_URL,
            Method  = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body    = HS:JSONEncode({
                username = "📍 ZHX Coord Recorder",
