local function serialize(val, indent)
    indent = indent or ""
    if type(val) == "table" then
        local str = "{\n"
        for k, v in pairs(val) do
            str = str .. indent .. "  [" .. tostring(k) .. "] = " .. serialize(v, indent .. "  ") .. ",\n"
        end
        return str .. indent .. "}"
    elseif type(val) == "string" then
        return '"' .. val .. '"'
    else
        return tostring(val)
    end
end

