    local hl  = Compkiller.Colors.Highlight        or Color3.fromRGB(72,210,130)
    local bg  = Compkiller.Colors.BlockBackground or Color3.fromRGB(32,35,42)
    local drop = Compkiller.Colors.DropColor      or Color3.fromRGB(45,50,58)
    return hl, bg, drop
end

local function closeCustomDropdown()
    if customDropConn then customDropConn:Disconnect(); customDropConn=nil end
    if customDropGui then
        customDropGui:Destroy()
        customDropGui  = nil
        customDropFrame = nil
    end
    activeDropType = nil
    activeDropIdx  = nil
end

local function getDropdownPosition()
    local vp   = workspace.CurrentCamera.ViewportSize
    local scale = currentGlobalScale
    local winRoot = Window.Root
    local panelFrame = nil
    if winRoot then
        for _, obj in ipairs(winRoot:GetChildren()) do
            if obj:IsA("Frame") and obj.ZIndex == 4 then
                panelFrame = obj; break
            end
        end
    end

    local px, py = 0, 0
    if panelFrame then
        local absPos = panelFrame.AbsolutePosition
        local absSize = panelFrame.AbsoluteSize
        px = absPos.X + absSize.X + 6
        py = absPos.Y
    else
        px = vp.X/2 + (PANEL_W * scale)/2 + 6
        py = vp.Y/2 - (DROP_H * scale)/2
    end

    local dropW = DROP_W * scale
    local dropH = DROP_H * scale
    if px + dropW > vp.X then px = vp.X - dropW - 4 end
    if py + dropH > vp.Y then py = vp.Y - dropH - 4 end
    if py < 0 then py = 4 end

    return px, py, dropW, dropH, scale
end

