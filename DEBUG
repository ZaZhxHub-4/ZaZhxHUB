-- Fungsi kirim ke Discord (dengan chunking)
local function sendToDiscord(title, content, color)
    if not httpRequest then
        warn("HTTP tidak didukung, akan pakai UI panel saja.")
        return false
    end
    color = color or 3066993
    local success, err = pcall(function()
        httpRequest({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                username = "ZHX Resolver",
                embeds = {{
                    title = title,
                    description = content,
                    color = color,
                    footer = {text = os.date("%Y-%m-%d %H:%M:%S")}
                }}
            })
        })
    end)
    return success
end

