-- ─── 1. hookmetamethod __namecall (semua RF/RE tanpa filter) ───
local oldNC
oldNC = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if monitoring then
        if method=="FireServer" or method=="InvokeServer" or method=="Fire" or method=="InvokeClient" then
            local argStr=""
            pcall(function() argStr=HS:JSONEncode({...}):sub(1,200) end)
            local name=""; pcall(function() name=tostring(self.Name) end)
            local path=""; pcall(function() path=tostring(self:GetFullName()) end)
            -- Skip analytics noise
            if not name:find("Analytics") and not name:find("Heartbeat") then
                addLog(method, name, path, argStr)
            end
        end
    end
    return oldNC(self, ...)
end)

-- ─── 2. Monitor perubahan karakter (attribute/property changed) ───
-- Equip item sering trigger perubahan di character atau backpack
local charConn = nil
local function watchCharacter(char)
    if not char then return end
    -- Watch semua attribute change di character descendants
    for _, obj in ipairs(char:GetDescendants()) do
        pcall(function()
            obj.AttributeChanged:Connect(function(attr)
                if monitoring then
                    addLog("AttrChange", obj.Name, obj:GetFullName(), "attr:"..attr.."="..tostring(obj:GetAttribute(attr)))
                end
            end)
        end)
        -- Watch property changed untuk Tool/Equipment
        if obj:IsA("Tool") or obj.Name:lower():find("equip") or obj.Name:lower():find("gear") then
            pcall(function()
                obj.Changed:Connect(function(prop)
                    if monitoring then
                        addLog("PropChange", obj.Name, obj:GetFullName(), "prop:"..prop)
                    end
                end)
            end)
        end
    end
    -- Watch ChildAdded ke character (equip biasanya tambah Tool ke char)
    char.ChildAdded:Connect(function(child)
        if monitoring then
            addLog("CharChildAdded", child.Name, child:GetFullName(), "class:"..child.ClassName)
        end
    end)
    char.ChildRemoved:Connect(function(child)
        if monitoring then
            addLog("CharChildRemoved", child.Name, child:GetFullName(), "class:"..child.ClassName)
        end
    end)
end

