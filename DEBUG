-- Hook InvokeServer
local oldInvoke = hookTarget.InvokeServer
hookTarget.InvokeServer = function(self, ...)
    local args = {...}
    addLog("─── 📡 " .. os.date("%H:%M:%S"))
    addLog("Args: " .. #args)
    for i, arg in ipairs(args) do
        if type(arg) == "table" then
            for k, v in pairs(arg) do
                addLog(string.format("  [%d] %s = %s (%s)", i, tostring(k), tostring(v), type(v)))
            end
        else
            addLog(string.format("  [%d] %s (%s)", i, tostring(arg), type(arg)))
        end
    end
    local result = {oldInvoke(self, ...)}
    addLog("Result: " .. tostring(result[1]))
    addLog("")
    return unpack(result)
end

print("Hook terpasang pada: " .. hookTarget.Name)
