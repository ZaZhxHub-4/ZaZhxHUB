-- // ZHX Ping Debugger — Bandingkan 4 Metode Ping
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local Stats = game:GetService("Stats")
local NC = game:GetService("NetworkClient")

local pg = LP:WaitForChild("PlayerGui")

-- GUI
local sg = Instance.new("ScreenGui")
sg.Name = "ZHX_PingDebugger"
sg.ResetOnSpawn = false
sg.Parent = pg

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 280, 0, 170)
frame.Position = UDim2.new(0.5, -140, 0.5, -85)
frame.BackgroundColor3 = Color3.fromRGB(15,15,20)
frame.BackgroundTransparency = 0.1
frame.BorderSizePixel = 0
frame.ZIndex = 9999
frame.Parent = sg
Instance.new("UICorner", frame).CornerRadius = UDim.new(0,8)
Instance.new("UIStroke", frame).Color = Color3.fromRGB(72,210,130)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,22)
title.Position = UDim2.new(0,5,0,5)
title.BackgroundTransparency = 1
title.Text = "📡 PING METHOD COMPARISON"
title.TextColor3 = Color3.fromRGB(255,255,100)
title.TextSize = 11
title.Font = Enum.Font.GothamBold
title.ZIndex = 10000
title.Parent = frame

-- Label untuk tiap metode
local methods = {
    {name = "Stats.DataPing", value = "0 ms"},
    {name = "NetworkClient", value = "0 ms"},
    {name = "LP:GetNetPing", value = "0 ms"},
    {name = "Stats.Ping (alternate)", value = "0 ms"},
}
local labels = {}

for i, method in ipairs(methods) do
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 26)
    lbl.Position = UDim2.new(0, 10, 0, 30 + (i-1)*28)
    lbl.BackgroundColor3 = Color3.fromRGB(25,25,35)
    lbl.BorderSizePixel = 0
    lbl.Text = method.name .. ": --"
    lbl.TextColor3 = Color3.fromRGB(200,200,200)
    lbl.TextSize = 11
    lbl.Font = Enum.Font.Code
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 10000
    lbl.Parent = frame
    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0,4)
    table.insert(labels, {label = lbl, name = method.name})
end

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 50, 0, 22)
closeBtn.Position = UDim2.new(1, -55, 0, 6)
closeBtn.BackgroundColor3 = Color3.fromRGB(80,20,20)
closeBtn.BorderSizePixel = 0
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.fromRGB(255,100,100)
closeBtn.TextSize = 12
closeBtn.Font = Enum.Font.GothamBold
closeBtn.ZIndex = 10000
closeBtn.AutoButtonColor = false
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0,4)
closeBtn.MouseButton1Click:Connect(function() sg:Destroy() end)

-- Update setiap 1 detik
task.spawn(function()
    while true do
        local pings = {}

        -- Metode 1: Stats.DataPing
        local s1, p1 = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if s1 and p1 then
            pings[1] = math.floor(p1 * 1000) .. " ms"
        else
            pings[1] = "ERROR"
        end

        -- Metode 2: NetworkClient:GetNetworkPing()
        local s2, p2 = pcall(function()
            return NC:GetNetworkPing()
        end)
        if s2 and p2 then
            pings[2] = math.floor(p2 * 1000) .. " ms"
        else
            pings[2] = "ERROR"
        end

        -- Metode 3: LP:GetNetworkPing()
        local s3, p3 = pcall(function()
            return LP:GetNetworkPing()
        end)
        if s3 and p3 then
            pings[3] = math.floor(p3 * 1000) .. " ms"
        else
            pings[3] = "ERROR"
        end

        -- Metode 4: Stats.PerformanceStats.Ping (jika ada)
        local s4, p4 = pcall(function()
            return Stats.PerformanceStats.Ping:GetValue()
        end)
        if s4 and p4 then
            pings[4] = math.floor(p4) .. " ms"
        else
            pings[4] = "N/A"
        end

        -- Update label
        for i, item in ipairs(labels) do
            item.label.Text = methods[i].name .. ": " .. pings[i]
        end

        task.wait(1)
    end
end)

print("Ping Debugger active. Close panel to stop.")
