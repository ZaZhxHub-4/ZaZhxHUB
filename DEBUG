-- METODE 1: DETEKSI TOOL STANDAR ROBLOX
-- ==========================================
lp.Character.ChildAdded:Connect(function(child)
    if child:IsA("Tool") then
        sendWebhook("🎒 Metode 1: Standard Equip Terdeteksi", "**Nama Item:** `" .. child.Name .. "`\nGame ini menggunakan sistem Tool bawaan Roblox.", 3447003)
    end
end)

lp.Character.ChildRemoved:Connect(function(child)
    if child:IsA("Tool") then
        sendWebhook("🎒 Metode 1: Standard Unequip Terdeteksi", "**Nama Item:** `" .. child.Name .. "`\nItem dikembalikan ke tas.", 15158332)
    end
end)

-- ==========================================
-- METODE 2: DETEKSI REMOTE EVENT / FUNCTION
-- ==========================================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    -- Cek jika client mengirim data ke server
    if not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
        local remoteName = tostring(self.Name)
        local argStr = ""
        
        for i, v in ipairs(args) do
            local val = type(v) == "userdata" and typeof(v) or tostring(v)
            argStr = argStr .. "Arg["..i.."]: " .. val .. "\n"
        end

        local lowerName = string.lower(remoteName)
        local lowerArgs = string.lower(argStr)

        -- Filter cerdas agar Discord tidak kena spam Limit/Ratelimit
        -- Hanya tangkap log jika ada hubungannya dengan equip/item/rod/inventory
        if lowerName:match("equip") or lowerName:match("tool") or lowerName:match("item") or lowerName:match("inventory") or
           lowerArgs:match("equip") or lowerArgs:match("rod") or lowerArgs:match("pancing") then
            
            local desc = "📡 **Remote:** `" .. remoteName .. "`\n⚙️ **Method:** `" .. method .. "`\n\n📝 **Arguments:**\n```lua\n" .. (argStr == "" and "Tidak ada argument" or argStr) .. "\n```"
            task.spawn(sendWebhook, "⚡ Sinyal Remote Custom Terdeteksi!", desc, 15105570)
        end
    end

    return oldNamecall(self, ...)
end))

print("🎣 [DEBUGGER] Berhasil di-inject. Silakan equip rod kamu.")
