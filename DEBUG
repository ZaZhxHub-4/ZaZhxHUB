local TabSlots = Window:DrawTab({
    Name           = "Single Slots",
    Icon           = "box",
    Type           = "Single",
    EnableScrolling = true
})

-- Teks peringatan statis (pengganti logika rebuild/kunci)
local SecSlotWarn = TabSlots:DrawSection({ Name = "Info" })
SecSlotWarn:AddParagraph({
    Title   = "⚠ Perhatian",
    Content = "Matikan Auto Booth sebelum mengubah slot!"
})

-- Simulasi 3 slot (nanti jadi 8)
local DUMMY_ITEMS = { "- Kosongkan -", "Queen Crab", "Salmon", "Ghost Shark", "Blob Shark", "Ruby", "Enchant Stone" }

for i = 1, 3 do
    local SecSlot = TabSlots:DrawSection({ Name = "Slot " .. i })

    -- TEST UTAMA: Single dropdown (pilih 1 item)
    SecSlot:AddDropdown({
        Name     = "Item Slot " .. i,
        Default  = "- Kosongkan -",
        Values   = DUMMY_ITEMS,
        Callback = function(v)
            print("[Slot "..i.."] Item dipilih:", v)
            Notifier.new({ Title = "Slot "..i, Content = "Item: " .. tostring(v), Duration = 2 })
        end
    })

    SecSlot:AddTextBox({
        Name        = "Harga Token Slot " .. i,
        Placeholder = "Contoh: 500",
        Default     = "",
        Callback    = function(v)
            print("[Slot "..i.."] Harga:", v)
        end
    })

    SecSlot:AddParagraph({
        Title   = "Status Slot " .. i,
        Content = "Kosong — pilih item & isi harga"
    })
end

