-- Fungsi dump aman untuk semua argumen
local function safeDump(val, depth)
    depth = depth or 0
    if depth > 2 then return "{...}" end -- Cegah crash
    
    if type(val) == "table" then
        local str = "{\n"
        for k, v in pairs(val) do
            str = str .. string.rep("  ", depth + 1) .. "[" .. tostring(k) .. "] = " .. safeDump(v, depth + 1) .. ",\n"
        end
        return str .. string.rep("  ", depth) .. "}"
    elseif type(val) == "string" then
        return '"' .. val .. '"'
    elseif type(val) == "function" then
        return "[Function]"
    elseif typeof(val) == "Instance" then
        return "[Instance: " .. val.ClassName .. " | " .. val.Name .. "]"
    else
        return tostring(val)
    end
end

local RS = game:GetService("ReplicatedStorage")
local targetModule = RS:WaitForChild("Controllers"):WaitForChild("PromptController")
local PromptController = require(targetModule)

local function hookTarget(funcName)
    if type(PromptController[funcName]) == "function" then
        local oldFunc
        oldFunc = hookfunction(PromptController[funcName], function(...)
            local args = {...}
            local dumpStr = ""
            
            -- Kita mulai dari args[2] karena args[1] itu self/module-nya
            for i = 2, #args do
                dumpStr = dumpStr .. "Arg[" .. i .. "]: " .. safeDump(args[i]) .. "\n\n"
            end

            -- Langsung kirim semua data ke discord, tanpa filter apapun!
            sendLog("📥 RECORD: " .. funcName, "```lua\n" .. dumpStr .. "\n
```")
            
            return oldFunc(...)
        end)
    end
end

