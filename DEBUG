-- DROPDOWN CUSTOM (fix layout, anti-overlap, multi-select hijau)
-- ══════════════════════════════════════════════════════════════════
local dropGui, dropFrame, dropConn = nil, nil, nil
local activeDropType, activeDropSlot = nil, nil

local function closeDropdown()
    if dropConn then dropConn:Disconnect(); dropConn = nil end
    if dropGui then dropGui:Destroy(); dropGui = nil; dropFrame = nil end
    activeDropType, activeDropSlot = nil, nil
end

local function openDropdown(dropType, slotIdx, itemList, onSelect, selectedSet)
    closeDropdown()
    activeDropType = dropType
    activeDropSlot = slotIdx

    local vp = Workspace.CurrentCamera.ViewportSize
    local panelPos = mainPanel.AbsolutePosition
    local panelSize = mainPanel.AbsoluteSize
    local px = panelPos.X + panelSize.X + 6
    local py = panelPos.Y

    dropGui = Instance.new("ScreenGui")
    dropGui.Name = "ZHX_Dropdown"
    dropGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    dropGui.Parent = pg

    dropFrame = Instance.new("Frame")
    dropFrame.Size = UDim2.new(0, 210, 0, 320)
    dropFrame.Position = UDim2.new(0, px, 0, py)
    dropFrame.BackgroundColor3 = THEME.TabBarBg
    dropFrame.BorderSizePixel = 0
    dropFrame.Parent = dropGui
    Instance.new("UICorner", dropFrame).CornerRadius = UDim.new(0,8)
    Instance.new("UIStroke", dropFrame).Color = THEME.Accent

    -- Search bar + tombol X
    local searchBar = Instance.new("Frame")
    searchBar.Size = UDim2.new(1,-16,0,26)
    searchBar.Position = UDim2.new(0,8,0,8)
    searchBar.BackgroundColor3 = THEME.InputBg
    searchBar.BorderSizePixel = 0
    searchBar.Parent = dropFrame
    Instance.new("UICorner", searchBar).CornerRadius = UDim.new(0,4)

    local searchBox = Instance.new("TextBox")
    searchBox.Size = UDim2.new(1,-28,1,0)
    searchBox.Position = UDim2.new(0,6,0,0)
    searchBox.BackgroundTransparency = 1
    searchBox.Text = ""
    searchBox.PlaceholderText = "🔍 Cari item..."
    searchBox.PlaceholderColor3 = THEME.TextMuted
    searchBox.TextColor3 = THEME.TextPrimary
    searchBox.TextSize = 10
    searchBox.Font = Enum.Font.Gotham
    searchBox.ClearTextOnFocus = false
    searchBox.Parent = searchBar

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0,24,0,24)
    closeBtn.Position = UDim2.new(1,-26,0,1)
    closeBtn.BackgroundColor3 = THEME.BtnDanger
    closeBtn.BorderSizePixel = 0
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = THEME.TextPrimary
    closeBtn.TextSize = 12
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.AutoButtonColor = false
    closeBtn.Parent = searchBar
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0,4)
    closeBtn.MouseButton1Click:Connect(closeDropdown)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,-8,1,-42)
    scroll.Position = UDim2.new(0,4,0,40)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 4
    scroll.ScrollBarImageColor3 = THEME.ScrollBar
    scroll.CanvasSize = UDim2.new(0,0,0,0)
    scroll.Parent = dropFrame

    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0,2)
    listLayout.Parent = scroll

    local curSelected = {}
    if selectedSet then for k,v in pairs(selectedSet) do curSelected[k] = v end end

    local function buildRows(filter)
        for _,c in ipairs(scroll:GetChildren()) do if c:IsA("Frame") or c:IsA("TextButton") then c:Destroy() end end
        local ft = filter:lower():gsub("^%s*(.-)%s*$","%1")
        local lastCat = nil
        local totalH = 0
        for _, item in ipairs(itemList) do
            if ft ~= "" and not item.name:lower():find(ft, 1, true) then continue end
            -- Divider kategori
            if item.category ~= lastCat then
                lastCat = item.category
                local div = Instance.new("TextLabel")
                div.Size = UDim2.new(1,-4,0,18)
                div.BackgroundTransparency = 1
                div.Text = "  " .. item.category
                div.TextColor3 = THEME.TextMuted
                div.TextSize = 9
                div.Font = Enum.Font.GothamBold
                div.TextXAlignment = Enum.TextXAlignment.Left
                div.Parent = scroll
                totalH = totalH + 20
            end
            local used, loc = isItemUsed(item.itemId, (dropType=="single" and activeDropSlot or nil), (dropType=="multi" and activeDropSlot or nil))
            local disabled = (used and dropType=="single")  -- single tidak bisa pilih jika dipakai di slot lain; multi tetap bisa
            local isChosen = (dropType == "multi") and curSelected[item.itemId]
            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1,-4,0,24)
            row.BackgroundColor3 = isChosen and THEME.DropdownItemSel or (disabled and Color3.fromRGB(60,30,30) or THEME.DropdownItem)
            row.BorderSizePixel = 0
            row.Text = ""
            row.AutoButtonColor = false
            row.Parent = scroll
            Instance.new("UICorner", row).CornerRadius = UDim.new(0,4)

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1,-30,1,0)
            nameLbl.Position = UDim2.new(0,6,0,0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = item.name
            nameLbl.TextColor3 = disabled and Color3.fromRGB(180,180,180) or THEME.TextPrimary
            nameLbl.TextSize = 10
            nameLbl.Font = Enum.Font.Gotham
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Parent = row

            local stokLbl = Instance.new("TextLabel")
            stokLbl.Size = UDim2.new(0,26,1,0)
            stokLbl.Position = UDim2.new(1,-28,0,0)
            stokLbl.BackgroundTransparency = 1
            stokLbl.Text = "x"..item.count
            stokLbl.TextColor3 = THEME.TextMuted
            stokLbl.TextSize = 9
            stokLbl.Font = Enum.Font.Gotham
            stokLbl.TextXAlignment = Enum.TextXAlignment.Right
            stokLbl.Parent = row

            if not disabled then
                row.MouseButton1Click:Connect(function()
                    if dropType == "single" then
                        onSelect(item)
                        closeDropdown()
                    else
                        curSelected[item.itemId] = not curSelected[item.itemId]
                        onSelect(item, curSelected)
                        buildRows(filter)
                    end
                end)
            else
                row.MouseButton1Click:Connect(function()
                    notify("⛔ Item sudah dipakai di " .. loc)
                end)
            end
            totalH = totalH + 26
        end
        scroll.CanvasSize = UDim2.new(0,0,0, totalH + 8)
    end
    buildRows("")
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        buildRows(searchBox.Text)
    end)

    dropConn = UIS.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            local pos = inp.Position
            local abs = dropFrame.AbsolutePosition
            local size = dropFrame.AbsoluteSize
            if pos.X < abs.X or pos.X > abs.X+size.X or pos.Y < abs.Y or pos.Y > abs.Y+size.Y then
                closeDropdown()
            end
        end
    end)
end

