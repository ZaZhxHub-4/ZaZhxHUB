-- ============================================================
-- STEP 3: Ambil semua UUID dari SEMUA kategori dengan cara universal
-- ============================================================
print("\n=== STEP 3: Scan UUID universal semua kategori ===")
local function scanAllUUIDs()
    local allUUIDs = {}  -- {uuid = {Id=..., cat=...}}
    for catKey, catVal in pairs(inv) do
        if type(catVal) == "table" then
            -- Coba array
            local isArray = catVal[1] ~= nil
            if isArray then
                for _, item in ipairs(catVal) do
                    if type(item) == "table" and item.UUID and item.Id then
                        allUUIDs[item.UUID] = {Id = item.Id, cat = catKey}
                    end
                end
            else
                -- Coba dict
                for k, item in pairs(catVal) do
                    if type(item) == "table" and item.Id then
                        -- k mungkin UUID itu sendiri
                        local uuid = item.UUID or tostring(k)
                        allUUIDs[uuid] = {Id = item.Id, cat = catKey}
                    elseif type(item) == "number" or type(item) == "string" then
                        -- Dict sederhana: key=UUID, val=Id
                        allUUIDs[tostring(k)] = {Id = item, cat = catKey}
                    end
                end
            end
        end
    end
    return allUUIDs
end

local allUUIDs = scanAllUUIDs()
local totalUUID = 0
local byCat = {}
for uuid, data in pairs(allUUIDs) do
    totalUUID = totalUUID + 1
