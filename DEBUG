-- ===================== FUNGSI SCANNER UTAMA =====================
local function scanMemory()
    logBox.Text = "⏳ Memulai scan memori (getgc)...\nIni bisa menyebabkan lag sebentar.\n"
    scanBtn.Text = "⏳ SCANNING..."
    scanBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 50)
    task.wait(0.1)

    local foundTables = 0
    local result = {}
    local gc = getgc(true)
    local totalTables = 0

    for _, v in pairs(gc) do
        if type(v) == "table" then
            totalTables = totalTables + 1
            local hasRemote = false
            local stringKeys = {}
            pcall(function()
                for key, val in pairs(v) do
                    if type(key) == "string" and typeof(val) == "Instance" and (val:IsA("RemoteEvent") or val:IsA("RemoteFunction")) then
                        hasRemote = true
                        stringKeys[key] = val.Name
                    end
                end
            end)
            if hasRemote then
                foundTables = foundTables + 1
                for key, remoteName in pairs(stringKeys) do
                    -- Cari kecocokan dengan keyword
                    for cat, keywords in pairs(KEYWORDS) do
                        for _, kw in ipairs(keywords) do
                            if key:lower():find(kw:lower()) then
                                if not result[cat] then result[cat] = {} end
                                result[cat][key] = remoteName
                            end
                        end
                    end
                    -- Catat juga semua yang mengandung kata 'Booth' atau 'Trade' sebagai cadangan
                    if key:lower():find("booth") or key:lower():find("trade") or key:lower():find("listing") then
                        if not result["Other"] then result["Other"] = {} end
                        result["Other"][key] = remoteName
                    end
                end
            end
        end
    end

    -- Format hasil
    local output = "✅ SCAN SELESAI!\n"
    output = output .. "Total tabel di memori: " .. totalTables .. "\n"
    output = output .. "Tabel mengandung remote: " .. foundTables .. "\n"
    output = output .. "──────────────────────────────\n\n"

    local function addCategory(title, data)
        if data and next(data) then
            output = output .. "🔹 " .. title .. ":\n"
            for k, v in pairs(data) do
                output = output .. "   [" .. k .. "] = " .. v .. "\n"
            end
            output = output .. "\n"
        end
    end

    addCategory("🚫 DECLINE TRADE", result.Decline)
    addCategory("📦 CREATE LISTING", result.Create)
    addCategory("🗑 DELETE LISTING", result.Delete)
    addCategory("📩 TRADE OFFER RECEIVED", result.TradeOffer)
    addCategory("🏪 CLAIM BOOTH", result.Claim)
    addCategory("🔧 ACCEPT / SET READY", result.Accept)
    addCategory("📌 OTHER (Booth/Trade related)", result.Other)

    if not (result.Decline or result.Create or result.Delete or result.TradeOffer or result.Claim) then
        output = output .. "⚠️ TIDAK ADA KAMUS REMOTE YANG COCOK!\n"
        output = output .. "Mungkin game menggunakan metode lain. Coba pancing manual seperti biasa?\n"
    else
        output = output .. "──────────────────────────────\n"
        output = output .. "💡 Gunakan hash di atas untuk script utama.\n"
        output = output .. "Jika Claim Booth tidak ditemukan, mungkin perlu dicari cara lain.\n"
    end

    logBox.Text = output
    scanBtn.Text = "✅ SCAN SELESAI"
    scanBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 200)

    -- Kirim ke Discord jika memungkinkan
    if httpRequest then
        local discordMsg = "**ZHX Hash Resolver Results**\n```lua\n" .. output .. "\n```"
        sendToDiscord("Hash Resolver Complete", discordMsg, 3066993)
    end

    return output
end

