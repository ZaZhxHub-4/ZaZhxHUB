-- Cek fitur executor yang tersedia
local HS = game:GetService("HttpService")
local WEBHOOK = "https://discordapp.com/api/webhooks/1506044266684743801/PlopEC1wwOyfGQh-3oBQFl67_IPfoNmUYDMvEU_kjvZP6zR6v0BjfMeObTUsxhOUepqg"

local function send(title, desc, color)
    pcall(function()
        request({
            Url=WEBHOOK, Method="POST",
            Headers={["Content-Type"]="application/json"},
            Body=HS:JSONEncode({
                username="🔬 Exec Check",
                embeds={{title=title,description=desc,color=color or 3066993}}
            })
        })
    end)
end

local results = {}
local checks = {
    {"hookmetamethod",  function() return type(hookmetamethod) == "function" end},
    {"hookfunction",    function() return type(hookfunction) == "function" end},
    {"getnamecallmethod", function() return type(getnamecallmethod) == "function" end},
    {"getloadedmodules",function() return type(getloadedmodules) == "function" end},
    {"request",         function() return type(request) == "function" end},
    {"readfile",        function() return type(readfile) == "function" end},
    {"writefile",       function() return type(writefile) == "function" end},
    {"fireproximityprompt", function() return type(fireproximityprompt) == "function" end},
    {"gethui",          function() return type(gethui) == "function" end},
    {"getcallingscript",function() return type(getcallingscript) == "function" end},
}

for _, check in ipairs(checks) do
    local name = check[1]
    local ok, result = pcall(check[2])
    local available = ok and result == true
    table.insert(results, (available and "✅" or "❌").." `"..name.."`")
end

send("🔬 Executor Feature Check", table.concat(results, "\n"), 3066993)
