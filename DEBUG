local HS = game:GetService("Players")
local HSJ = game:GetService("HttpService")
local UIS = game:GetService("UserInputService")

local WEBHOOK = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"

local function sendWH(title, desc, color)
    pcall(function()
        request({
            Url = WEBHOOK, Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HSJ:JSONEncode({
                username = "🔍 Debug v2",
                embeds = {{ title=title, description=desc, color=color or 16776960,
                    footer={text="Debug v2 • " .. os.date("%H:%M:%S")} }}
            })
        })
    end)
end

local function serializeArgs(args)
    local parts = {}
    for i, v in ipairs(args) do
        local t = type(v)
        local repr
        if t == "string" then
            repr = '"' .. v:sub(1,80) .. (v:len()>80 and "..." or "") .. '"'
        elseif t == "number" then repr = tostring(v)
        elseif t == "boolean" then repr = tostring(v)
        elseif t == "table" then
            local ok, enc = pcall(function() return HSJ:JSONEncode(v) end)
            repr = ok and enc:sub(1,120) or "[table]"
        elseif t == "userdata" then
            local ok, name = pcall(function() return v.ClassName or v.Name or tostring(v) end)
            repr = ok and ("[userdata: "..name.."]") or "[userdata]"
        else repr = "["..t.."]" end
        table.insert(parts, "**["..i.."]** `"..t.."` → "..repr)
    end
    return #parts > 0 and table.concat(parts,"\n") or "🔴 **TIDAK ADA ARGUMEN**"
end

-- ── Blacklist noise — skip sama sekali ───────────────────────────
local BLACKLIST_PATHS = {
    "Analytics", "GameAnalytics", "Gamebeast", "PingSender"
}
local function isNoise(path)
    for _, kw in ipairs(BLACKLIST_PATHS) do
        if path:find(kw, 1, true) then return true end
    end
    return false
end

local invokeCount = 0
local markerActive = false
local markerTime   = nil
local hookRef      = nil

-- ── Keyboard shortcut: tekan F saat AKAN hapus item ──────────────
UIS.InputBegan:Connect(function(inp, gameProc)
    if gameProc then return end
    if inp.KeyCode == Enum.KeyCode.F then
        markerActive = true
        markerTime   = tick()
        sendWH("📌 MARKER DITEKAN",
            "Kamu menekan **F** — sekarang **hapus item dari booth**!\nCall yang muncul setelah ini adalah kandidat delete.",
            3066993)
        print("[Debug v2] MARKER aktif — sekarang hapus item!")
    end
end)

local ok, err = pcall(function()
    setthreadidentity(6)

    hookRef = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()

        -- HANYA tangkap InvokeServer
        if method ~= "InvokeServer" then
            return hookRef(self, ...)
        end

        local args     = { ... }
        local selfPath = "[?]"
        local selfName = "[?]"
        pcall(function()
            selfPath = self:GetFullName()
            selfName = self.Name or tostring(self)
        end)

        -- Skip noise
        if isNoise(selfPath) then
            return hookRef(self, ...)
        end

        invokeCount += 1

        -- Tandai apakah call ini dekat dengan marker
        local markerFlag = ""
        if markerActive and markerTime then
            local delta = tick() - markerTime
            if delta <= 5 then
                -- Dalam 5 detik setelah F ditekan
                markerFlag = "\n🎯 **" .. string.format("%.2f", delta) .. "s setelah MARKER — INI KANDIDAT DELETE!**"
            elseif delta > 10 then
                markerActive = false
                markerTime   = nil
            end
        end

        local argStr = serializeArgs(args)
        local desc   = table.concat({
            "**Method:** `" .. method .. "`",
            "**Name:** `" .. selfName .. "`",
            "**Path:** `" .. selfPath .. "`",
            "",
            "**Args:**",
            argStr,
            markerFlag,
        }, "\n")

        local color = markerFlag ~= "" and 15548997 or 8421504  -- merah = kandidat, abu = biasa
        sendWH("📡 InvokeServer #" .. invokeCount, desc, color)

        return hookRef(self, ...)
    end))
end)

if ok then
    print("[Debug v2] Hook aktif!")
    print("[Debug v2] CARA PAKAI:")
    print("[Debug v2] 1. Buka booth")
    print("[Debug v2] 2. Tekan F di keyboard SESAAT SEBELUM hapus item")
    print("[Debug v2] 3. Langsung hapus item dari booth")
    print("[Debug v2] Call yang muncul dalam 5 detik setelah F = kandidat delete")
    sendWH("✅ Debug v2 Siap",
        "**Cara pakai:**\n1. Buka booth\n2. Tekan **F** di keyboard sesaat sebelum hapus\n3. Langsung hapus item\n\nCall dalam 5 detik setelah F akan ditandai 🎯",
        3066993)
else
    print("[Debug v2] Gagal: " .. tostring(err))
end
