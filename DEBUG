                    Position = UDim2.new(0, 4, 0, 0),
                    BackgroundTransparency = 1,
                    Text = title or "",
                    TextColor3 = ZHX_GREEN,
                    TextSize = 12,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = paraFrame
                })
                local contentLabel = createInstance("TextLabel", {
                    Size = UDim2.new(1, 0, 1, -16),
                    Position = UDim2.new(0, 4, 0, 16),
                    BackgroundTransparency = 1,
                    Text = content or "",
                    TextColor3 = TEXT_GRAY,
                    TextSize = 10,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    Parent = paraFrame
                })
            end

            tab.Sections[#tab.Sections + 1] = section
            return section
        end

        return tab
    end

    function window:SwitchTab(tabName)
        if activeTabName then
            tabs[activeTabName].Frame.Visible = false
        end
        if tabs[tabName] then
            tabs[tabName].Frame.Visible = true
            activeTabName = tabName
        end
    end

    -- Default tab
    window:SwitchTab(config.DefaultTab or "Home")

    return window
end

