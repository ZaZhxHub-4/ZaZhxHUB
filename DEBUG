local Players = game:GetService("Players")
local HS = game:GetService("HttpService")
local lp = Players.LocalPlayer

-- Menggunakan URL rahasia dari script utama kamu
local WEBHOOK_URL = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"

-- Fungsi kirim ke Webhook
local function sendWebhook(title, desc, color)
    pcall(function()
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HS:JSONEncode({
                username = "🐟 Tracker Equip/Unequip",
                embeds = {{
                    title = title,
                    description = desc,
                    color = color or 16766720,
                    footer = {text = "Fish It Debugger • " .. os.date("%H:%M:%S")}
                }}
            })
        })
    end)
end

sendWebhook("🔍 Debugger Diaktifkan!", "Sistem siap. Silakan klik/pilih pancingan kamu (Equip) dan lepas (Unequip) secara manual di game.", 3066993)

