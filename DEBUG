                    BackgroundTransparency = 1,
                    Image = "rbxassetid://7072708083", -- icon panah bawah
                    ScaleType = Enum.ScaleType.Fit,
                    Parent = mainBtn
                })

                local listFrame = createInstance("Frame", {
                    Size = UDim2.new(1, -8, 0, 0),
                    Position = UDim2.new(0, 4, 0, 42),
                    BackgroundColor3 = DARKER_BG,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 5,
                    Parent = dropdownFrame
                })
                createInstance("UICorner", { CornerRadius = UDim.new(0, 4), Parent = listFrame })
                local listLayout = createInstance("UIListLayout", {
                    FillDirection = Enum.FillDirection.Vertical,
                    HorizontalAlignment = Enum.HorizontalAlignment.Center,
                    VerticalAlignment = Enum.VerticalAlignment.Top,
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = listFrame
                })
                listFrame.AutomaticSize = Enum.AutomaticSize.Y

                local function updateMultiText()
                    local chosen = {}
                    for k, v in pairs(selectedOptions) do
                        if v then table.insert(chosen, k) end
                    end
                    if #chosen == 0 then
                        mainBtn.Text = "Tidak ada yang dipilih"
                    else
                        mainBtn.Text = table.concat(chosen, ", ")
                    end
                end

                local function fireCallback()
                    if single then
                        if dropdownConfig.Callback then dropdownConfig.Callback(mainBtn.Text) end
                    else
                        if dropdownConfig.Callback then dropdownConfig.Callback(selectedOptions) end
                    end
                end

                -- Populate options
                for _, opt in ipairs(dropdownConfig.Options) do
                    if single then
                        local optBtn = createInstance("TextButton", {
                            Size = UDim2.new(1, 0, 0, 22),
                            BackgroundColor3 = DARKER_BG,
                            BorderSizePixel = 0,
                            Text = opt,
                            TextColor3 = TEXT_WHITE,
                            TextSize = 11,
                            Font = Enum.Font.Gotham,
                            Parent = listFrame
                        })
                        optBtn.MouseButton1Click:Connect(function()
                            mainBtn.Text = opt
                            listFrame.Visible = false
                            fireCallback()
                        end)
                        optBtn.MouseEnter:Connect(function() optBtn.BackgroundColor3 = ZHX_GREEN end)
                        optBtn.MouseLeave:Connect(function() optBtn.BackgroundColor3 = DARKER_BG end)
                    else
                        local checkFrame = createInstance("Frame", {
                            Size = UDim2.new(1, 0, 0, 22),
                            BackgroundTransparency = 1,
                            Parent = listFrame
                        })
                        local check = createInstance("ImageLabel", {
                            Size = UDim2.new(0, 16, 0, 16),
                            Position = UDim2.new(0, 4, 0.5, -8),
                            BackgroundTransparency = 1,
                            Image = "rbxassetid://7072720870", -- unchecked
                            Parent = checkFrame
                        })
                        local label = createInstance("TextLabel", {
                            Size = UDim2.new(1, -24, 1, 0),
                            Position = UDim2.new(0, 22, 0, 0),
                            BackgroundTransparency = 1,
                            Text = opt,
                            TextColor3 = TEXT_WHITE,
                            TextSize = 11,
                            Font = Enum.Font.Gotham,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            Parent = checkFrame
                        })
                        selectedOptions[opt] = false
                        checkFrame.InputBegan:Connect(function(input)
                            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                                selectedOptions[opt] = not selectedOptions[opt]
                                check.Image = selectedOptions[opt] and "rbxassetid://7072720342" or "rbxassetid://7072720870"
                                updateMultiText()
                                fireCallback()
                            end
                        end)
                    end
                end

                mainBtn.MouseButton1Click:Connect(function()
                    listFrame.Visible = not listFrame.Visible
                end)
                -- Auto-close when clicking outside
                local gui = mainBtn
                while gui and not gui:IsA("ScreenGui") do gui = gui.Parent end
                if gui then
                    gui.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            if not listFrame:IsDescendantOf(input.UserInputService:GetFocusedTextBox()) then
                                listFrame.Visible = false
                            end
                        end
                    end)
                end
            end

