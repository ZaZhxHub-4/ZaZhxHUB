local function switchTab(tabName)
    if activeTabName and tabs[activeTabName] then
        tabs[activeTabName].Page.Visible = false
        if tabs[activeTabName].Button then
            tabs[activeTabName].Button.BackgroundColor3 = BLACK_SIDEBAR
            tabs[activeTabName].Button.TextColor3 = TEXT_GRAY
        end
    end
    if tabs[tabName] then
        tabs[tabName].Page.Visible = true
        if tabs[tabName].Button then
            tabs[tabName].Button.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
            tabs[tabName].Button.TextColor3 = ZHX_GREEN
        end
        activeTabName = tabName
    end
end

local function addTab(config)
    local tab = {}
    tab.Name = config.Name
    tab.Page, tab.ScrollFrame = createTabPage()
    tab.Sections = {}

    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, -12, 0, 32)
    tabBtn.BackgroundColor3 = BLACK_SIDEBAR
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = tab.Name
    tabBtn.TextColor3 = TEXT_GRAY
    tabBtn.TextSize = 12
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.ZIndex = 103
    tabBtn.Parent = sidebarFrame

    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 5)

    tabBtn.MouseEnter:Connect(function()
        if activeTabName ~= tab.Name then
            tabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 28)
            tabBtn.TextColor3 = TEXT_WHITE
        end
    end)
    tabBtn.MouseLeave:Connect(function()
        if activeTabName ~= tab.Name then
            tabBtn.BackgroundColor3 = BLACK_SIDEBAR
            tabBtn.TextColor3 = TEXT_GRAY
        end
    end)
    tabBtn.MouseButton1Click:Connect(function()
        switchTab(tab.Name)
    end)

    tab.Button = tabBtn
    tabs[tab.Name] = tab

    -- Tambahkan section ke tab ini
    function tab.AddSection(sectionConfig)
        local section = {}

        local sectionFrame = Instance.new("Frame")
        sectionFrame.Size = UDim2.new(1, -16, 0, 40)
        sectionFrame.BackgroundColor3 = BLACK_SECTION
        sectionFrame.BorderSizePixel = 0
        sectionFrame.ZIndex = 104
