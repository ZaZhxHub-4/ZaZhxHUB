-- Tes pengukuran
local function testSpam(threads, duration)
    local startTime = tick()
    local callCount = 0
    local totalResponseTime = 0
    local minResponse = math.huge
    local maxResponse = 0
    local errors = 0

    local threadsList = {}
    for i = 1, threads do
        local th = task.spawn(function()
            while tick() - startTime < duration do
                local reqStart = tick()
                local ok = pcall(function()
                    autoStateRF:InvokeServer(false)
                end)
                if ok then
                    local responseTime = tick() - reqStart
                    callCount = callCount + 1
                    totalResponseTime = totalResponseTime + responseTime
                    if responseTime < minResponse then minResponse = responseTime end
                    if responseTime > maxResponse then maxResponse = responseTime end
                else
                    errors = errors + 1
                end
            end
        end)
        table.insert(threadsList, th)
    end

    -- Tunggu semua thread selesai
    for _, th in ipairs(threadsList) do
        task.wait(th)
    end

    local elapsed = tick() - startTime
    local callsPerSec = callCount / elapsed
    local avgResponse = callCount > 0 and (totalResponseTime / callCount * 1000) or 0
    local minMs = minResponse < math.huge and (minResponse * 1000) or 0
    local maxMs = maxResponse * 1000

    return {
        threads = threads,
        duration = duration,
        calls = callCount,
        callsPerSec = callsPerSec,
        avgMs = avgResponse,
        minMs = minMs,
        maxMs = maxMs,
        errors = errors
    }
end

