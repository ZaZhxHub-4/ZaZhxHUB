local HttpService = game:GetService("HttpService")
local WebhookURL = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"

local function sendLog(title, desc)
    pcall(function()
        request({
            Url = WebhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                username = "🗂️ Module Dumper",
                embeds = {{
                    title = title,
                    description = desc,
                    color = 3066993
                }}
            })
        })
    end)
end

local RS = game:GetService("ReplicatedStorage")
local Controllers = RS:FindFirstChild("Controllers")
local modulePath = Controllers and Controllers:FindFirstChild("PromptController")

if modulePath then
    local success, result = pcall(require, modulePath)
    if success then
        local dump = ""
        
        -- Cek isi utama table
        for k, v in pairs(result) do
            dump = dump .. tostring(k) .. " : [" .. type(v) .. "]\n"
        end
        
        -- Terkadang developer menaruh fungsi di dalam Metatable (__index)
        local mt = getmetatable(result)
        if mt then
            dump = dump .. "\n--- METATABLE ---\n"
            for k, v in pairs(mt) do
                dump = dump .. tostring(k) .. " : [" .. type(v) .. "]\n"
            end
            if type(mt.__index) == "table" then
                dump = dump .. "\n--- __index ---\n"
                for k, v in pairs(mt.__index) do
                    dump = dump .. tostring(k) .. " : [" .. type(v) .. "]\n"
                end
            end
        end

        if dump == "" then 
            dump = "Table kosong. Mungkin module ini di-obfuscate atau dikunci." 
        end
        
        sendLog("✅ Berhasil Dump PromptController", "Isi fungsinya adalah:\n```lua\n" .. dump .. "\n```")
    else
        sendLog("❌ Gagal Require", "Pesan Error: " .. tostring(result))
    end
else
    sendLog("❌ Tidak Ditemukan", "Path ke ReplicatedStorage.Controllers.PromptController tidak valid.")
end
