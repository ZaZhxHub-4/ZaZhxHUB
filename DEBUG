-- 2. PEMUSNAHAN TOMBOL MOBILE "KYRI" & MINIMIZE
-- =========================================
local killedMobile = 0
-- Cari di SELURUH CoreGui dan PlayerGui (karena dipisah oleh KyriLib)
local function huntParasite(parentFolder)
    for _, gui in ipairs(parentFolder:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "ZHX_ToggleGui" then
            for _, obj in ipairs(gui:GetDescendants()) do
                -- Eksekusi tombol minimize (logo - atau _)
                if obj:IsA("TextButton") and (obj.Text == "-" or obj.Text == "−" or obj.Text == "_") then
                    pcall(function() obj:Destroy() end)
                end
                
                -- Eksekusi tombol bulat Kyri di HP
                if (obj:IsA("TextButton") or obj:IsA("ImageButton")) then
                    -- Ciri khas: teks "Kyri" atau bentuk lingkaran kecil yang letaknya melayang
                    local hasKyriText = (obj:IsA("TextButton") and obj.Text:lower():find("kyri"))
                    local isFloatingCircle = (obj.AbsoluteSize.X > 30 and obj.AbsoluteSize.X < 70 and obj.AbsoluteSize.Y > 30 and obj.AbsoluteSize.Y < 70)
                    
                    if (hasKyriText or isFloatingCircle) and not obj:FindFirstAncestorOfClass("ScrollingFrame") then
                        -- Pastikan ini bukan bagian dari menu dalam panel
                        if obj.AbsolutePosition.Y > 0 then
                            pcall(function() obj.Parent.Enabled = false end) -- Matikan ScreenGui-nya
                            pcall(function() obj:Destroy() end)
                            killedMobile = killedMobile + 1
                        end
                    end
                end
            end
        end
    end
end
huntParasite(CoreGui)
huntParasite(pg)
table.insert(out, "✅ Tombol parasit/mobile yang dibunuh: " .. killedMobile)

-- =========================================
-- 3. INJEKSI DRAG KHUSUS PC (MOUSE ONLY)
-- =========================================
if mainGui then
    local mainFrame
    for _, child in ipairs(mainGui:GetChildren()) do
        if child:IsA("Frame") and child.Size.X.Scale > 0.1 then mainFrame = child; break end
    end
    
    if mainFrame then
        local dragToggle = false
        local dragStart
        local startPos

        mainFrame.InputBegan:Connect(function(input)
            -- HANYA AKTIF JIKA KLIK MOUSE (TIDAK GANGGU TOUCH HP)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragToggle = true
                dragStart = input.Position
                startPos = mainFrame.Position
            end
        end)

        mainFrame.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragToggle = false
            end
        end)

        UIS.InputChanged:Connect(function(input)
            if dragToggle and input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = input.Position - dragStart
                mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        table.insert(out, "✅ PC Mouse Drag Berhasil Disuntikkan.")
    end
end

