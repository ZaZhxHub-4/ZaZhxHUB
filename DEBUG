local webhook = "https://discord.com/api/webhooks/1506044266684743801/PlopEC1wwOyfGQh-3oBQFl67_IPfoNmUYDMvEU_kjvZP6zR6v0BjfMeObTUsxhOUepqg"
local HS = game:GetService("HttpService")
local WS = game:GetService("Workspace")

local function send(msg)
    pcall(function()
        local body = HS:JSONEncode({content = msg:sub(1, 1900)})
        if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif syn and syn.request then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        else request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        end
    end)
end

send("🔍 Phase 6: Deep Inspect Megalodon Hunt Model...")

local propsFolder = WS:FindFirstChild("Props")
if not propsFolder then send("❌ Props tidak ditemukan"); return end

local model = propsFolder:FindFirstChild("Megalodon Hunt")
if not model then send("❌ Model Megalodon Hunt tidak ditemukan"); return end

send("📁 Model: " .. model.Name .. " (" .. model.ClassName .. ")")
send("  Children: " .. #model:GetChildren() .. " anak")

-- Cari semua anak dan turunannya
for _, child in ipairs(model:GetDescendants()) do
    if child:IsA("BasePart") then
        send("  🧱 Part: " .. child.Name .. " | Posisi: " .. tostring(child.Position) .. " | Size: " .. tostring(child.Size))
    end
    if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
        local text = ""
        for _, guiChild in ipairs(child:GetDescendants()) do
            if guiChild:IsA("TextLabel") and guiChild.Text ~= "" then
                text = text .. guiChild.Text .. " | "
            end
        end
        send("  📝 GUI: " .. child.Name .. " | Text: " .. text:sub(1, 200))
    end
end

-- Cari part bernama "Megalodon Hunt" langsung
local targetPart = model:FindFirstChild("Megalodon Hunt")
if targetPart and targetPart:IsA("BasePart") then
    send("🎯 Target Part 'Megalodon Hunt': Posisi = " .. tostring(targetPart.Position))
end

send("✅ Phase 6 selesai.")
