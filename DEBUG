-- // DEEP EXPLOIT: Ubah Cooldown & Reel Duration di memori
-- // Target: semua pet yang PetFishing.Enabled = true
-- // Set CastCooldownSeconds & ReelDurationSeconds ke 0.1
local RS = game:GetService("ReplicatedStorage")
local petsModule = RS:FindFirstChild("Pets")
if not petsModule then return end

local env = getsenv(petsModule) or require(petsModule)
if not env then return end

local modified = {}
for petName, petData in pairs(env) do
    if type(petData) == "table" and petData.PetFishing and petData.PetFishing.Enabled then
        local pf = petData.PetFishing
        pf.CastCooldownSeconds = 0.1
        pf.ReelDurationSeconds = 0.1
        table.insert(modified, petName)
    end
end

if #modified > 0 then
    print("Modified PetFishing for: " .. table.concat(modified, ", "))
    print("Cooldown & Reel set to 0.1s. Amati pet sekarang.")
else
    print("No active fishing pet found.")
end
