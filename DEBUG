-- Fungsi kirim ke Discord (support potongan besar)
local function send_to_discord(content, codeblock_lang)
    codeblock_lang = codeblock_lang or ""
    local message = content
    if #content > 1900 then
        -- Potong jadi beberapa bagian
        local parts = {}
        for i = 1, #content, 1900 do
            table.insert(parts, string.sub(content, i, i+1899))
        end
        for _, part in ipairs(parts) do
            local data = { content = "```" .. codeblock_lang .. "\n" .. part .. "```" }
            local json = game:GetService("HttpService"):JSONEncode(data)
            pcall(function()
                syn.request({ Url = WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = json })
            end)
            task.wait(0.5)
        end
    else
        local data = { content = "```" .. codeblock_lang .. "\n" .. content .. "```" }
        local json = game:GetService("HttpService"):JSONEncode(data)
        pcall(function()
            syn.request({ Url = WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = json })
        end)
    end
end

