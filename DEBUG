local function startNoclip(char)
    if noclipConn then noclipConn:Disconnect() end
    noclipConn = RunService.Stepped:Connect(function()
        if not char or not char.Parent then noclipConn:Disconnect(); noclipConn=nil; return end
        for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
    end)
end
local function stopNoclip(char)
    if noclipConn then noclipConn:Disconnect(); noclipConn=nil end
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then p.CanCollide=true end end
end

local function tweenTeleport(hrp, char, targetCF)
    local hum = char and char:FindFirstChildOfClass("Humanoid"); if not hrp or not hum then return end
    local dist = (hrp.Position - targetCF.Position).Magnitude
    local speed = 65
    local tweenTime = dist / speed; if tweenTime < 0.1 then tweenTime = 0.1 end
    local origWalk, origJump, origAuto = hum.WalkSpeed, hum.JumpPower, hum.AutoRotate
    hum.WalkSpeed = 0; hum.JumpPower = 0; hum.AutoRotate = false
    startNoclip(char); hrp.Anchored = true
    local tween = TweenService:Create(hrp, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {CFrame = targetCF})
    tween:Play(); tween.Completed:Wait()
    hrp.Anchored = false; task.wait(0.2); stopNoclip(char)
    hum.WalkSpeed = origWalk; hum.JumpPower = origJump; hum.AutoRotate = origAuto
end

