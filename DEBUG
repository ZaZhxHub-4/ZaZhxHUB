        {"Booth", "test-uuid-123", 100},
        {"Booth", "test-uuid-123", 100, "Fish"},
        {"test-uuid-123", 100},
        {"test-uuid-123", 100, "Fish"},
        {"Booth", {itemId = 1, uuid = "test", price = 100}},
        {itemType = "Booth", uuid = "test", price = 100},
    }
    
    for i, params in ipairs(testCases) do
        local ok, result = pcall(function()
            return createRF:InvokeServer(unpack(params))
        end)
        local paramStr = HS:JSONEncode(params)
        if ok then
            add(string.format("  Uji %d: OK -> %s", i, tostring(result)))
