local function sendToDiscord(title, description, color)
    pcall(function()
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                username = "🐟 Debug Equip Args",
                embeds = {{title = title, description = description, color = color or 3066993}}
            })
        })
    end)
end

-- Hook semua RemoteEvent/RemoteFunction yang InvokeServer
local origHook
local function hookAll()
    pcall(function()
        setthreadidentity(6)
        origHook = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "InvokeServer" or method == "FireServer" then
                local args = {...}
                local targetName = self.Name or "unknown"
                -- Filter hanya yang terkait equip/unequip/tool/rod
                local lowerName = targetName:lower()
                if lowerName:find("equip") or lowerName:find("unequip") or lowerName:find("tool") or lowerName:find("rod") or lowerName:find("hotbar") then
                    local argsStr = {}
                    for i, arg in ipairs(args) do
                        if type(arg) == "string" then
                            argsStr[i] = string.format("[%d]=%q", i, arg)
                        elseif type(arg) == "number" then
                            argsStr[i] = string.format("[%d]=%s", i, tostring(arg))
                        elseif type(arg) == "boolean" then
                            argsStr[i] = string.format("[%d]=%s", i, tostring(arg))
                        elseif type(arg) == "table" then
                            argsStr[i] = string.format("[%d]=[table]", i)
                        elseif type(arg) == "Instance" then
                            argsStr[i] = string.format("[%d]=%s", i, arg:GetFullName())
                        else
                            argsStr[i] = string.format("[%d]=%s", i, type(arg))
                        end
                    end
                    sendToDiscord("🎣 " .. method .. " : " .. targetName, "```\n" .. table.concat(argsStr, "\n") .. "\n```", 65280)
                end
            end
            return origHook(self, ...)
        end))
    end)
end

hookAll()
