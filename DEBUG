    ["Super Easter Totem"] = { Id = 6, Duration = 3601 },
    ["Easter Totem"] = { Id = 7, Duration = 3601 },
}
fenv.TOTEM_NAMES = { [1]="Luck", [2]="Mutation", [3]="Shiny", [4]="Super Love", [5]="Love", [6]="Super Easter", [7]="Easter" }
fenv.selectedTotemName = "Luck Totem"
fenv.AUTO_TOTEM_ACTIVE = false
fenv.AUTO_TOTEM_THREAD = nil
fenv.currentTotemExpiry = 0

fenv.GetTotemUUID = function(totemName)
    local data = DataService:GetExpect("Inventory")
    for _, totem in ipairs(data.Totems) do
        if totem.Id == fenv.TOTEM_DATA[totemName].Id then
            return totem.UUID
        end
    end
    return nil
end

fenv.ActivateTotem = function(totemName)
    local uuid = fenv.GetTotemUUID(totemName)
    if not uuid then return false end
    -- Gunakan remote Totem (dari game)
    local totemRemote = fenv.Totem
    if not totemRemote then return false end
    pcall(function()
        fenv.CallRemoteServer(totemRemote, uuid)
    end)
    fenv.currentTotemExpiry = os.time() + fenv.TOTEM_DATA[totemName].Duration
    return true
end

fenv.RunAutoTotemLoop = function()
    if fenv.AUTO_TOTEM_THREAD then task.cancel(fenv.AUTO_TOTEM_THREAD) end
    fenv.AUTO_TOTEM_THREAD = task.spawn(function()
        while fenv.AUTO_TOTEM_ACTIVE do
            if os.time() > fenv.currentTotemExpiry then
                fenv.ActivateTotem(fenv.selectedTotemName)
            end
            task.wait(5)
        end
    end)
end

