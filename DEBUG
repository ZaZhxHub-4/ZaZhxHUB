local function scanPP()
    print("=== SCAN PP ===")
    local count = 0
    for _, obj in ipairs(game:GetService("Workspace"):GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            count = count + 1
            print(string.format("#%d | PP:%s | Parent:%s | Class:%s | Action:%s", 
                count, obj.Name, obj.Parent.Name, obj.Parent.ClassName, obj.ActionText))
        end
    end
    print("Total PP: "..count)
    print("=== END ===")
end

scanPP()
