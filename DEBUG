local dragB, dragStart2, startPos2 = false, nil, nil
local clickStart2 = Vector2.new()
zhxBtn.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        dragB = true
        dragStart2 = inp.Position
        startPos2 = zhxBtn.Position
        clickStart2 = Vector2.new(inp.Position.X, inp.Position.Y)
    end
end)
zhxBtn.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        local dist = (Vector2.new(inp.Position.X, inp.Position.Y) - clickStart2).Magnitude
        if dist < 6 then
            Window.IsOpen = not Window.IsOpen
            Window:Toggle(Window.IsOpen)
        end
        dragB = false
    end
end)
UIS.InputChanged:Connect(function(inp)
    if dragB and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
        local d = inp.Position - dragStart2
        local vp = workspace.CurrentCamera.ViewportSize
        zhxBtn.Position = UDim2.new(0, math.clamp(startPos2.X.Offset + d.X, 0, vp.X - 46), 0, math.clamp(startPos2.Y.Offset + d.Y, 0, vp.Y - 46))
    end
end)

