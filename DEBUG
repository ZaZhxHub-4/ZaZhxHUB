            return boxFrame
        end

        function section.AddDropdown(dropdownConfig)
            local single = not dropdownConfig.Multi
            local selectedOptions = {}
            if not single then
                for _, opt in ipairs(dropdownConfig.Options) do
                    selectedOptions[opt] = false
                end
            end

            local dropFrame = Instance.new("Frame")
            dropFrame.Size = UDim2.new(1, -24, 0, 44)
            dropFrame.BackgroundTransparency = 1
            dropFrame.ClipsDescendants = false
            dropFrame.Parent = sectionFrame

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 0, 16)
            label.BackgroundTransparency = 1
            label.Text = dropdownConfig.Name or ""
            label.TextColor3 = TEXT_WHITE
            label.TextSize = 11
            label.Font = Enum.Font.Gotham
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = dropFrame

            local mainBtn = Instance.new("TextButton")
            mainBtn.Size = UDim2.new(1, 0, 0, 26)
            mainBtn.Position = UDim2.new(0, 0, 0, 18)
            mainBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
            mainBtn.BorderSizePixel = 0
            mainBtn.Text = dropdownConfig.Default or (single and "- Pilih -" or "Tidak ada yang dipilih")
            mainBtn.TextColor3 = TEXT_WHITE
            mainBtn.TextSize = 11
            mainBtn.Font = Enum.Font.Gotham
            mainBtn.TextXAlignment = Enum.TextXAlignment.Left
            mainBtn.Parent = dropFrame
            Instance.new("UICorner", mainBtn).CornerRadius = UDim.new(0, 4)

            -- Arrow
            local arrow = Instance.new("ImageLabel")
            arrow.Size = UDim2.new(0, 16, 0, 16)
            arrow.Position = UDim2.new(1, -18, 0.5, -8)
            arrow.BackgroundTransparency = 1
            arrow.Image = "rbxassetid://7072708083"
            arrow.ScaleType = Enum.ScaleType.Fit
            arrow.Parent = mainBtn

            local listFrame = Instance.new("Frame")
            listFrame.Size = UDim2.new(1, 0, 0, 0)
            listFrame.Position = UDim2.new(0, 0, 1, 2)
            listFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
            listFrame.BorderSizePixel = 0
            listFrame.Visible = false
            listFrame.ZIndex = 200
            listFrame.ClipsDescendants = true
            listFrame.Parent = dropFrame
            Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 4)
            listFrame.AutomaticSize = Enum.AutomaticSize.Y

            local listLayout = Instance.new("UIListLayout")
            listLayout.FillDirection = Enum.FillDirection.Vertical
            listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            listLayout.VerticalAlignment = Enum.VerticalAlignment.Top
            listLayout.SortOrder = Enum.SortOrder.LayoutOrder
            listLayout.Parent = listFrame

            for _, opt in ipairs(dropdownConfig.Options) do
                if single then
                    local optBtn = Instance.new("TextButton")
                    optBtn.Size = UDim2.new(1, 0, 0, 24)
                    optBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
                    optBtn.BorderSizePixel = 0
                    optBtn.Text = "    " .. opt
                    optBtn.TextColor3 = TEXT_WHITE
                    optBtn.TextSize = 11
                    optBtn.Font = Enum.Font.Gotham
                    optBtn.TextXAlignment = Enum.TextXAlignment.Left
                    optBtn.ZIndex = 201
                    optBtn.Parent = listFrame

                    optBtn.MouseEnter:Connect(function() optBtn.BackgroundColor3 = ZHX_GREEN; optBtn.TextColor3 = Color3.new(0,0,0) end)
                    optBtn.MouseLeave:Connect(function() optBtn.BackgroundColor3 = Color3.fromRGB(20,20,22); optBtn.TextColor3 = TEXT_WHITE end)
                    optBtn.MouseButton1Click:Connect(function()
                        mainBtn.Text = opt
                        listFrame.Visible = false
                        if dropdownConfig.Callback then dropdownConfig.Callback(opt) end
                    end)
                else
                    local checkFrame = Instance.new("Frame")
                    checkFrame.Size = UDim2.new(1, 0, 0, 26)
                    checkFrame.BackgroundTransparency = 1
                    checkFrame.Parent = listFrame

                    local checkIcon = Instance.new("ImageLabel")
                    checkIcon.Size = UDim2.new(0, 18, 0, 18)
                    checkIcon.Position = UDim2.new(0, 6, 0.5, -9)
                    checkIcon.BackgroundTransparency = 1
                    checkIcon.Image = selectedOptions[opt] and "rbxassetid://7072720342" or "rbxassetid://7072720870"
                    checkIcon.ScaleType = Enum.ScaleType.Fit
                    checkIcon.Parent = checkFrame

                    local checkLabel = Instance.new("TextLabel")
                    checkLabel.Size = UDim2.new(1, -28, 1, 0)
                    checkLabel.Position = UDim2.new(0, 26, 0, 0)
                    checkLabel.BackgroundTransparency = 1
                    checkLabel.Text = opt
                    checkLabel.TextColor3 = TEXT_WHITE
                    checkLabel.TextSize = 11
                    checkLabel.Font = Enum.Font.Gotham
                    checkLabel.TextXAlignment = Enum.TextXAlignment.Left
                    checkLabel.Parent = checkFrame

                    local checkBtn = Instance.new("TextButton")
                    checkBtn.Size = UDim2.new(1, 0, 1, 0)
                    checkBtn.BackgroundTransparency = 1
                    checkBtn.Text = ""
                    checkBtn.Parent = checkFrame
                    checkBtn.MouseEnter:Connect(function() checkFrame.BackgroundColor3 = Color3.fromRGB(35,35,40) end)
                    checkBtn.MouseLeave:Connect(function() checkFrame.BackgroundColor3 = Color3.fromRGB(0,0,0); checkFrame.BackgroundTransparency = 1 end)
                    checkBtn.MouseButton1Click:Connect(function()
                        selectedOptions[opt] = not selectedOptions[opt]
                        checkIcon.Image = selectedOptions[opt] and "rbxassetid://7072720342" or "rbxassetid://7072720870"
                        local chosen = {}
                        for k,v in pairs(selectedOptions) do if v then table.insert(chosen, k) end end
                        mainBtn.Text = #chosen == 0 and "Tidak ada yang dipilih" or table.concat(chosen, ", ")
                        if dropdownConfig.Callback then dropdownConfig.Callback(selectedOptions) end
                    end)
                end
            end

            mainBtn.MouseButton1Click:Connect(function()
                listFrame.Visible = not listFrame.Visible
            end)
            -- Klik di luar menutup dropdown
            rootFrame.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if listFrame.Visible then
                        task.delay(0.1, function() if listFrame.Visible then listFrame.Visible = false end end)
                    end
                end
            end)
            return dropFrame
        end

        function section.AddParagraph(title, content)
            local pFrame = Instance.new("Frame")
            pFrame.Size = UDim2.new(1, -24, 0, 40)
            pFrame.BackgroundTransparency = 1
            pFrame.Parent = sectionFrame

            local tLabel = Instance.new("TextLabel")
            tLabel.Size = UDim2.new(1, 0, 0, 16)
            tLabel.BackgroundTransparency = 1
            tLabel.Text = title or ""
            tLabel.TextColor3 = ZHX_GREEN
            tLabel.TextSize = 11
            tLabel.Font = Enum.Font.GothamBold
            tLabel.TextXAlignment = Enum.TextXAlignment.Left
            tLabel.Parent = pFrame

            local cLabel = Instance.new("TextLabel")
            cLabel.Size = UDim2.new(1, 0, 1, -18)
            cLabel.Position = UDim2.new(0, 0, 0, 18)
            cLabel.BackgroundTransparency = 1
            cLabel.Text = content or ""
            cLabel.TextColor3 = TEXT_GRAY
            cLabel.TextSize = 10
            cLabel.Font = Enum.Font.Gotham
            cLabel.TextXAlignment = Enum.TextXAlignment.Left
            cLabel.TextWrapped = true
            cLabel.Parent = pFrame

            pFrame.AutomaticSize = Enum.AutomaticSize.Y
            return pFrame
        end

        table.insert(tab.Sections, section)
        return section
    end

    return tab
end

