-- TAB: MULTI SLOTS
-- ══════════════════════════════════
local TabMulti = Window:DrawTab({
    Name           = "Multi Slots",
    Icon           = "layers",
    Type           = "Single",
    EnableScrolling = true
})

local SecMultiWarn = TabMulti:DrawSection({ Name = "Info" })
SecMultiWarn:AddParagraph({
    Title   = "⚠ Perhatian",
    Content = "Matikan Auto Booth sebelum mengubah slot!"
})

-- Simulasi 2 multi slot
for m = 1, 2 do
    local SecMulti = TabMulti:DrawSection({ Name = "Antrian Multi M" .. m })

    -- TEST UTAMA: Multi-select dropdown bawaan CompKiller
    SecMulti:AddDropdown({
        Name     = "Pilih Item Antrian M" .. m,
        Default  = {},
        Multi    = true,
        Values   = { "Queen Crab", "Salmon", "Ghost Shark", "Blob Shark", "Ruby", "Enchant Stone", "Lochness Monster" },
        Callback = function(selected)
            -- selected = table of selected values
            local names = {}
            for k, v in pairs(selected) do
                if v then table.insert(names, k) end
            end
            print("[Multi "..m.."] Item dipilih:", table.concat(names, ", "))
            Notifier.new({
                Title   = "Multi M" .. m,
                Content = #names .. " item dipilih",
                Duration = 2
            })
        end
    })

    SecMulti:AddTextBox({
        Name        = "Harga Pukul Rata M" .. m,
        Placeholder = "Contoh: 300",
        Default     = "",
        Callback    = function(v)
            print("[Multi "..m.."] Harga:", v)
        end
    })

    SecMulti:AddParagraph({
        Title   = "Status M" .. m,
        Content = "Antrian kosong — tambahkan item"
    })
end

