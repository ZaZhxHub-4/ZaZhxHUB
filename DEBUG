local function findClaimPrompt(character)
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local radius = 10
    local region = Region3.new(hrp.Position - Vector3.new(radius, radius, radius), hrp.Position + Vector3.new(radius, radius, radius))
    local parts = Workspace:FindPartsInRegion3(region, nil, 100)
    for _, part in ipairs(parts) do
        local prompt = part:FindFirstChildWhichIsA("ProximityPrompt")
        if prompt and prompt.Enabled then
            local action = prompt.ActionText:lower()
            if action:find("claim") or action:find("rent") or action:find("take") then
                return prompt
            end
        end
    end
    return nil
end

local function autoClaimBooth()
    if hasClaimedBooth then
        Fluent:Notify({Title="Info", Content="Sudah punya booth!", Type="Info", Duration=2})
        return true
    end
    local char = lp.Character
    if not char or not char.Parent then return false end
    for i, pos in ipairs(BoothPositions) do
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = pos end
        task.wait(1.5)
        char = lp.Character
        if not char then return false end
        local prompt = findClaimPrompt(char)
        if prompt then
            local success = pcall(function() fireproximityprompt(prompt) end)
            if success then
                hasClaimedBooth = true
                Fluent:Notify({Title="Booth Claimed", Content="Berhasil claim booth #"..i, Type="Success", Duration=3})
                return true
            end
        end
        task.wait(0.5)
    end
    Fluent:Notify({Title="Gagal", Content="Semua booth penuh.", Type="Error", Duration=4})
    return false
end

