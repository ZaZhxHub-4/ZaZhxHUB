        local dumpStr = ""
        
        for i, v in ipairs(args) do
            dumpStr = dumpStr .. "Arg["..i.."]: " .. safeDump(v) .. "\n\n"
        end

        -- TANPA FILTER APAPUN. Langsung kirim ke Discord setiap kali FireChoicePrompt dipanggil.
        sendLog("📥 RECORD: FireChoicePrompt", "```lua\n" .. dumpStr .. "\n
```")

        return oldFireChoice(...)
    end)
    
    sendLog("✅ SAFE RECORDER AKTIF", "Berhasil memasang Hook. Silakan suruh temanmu request trade sekarang. Log akan langsung masuk ke sini.")
else
