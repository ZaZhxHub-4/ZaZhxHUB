-- ═══════════════════════════════════════════════════════
local RS      = game:GetService("ReplicatedStorage")
local HS      = game:GetService("HttpService")
local Players = game:GetService("Players")

local WEBHOOK = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"

local function send(title, desc, color)
    pcall(function()
        request({
            Url=WEBHOOK, Method="POST",
            Headers={["Content-Type"]="application/json"},
            Body=HS:JSONEncode({
                username="🔬 ZHX RF Monitor",
                embeds={{title=title, description=desc, color=color or 3066993,
                    footer={text="Monitor • "..os.date("%H:%M:%S")}}}
            })
        })
    end)
end

while not Players.LocalPlayer do task.wait() end

-- ─── Hook semua RemoteFunction & RemoteEvent di game ───
local hooks      = {}
local firedLog   = {}
local monitoring = false
local logCount   = 0

local function hookAll()
    -- Scan semua RF dan RE di seluruh game secara rekursif
    local function scanDescendants(parent)
        for _, obj in ipairs(parent:GetDescendants()) do
            if (obj:IsA("RemoteFunction") or obj:IsA("RemoteEvent")) and not hooks[obj] then
                hooks[obj] = true

                if obj:IsA("RemoteFunction") then
                    -- Hook InvokeServer
                    local ok = pcall(function()
                        local orig = obj.InvokeServer
                        obj.InvokeServer = function(self, ...)
                            if monitoring then
                                local args = {...}
                                local argStr = ""
                                pcall(function()
                                    argStr = HS:JSONEncode(args):sub(1, 200)
                                end)
                                logCount = logCount + 1
                                table.insert(firedLog, {
                                    type = "RF:Invoke",
                                    name = obj.Name,
                                    path = obj:GetFullName(),
                                    args = argStr,
                                    t    = os.date("%H:%M:%S")
                                })
                            end
                            return orig(self, ...)
                        end
                    end)
                    if not ok then
                        -- Fallback: hook via hookfunction jika tersedia
                        pcall(function()
                            hookfunction(obj.InvokeServer, function(self, ...)
                                if monitoring then
                                    local args = {...}
                                    local argStr = ""
                                    pcall(function() argStr = HS:JSONEncode(args):sub(1,200) end)
                                    logCount = logCount + 1
                                    table.insert(firedLog, {
                                        type="RF:Invoke", name=obj.Name,
                                        path=obj:GetFullName(), args=argStr, t=os.date("%H:%M:%S")
                                    })
                                end
                            end)
                        end)
                    end

                elseif obj:IsA("RemoteEvent") then
                    -- Connect listener ke FireServer
                    pcall(function()
                        obj.OnClientEvent:Connect(function(...)
                            -- Ini dari server ke client, bukan yang kita butuhkan
                        end)
                    end)
                    -- Hook FireServer
                    pcall(function()
                        hookfunction(obj.FireServer, function(self, ...)
                            if monitoring then
                                local args={...}
                                local argStr=""
                                pcall(function() argStr=HS:JSONEncode(args):sub(1,200) end)
                                logCount=logCount+1
                                table.insert(firedLog,{
                                    type="RE:Fire", name=obj.Name,
                                    path=obj:GetFullName(), args=argStr, t=os.date("%H:%M:%S")
                                })
                            end
                        end)
                    end)
                end
            end
        end
    end

    scanDescendants(RS)
    scanDescendants(game:GetService("Workspace"))
end

