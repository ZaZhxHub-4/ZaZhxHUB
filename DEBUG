-- NOTIFIER KUSTOM (pojok kanan bawah, bertumpuk ke atas, ringan)
-- ══════════════════════════════════════════════════════════════════
local Notifier = {}
Notifier.ActiveNotifications = {}
Notifier.Spacing = 52

local notifGui = Instance.new("ScreenGui")
notifGui.Name = "ZHX_NotifierGui"
notifGui.ResetOnSpawn = false
notifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
notifGui.DisplayOrder = 999
notifGui.Parent = pg

local notifScale = Instance.new("UIScale", notifGui)
notifScale.Scale = NOTIF_SCALE

function Notifier.new(config)
    local title    = config.Title or ""
    local content  = config.Content or ""
    local icon     = config.Icon or ZHX_PNG
    local duration = config.Duration or 3

    local notifFrame = Instance.new("Frame")
    notifFrame.Size = UDim2.new(0, 280, 0, 46)
    notifFrame.Position = UDim2.new(1, -300, 1, -20)
    notifFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    notifFrame.BorderSizePixel = 0
    notifFrame.BackgroundTransparency = 0.1
    notifFrame.ZIndex = 10
    notifFrame.Parent = notifGui

    Instance.new("UICorner", notifFrame).CornerRadius = UDim.new(0, 6)

    local accentBar = Instance.new("Frame")
    accentBar.Size = UDim2.new(0, 3, 1, -6)
    accentBar.Position = UDim2.new(0, 4, 0, 3)
    accentBar.BackgroundColor3 = ZHX_GREEN
    accentBar.BorderSizePixel = 0
    accentBar.Parent = notifFrame
    Instance.new("UICorner", accentBar).CornerRadius = UDim.new(0, 2)

    local iconLabel = Instance.new("ImageLabel")
    iconLabel.Size = UDim2.new(0, 28, 0, 28)
    iconLabel.Position = UDim2.new(0, 14, 0.5, -14)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Image = icon
    iconLabel.ScaleType = Enum.ScaleType.Fit
    iconLabel.Parent = notifFrame

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -54, 0, 18)
    titleLabel.Position = UDim2.new(0, 50, 0, 5)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = TEXT_WHITE
    titleLabel.TextSize = 13
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
    titleLabel.Parent = notifFrame

    local contentLabel = Instance.new("TextLabel")
    contentLabel.Size = UDim2.new(1, -54, 0, 16)
    contentLabel.Position = UDim2.new(0, 50, 0, 24)
    contentLabel.BackgroundTransparency = 1
    contentLabel.Text = content
    contentLabel.TextColor3 = TEXT_GRAY
    contentLabel.TextSize = 11
    contentLabel.Font = Enum.Font.Gotham
    contentLabel.TextXAlignment = Enum.TextXAlignment.Left
    contentLabel.TextTruncate = Enum.TextTruncate.AtEnd
    contentLabel.Parent = notifFrame

    local notifData = {
        Frame     = notifFrame,
        Duration  = duration,
        StartTime = tick(),
        Removed   = false
    }
    table.insert(Notifier.ActiveNotifications, notifData)

    notifFrame:TweenPosition(
        UDim2.new(1, -300, 1, -20),
        Enum.EasingDirection.InOut,
        Enum.EasingStyle.Quart,
        0.25,
        true
    )

    Notifier.UpdatePositions()

    task.delay(duration, function()
        if notifData.Removed then return end
        notifData.Removed = true
        notifFrame:TweenPosition(
            UDim2.new(1, -300, 1, 20),
            Enum.EasingDirection.In,
            Enum.EasingStyle.Quart,
            0.3,
            true
        )
        task.delay(0.3, function()
            if notifFrame and notifFrame.Parent then
                notifFrame:Destroy()
            end
            for i, n in ipairs(Notifier.ActiveNotifications) do
                if n == notifData then
                    table.remove(Notifier.ActiveNotifications, i)
                    break
                end
            end
            Notifier.UpdatePositions()
        end)
    end)

    return notifData
end

function Notifier.UpdatePositions()
    local count = #Notifier.ActiveNotifications
    for i, notifData in ipairs(Notifier.ActiveNotifications) do
        local indexFromBottom = count - i
        local yOffset = 20 + (indexFromBottom * Notifier.Spacing)
        local frame = notifData.Frame
        if frame and frame.Parent then
            frame:TweenPosition(
                UDim2.new(1, -300, 1, -yOffset),
                Enum.EasingDirection.InOut,
                Enum.EasingStyle.Quart,
                0.2,
                true
            )
        end
    end
end

