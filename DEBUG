-- 1. AUTO CLAIM BOOTH (Sukses Fix)
local function claimBoothFix()
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.ActionText == "Claim Booth" then
            local pos = obj.Parent:IsA("Attachment") and obj.Parent.WorldPosition or (obj.Parent:IsA("BasePart") and obj.Parent.Position)
            if pos then
                hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                task.wait(0.5)
                local oldLoS = obj.RequiresLineOfSight
                local oldDist = obj.MaxActivationDistance
                obj.RequiresLineOfSight = false
                obj.MaxActivationDistance = 99
                pcall(function() fireproximityprompt(obj) end)
                task.wait(0.5)
                obj.RequiresLineOfSight = oldLoS
                obj.MaxActivationDistance = oldDist
                print("[+] Booth berhasil di-claim!")
                return true
            end
        end
    end
    return false
end

-- 2. BACA DATA ITEM DARI TAS
local function getInventoryData(itemName)
    local Replion = require(RS.Packages.Replion)
    local PlayerData = Replion.Client:WaitReplion("Data")
    local inv = PlayerData:Get("Inventory")
    if not inv or not inv.Items then return nil, nil end
    for _, item in ipairs(inv.Items) do
        local data = require(RS.Shared.ItemUtility):GetItemData(item.Id)
        local n = (data and data.Data and data.Data.Name) or (data and data.Name)
        if n == itemName then
            local cat = (data and data.Data and data.Data.Type) or (data and data.Type) or "Item"
            return item.UUID, cat
        end
    end
    return nil, nil
end

-- 3. EKSEKUSI REMOTE LANGSUNG
local function testDirectListing(itemName, price)
    local uuid, category = getInventoryData(itemName)
    if not uuid then warn("[-] Item '"..itemName.."' tidak ditemukan di tas!"); return end

    print("[+] Item ketemu! UUID:", uuid, "| Kategori:", category)

    -- Ekstrak RemoteFunction dari Kamus Jaringan (Sesuai Screenshot 1)
    local RF_CreateListing = nil
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "CreateSaleListing") then
            if typeof(rawget(v, "CreateSaleListing")) == "Instance" then
                RF_CreateListing = rawget(v, "CreateSaleListing")
                break
            end
        end
    end

    if not RF_CreateListing then warn("[-] RemoteFunction tidak ditemukan!"); return end
    
    print("[+] RemoteFunction didapatkan! Memulai tembakan bombardir...")

    -- Bombardir 4 Pola Argumen Paling Umum
    task.spawn(function() pcall(function() RF_CreateListing:InvokeServer(uuid, price) end) end)
    task.spawn(function() pcall(function() RF_CreateListing:InvokeServer(category, uuid, price) end) end)
    task.spawn(function() pcall(function() RF_CreateListing:InvokeServer(uuid, price, category) end) end)
    task.spawn(function() pcall(function() RF_CreateListing:InvokeServer(price, uuid) end) end)

    task.wait(1.5)
    print("[!] TEST SELESAI. Cek Booth kamu sekarang, apakah " .. itemName .. " seharga " .. price .. " berhasil dipajang?")
end

