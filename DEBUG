-- =====================
-- HOOK
-- =====================
addLog("Hook dipasang — silakan hapus 1 item dari booth", Color3.fromRGB(80, 255, 150))

local orig
setthreadidentity(6)
orig = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "InvokeServer" then
        task.spawn(function()
            local args = {...}

            local rfName = "Unknown"
            pcall(function() rfName = self.Name end)

            local hasUUID = false
            for _, v in ipairs(args) do
                if type(v) == "string" and #v == 36 and v:match(
                    "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
                ) then hasUUID = true end
            end

            -- Log SEMUA InvokeServer, bukan hanya yang ada UUID
            local argInfo = {}
            for i, v in ipairs(args) do
                local t = type(v)
                local display = ""
                if t == "string" then
                    display = '"' .. tostring(v):sub(1, 36) .. '"'
                elseif t == "number" then
                    display = tostring(v)
                elseif t == "boolean" then
                    display = tostring(v)
                else
                    display = "[" .. t .. "]"
                end
                table.insert(argInfo, "A"..i.."("..t..")="..display)
            end

            local color = hasUUID
                and Color3.fromRGB(80, 255, 150)
                or Color3.fromRGB(160, 160, 180)

            addLog("RF: " .. rfName .. " | " .. table.concat(argInfo, " | "), color)

            if hasUUID then
                statusLbl.Text = "✅ Ada UUID! RF: " .. rfName .. " — " .. #args .. " args"
                statusLbl.TextColor3 = Color3.fromRGB(80, 255, 150)
            end
        end)
    end
    return orig(self, ...)
end))
