    }
end

local function applyLightingPotato()
    Lighting.GlobalShadows           = false
    Lighting.Brightness              = 1
    Lighting.ClockTime               = 14
    Lighting.TimeOfDay               = "14:00:00"
    Lighting.EnvironmentDiffuseScale = 0.2
    Lighting.EnvironmentSpecularScale = 0.1
    Lighting.Technology              = Enum.Technology.ShadowMap
    Lighting.ShadowSoftness          = 0
    Lighting.Ambient                 = Color3.fromRGB(100, 100, 100)
    Lighting.OutdoorAmbient          = Color3.fromRGB(120, 120, 120)
    Lighting.FogColor                = Color3.fromRGB(150, 150, 150)
    Lighting.FogEnd                  = 1000
    Lighting.FogStart                = 500
    Lighting.ColorShift_Top          = Color3.new(0, 0, 0)
    Lighting.ColorShift_Bottom       = Color3.new(0, 0, 0)
end

local function restoreLighting()
    for p, v in pairs(originalLighting) do pcall(function() Lighting[p] = v end) end
end

local function disableVFX(obj)
    if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke")
    or obj:IsA("Sparkles") or obj:IsA("Trail") or obj:IsA("Beam") then
        pcall(function() obj.Enabled = false end)
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        pcall(function() obj.Transparency = 1 end)
    end
    for _, c in ipairs(obj:GetChildren()) do disableVFX(c) end
end

local function simplifyChar(char)
    if not char then return end
    for _, a in ipairs(char:GetChildren()) do
        if a:IsA("Accessory") then
            pcall(function() a.Handle.Transparency = 1; a.Handle.Size = Vector3.new(0.1, 0.1, 0.1) end)
        elseif a:IsA("Clothing") or a:IsA("Shirt") or a:IsA("Pants") then
            pcall(function() a:Destroy() end)
        end
    end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            pcall(function() p.Material = Enum.Material.Plastic; p.Reflectance = 0 end)
        end
    end
end

local function applyBoostFPS(en)
    if en then
        if next(originalLighting) == nil then storeOriginalLighting() end
        applyLightingPotato()
        task.spawn(function()
            local all = Workspace:GetDescendants()
            for i, obj in ipairs(all) do
                if not boostFPSEnabled then break end
                if obj:IsA("BasePart") and not obj:IsA("Terrain") then
                    pcall(function() obj.Material = Enum.Material.Plastic end)
                end
                disableVFX(obj)
                if i % 100 == 0 then task.wait() end
            end
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then simplifyChar(p.Character) end
            end
            if descendantsConn then descendantsConn:Disconnect() end
            descendantsConn = Workspace.DescendantAdded:Connect(function(c)
                if boostFPSEnabled then
                    if c:IsA("BasePart") and not c:IsA("Terrain") then
                        pcall(function() c.Material = Enum.Material.Plastic end)
                    end
                    disableVFX(c)
                    if c:IsA("Accessory") then
                        task.wait(0.05); simplifyChar(c.Parent)
                    end
                end
            end)
            if playersAddedConn then playersAddedConn:Disconnect() end
            playersAddedConn = Players.PlayerAdded:Connect(function(p)
                p.CharacterAdded:Connect(function(c)
                    if boostFPSEnabled then task.wait(0.5); simplifyChar(c) end
                end)
            end)
        end)
    else
        restoreLighting()
        if descendantsConn  then descendantsConn:Disconnect();  descendantsConn  = nil end
        if playersAddedConn then playersAddedConn:Disconnect(); playersAddedConn = nil end
    end
end

