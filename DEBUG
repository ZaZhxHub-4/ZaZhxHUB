stopBtn.MouseButton1Click:Connect(function()
    monitoring=false
    statusLbl.Text="Status: STOP — mengirim hasil..."; statusLbl.TextColor3=Color3.fromRGB(160,170,165)
    startBtn.BackgroundColor3=Color3.fromRGB(20,65,40)

    if #firedLog==0 then
        send("⚠ Tidak Ada Yang Tertangkap","Tidak ada RF/RE yang fired selama rekam.\nPastikan aksi dilakukan SAAT tombol MULAI REKAM aktif.",16776960)
        return
    end

    -- Kirim hasil ke Discord
    send("⏹ Rekam Selesai","Total tertangkap: **"..#firedLog.."** RF/RE\nDetail dikirim di bawah...",3066993)
    task.wait(0.3)

    -- Kirim per chunk agar tidak melebihi limit Discord
    local lines={}
    for i,entry in ipairs(firedLog) do
        local line=string.format("[%d] **%s** `%s`\nArgs: `%s`",
            i, entry.type, entry.name, entry.args~="" and entry.args or "(kosong)")
        table.insert(lines,line)
    end

    local chunk=""; local msgNum=0
    for _,line in ipairs(lines) do
        if #chunk+#line+2 > 1800 then
            msgNum=msgNum+1
            send("📋 Log #"..msgNum, chunk, 3447003)
            task.wait(0.4)
            chunk=line.."\n\n"
        else
            chunk=chunk..line.."\n\n"
        end
    end
    if chunk~="" then
        msgNum=msgNum+1
        send("📋 Log #"..msgNum, chunk, 3447003)
    end

    -- Kirim juga rangkuman nama RF saja (lebih mudah dibaca)
    task.wait(0.3)
    local names={}; local seen={}
    for _,entry in ipairs(firedLog) do
        if not seen[entry.name] then
            seen[entry.name]=true
            table.insert(names,"• `"..entry.name.."` ("..entry.type..")")
        end
    end
    send("📌 Rangkuman RF/RE Unik yang Fired",table.concat(names,"\n"),16776960)
end)

