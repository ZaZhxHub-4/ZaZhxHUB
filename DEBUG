-- ============================================================
-- TEST EQUIP/UNEQUIP ROD - PENCARIAN LANGSUNG
-- ============================================================
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local RS = game:GetService("ReplicatedStorage")

-- Cari remote event EquipToolFromHotbar dan UnequipToolFromHotbar
local equipRemote = nil
local unequipRemote = nil

for _, obj in ipairs(game:GetDescendants()) do
    if obj.Name == "EquipToolFromHotbar" and obj:IsA("RemoteEvent") then
        equipRemote = obj
    elseif obj.Name == "UnequipToolFromHotbar" and obj:IsA("RemoteEvent") then
        unequipRemote = obj
    end
end

if not equipRemote then
    warn("EquipToolFromHotbar tidak ditemukan!")
    print("Mencoba mencari remote event dengan kata kunci 'Equip'...")
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (obj.Name:find("Equip") or obj.Name:find("Tool")) then
            print(" - Ditemukan:", obj:GetFullName())
        end
    end
    return
end

if not unequipRemote then
    warn("UnequipToolFromHotbar tidak ditemukan!")
end

print("✅ Remote event ditemukan:")
print("   Equip:", equipRemote:GetFullName())
if unequipRemote then
    print("   Unequip:", unequipRemote:GetFullName())
end

-- Fungsi untuk mendapatkan tool di hotbar (backpack)
local function getHotbarTools()
    local backpack = lp:FindFirstChild("Backpack")
    if not backpack then return {} end
    local tools = {}
    for _, child in ipairs(backpack:GetChildren()) do
        if child:IsA("Tool") then
            table.insert(tools, child)
        end
    end
    return tools
end

-- Fungsi untuk mendapatkan tool yang sedang di-equip
local function getEquippedTool()
    local char = lp.Character
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            return child
        end
    end
    return nil
end

-- Test equip dengan berbagai parameter
local function testEquip()
    local tools = getHotbarTools()
    if #tools == 0 then
        print("❌ Tidak ada rod di hotbar (backpack). Masukkan rod ke hotbar dulu.")
        return false
    end
    
    local rod = tools[1]
    print("🔧 Mencoba equip rod:", rod.Name)
    
    -- Parameter kemungkinan: tool instance
    print("→ Mencoba parameter (tool instance)")
    local success = pcall(function()
        equipRemote:FireServer(rod)
    end)
    if success then
        task.wait(1)
        if getEquippedTool() then
            print("✅ BERHASIL equip dengan tool instance!")
            return true
        end
    end
    
    -- Parameter: slot number (0-7)
    for slot = 0, 7 do
        print("→ Mencoba parameter (slot):", slot)
        pcall(function()
            equipRemote:FireServer(slot)
        end)
        task.wait(0.5)
        if getEquippedTool() then
            print("✅ BERHASIL equip dengan slot:", slot)
            return true
        end
    end
    
    -- Parameter: nama tool (string)
    print("→ Mencoba parameter (string nama tool):", rod.Name)
    pcall(function()
        equipRemote:FireServer(rod.Name)
    end)
    task.wait(1)
    if getEquippedTool() then
        print("✅ BERHASIL equip dengan nama tool!")
        return true
    end
    
    -- Parameter: UUID? (mungkin tool memiliki attribute)
    local uuid = rod:GetAttribute("UUID") or rod:GetAttribute("ItemId")
    if uuid then
        print("→ Mencoba parameter (UUID):", uuid)
        pcall(function()
            equipRemote:FireServer(uuid)
        end)
        task.wait(1)
        if getEquippedTool() then
            print("✅ BERHASIL equip dengan UUID!")
            return true
        end
    end
    
    print("❌ Semua percobaan equip gagal.")
    return false
end

-- Test unequip
local function testUnequip()
    if not unequipRemote then
        print("⚠️ Unequip remote tidak ditemukan, skip.")
        return false
    end
    
    local current = getEquippedTool()
    if not current then
        print("⚠️ Tidak ada rod yang sedang di-equip. Equip dulu.")
        return false
    end
    
    print("🔧 Mencoba unequip rod:", current.Name)
    print("→ Mencoba tanpa parameter")
    pcall(function()
        unequipRemote:FireServer()
    end)
    task.wait(1)
    if not getEquippedTool() then
        print("✅ BERHASIL unequip!")
        return true
    end
    
    print("→ Mencoba dengan parameter tool instance")
    pcall(function()
        unequipRemote:FireServer(current)
    end)
    task.wait(1)
    if not getEquippedTool() then
        print("✅ BERHASIL unequip dengan tool instance!")
        return true
    end
    
    print("❌ Unequip gagal.")
    return false
end

-- ============================================================
-- EKSEKUSI TEST
-- ============================================================
print("========== TEST EQUIP ROD ==========")
task.wait(2) -- tunggu stabil
if testEquip() then
    task.wait(2)
    print("========== TEST UNEQUIP ROD ==========")
    testUnequip()
end

print("========== SELESAI ==========")
print("Jika equip/unequip berhasil, metode ini bisa dipakai untuk anti AFK.")
print("Jika gagal semua, coba manual equip/unequip dan lihat apakah remote event terpanggil.")
