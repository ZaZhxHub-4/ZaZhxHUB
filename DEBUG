-- // ZHX Auto Event - Phase 5: Debug Walk Test
-- // Cek setiap langkah, kirim log ke Discord

local webhook = "https://discord.com/api/webhooks/1506044266684743801/PlopEC1wwOyfGQh-3oBQFl67_IPfoNmUYDMvEU_kjvZP6zR6v0BjfMeObTUsxhOUepqg"
local HS = game:GetService("HttpService")
local WS = game:GetService("Workspace")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

local function send(msg)
    pcall(function()
        local body = HS:JSONEncode({content = msg:sub(1, 1900)})
        if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif syn and syn.request then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        else request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        end
    end)
end

send("🔍 Phase 5: Debug Walk Test dimulai...")

local propsFolder = WS:FindFirstChild("Props")
if not propsFolder then
    send("❌ Folder Props tidak ditemukan")
    return
end

send("✅ Folder Props ditemukan. Isi Props:")
for _, child in ipairs(propsFolder:GetChildren()) do
    send("  - " .. child.Name .. " (" .. child.ClassName .. ")")
end

-- Cek model Megalodon Hunt
local model = propsFolder:FindFirstChild("Megalodon Hunt")
if not model then
    send("❌ Model Megalodon Hunt TIDAK ditemukan di Props")
    -- Coba cari di seluruh workspace
    send("🔍 Mencari di seluruh Workspace...")
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj.Name == "Megalodon Hunt" then
            send("🎯 Ditemukan di: " .. obj:GetFullName() .. " (" .. obj.ClassName .. ")")
        end
    end
    return
end

send("✅ Model Megalodon Hunt ditemukan! Class: " .. model.ClassName)

-- Cari PrimaryPart
local primary = model.PrimaryPart
if primary then
    send("✅ PrimaryPart: " .. primary.Name .. " | Posisi: " .. tostring(primary.Position))
else
    send("⚠️ Tidak ada PrimaryPart. Mencari BasePart...")
    local part = model:FindFirstChildOfClass("BasePart")
    if part then
        send("✅ BasePart ditemukan: " .. part.Name .. " | Posisi: " .. tostring(part.Position))
    else
        send("❌ Tidak ada BasePart di dalam model. Mencari semua descendants...")
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") then
                send("  🧱 " .. obj.Name .. " | Posisi: " .. tostring(obj.Position))
            end
        end
    end
end

-- Ambil posisi event
local eventPos = nil
local targetPart = model.PrimaryPart or model:FindFirstChildOfClass("BasePart") or model:FindFirstChildWhichIsA("BasePart")
if targetPart then
    eventPos = targetPart.Position
    send("📍 Posisi event: " .. tostring(eventPos))
else
    -- Coba ambil dari part pertama
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then
            eventPos = obj.Position
            send("📍 Posisi event (dari descendant): " .. tostring(eventPos))
            break
        end
    end
end

-- Jika posisi ditemukan, coba walk
if eventPos then
    local char = LP.Character
    if not char then
        send("❌ Karakter tidak ditemukan")
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        send("❌ HumanoidRootPart tidak ditemukan")
        return
    end

    send("🚶 Memulai walk ke event...")
    local targetCF = CFrame.new(eventPos + Vector3.new(0, 5, 0)) -- sedikit di atas air
    
    -- Walk sederhana tanpa noclip (hanya untuk test)
    local distance = (targetCF.Position - root.Position).Magnitude
    send("📏 Jarak: " .. string.format("%.0f", distance) .. " studs")
    
    -- Coba pindahkan langsung untuk test
    pcall(function()
        root.CFrame = targetCF
    end)
    send("✅ User dipindahkan ke posisi event! Cek apakah berhasil.")
else
    send("❌ Tidak bisa mendapatkan posisi event")
end

send("✅ Phase 5 selesai.")
