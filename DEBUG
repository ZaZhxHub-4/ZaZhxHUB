                    checkBtn.BackgroundTransparency = 1
                    checkBtn.Text = ""
                    checkBtn.ZIndex = 203
                    checkBtn.Parent = checkFrame

                    checkBtn.MouseEnter:Connect(function()
                        checkFrame.BackgroundColor3 = Color3.fromRGB(40, 43, 52)
                    end)
                    checkBtn.MouseLeave:Connect(function()
                        checkFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                        checkFrame.BackgroundTransparency = 1
                    end)

                    checkBtn.MouseButton1Click:Connect(function()
                        selectedOptions[opt] = not selectedOptions[opt]
                        checkIcon.Image = selectedOptions[opt] and "rbxassetid://7072720342" or "rbxassetid://7072720870"
                        -- Update main button text
                        local chosen = {}
                        for k, v in pairs(selectedOptions) do
                            if v then table.insert(chosen, k) end
                        end
                        if #chosen == 0 then
                            mainBtn.Text = "Tidak ada yang dipilih"
                        else
                            mainBtn.Text = table.concat(chosen, ", ")
                        end
                        if dropdownConfig.Callback then
                            dropdownConfig.Callback(selectedOptions)
                        end
                    end)
                end
            end

            -- Toggle list
            mainBtn.MouseButton1Click:Connect(function()
                listFrame.Visible = not listFrame.Visible
            end)

            -- Close list ketika klik di luar
            local function closeList()
                listFrame.Visible = false
            end

            -- Deteksi klik di luar via rootFrame
            rootFrame.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    if listFrame.Visible then
                        -- Delay sedikit agar klik tombol dulu terproses
                        task.delay(0.1, function()
