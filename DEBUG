local function findRealRF()
    local ok, net = pcall(function() return RS.Packages._Index["sleitnick_net@0.2.0"].net end)
    if not ok or not net then return nil end
    for i, child in ipairs(net:GetChildren()) do
        if child.Name == "RF/Trading/CreateSaleListing" then
            local childRF = child:FindFirstChildOfClass("RemoteFunction")
            if childRF then
                local h = childRF.Name:match("^RF/([a-fA-F0-9]+)$")
                if h and #h == 64 then return childRF end
            end
            local nxt = net:GetChildren()[i+1]
            if nxt and nxt:IsA("RemoteFunction") then
                local h = nxt.Name:match("^RF/([a-fA-F0-9]+)$")
                if h and #h == 64 then return nxt end
            end
            break
        end
    end
    return nil
end

local function findRealDeleteRF()
    local ok, net = pcall(function() return RS.Packages._Index["sleitnick_net@0.2.0"].net end)
    if not ok or not net then return nil end
    for i, child in ipairs(net:GetChildren()) do
