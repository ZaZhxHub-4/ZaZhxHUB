-- Fungsi dump super aman (hanya 1 level) untuk mencegah crash
local function miniDump(tbl)
    local s = "{\n"
    pcall(function()
        for k, v in pairs(tbl) do
            local vStr = tostring(v)
            if string.len(vStr) > 50 then vStr = string.sub(vStr, 1, 50) .. "..." end
            s = s .. "  [" .. tostring(k) .. "] = " .. vStr .. " (" .. type(v) .. ")\n"
        end
    end)
    return s .. "}"
end

local isHooked = false

-- Hook FireChoicePrompt
if type(PromptController.FireChoicePrompt) == "function" then
    local oldChoice
    oldChoice = hookfunction(PromptController.FireChoicePrompt, function(...)
        local args = {...}
        local logMsg = "🚨 FIRE_CHOICE_PROMPT DIPANGGIL!\nArgumen ke-1: "
        if type(args[1]) == "table" then
            logMsg = logMsg .. miniDump(args[1])
        else
            logMsg = logMsg .. tostring(args[1])
        end
        
