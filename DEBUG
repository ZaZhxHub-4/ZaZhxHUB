-- =====================
-- LOGIC SCAN MEMORY
-- =====================
ScanBtn.MouseButton1Click:Connect(function()
    ScanBtn.Text = "⏳ MENCARI... (AWAS LAG)"
    ScanBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 50)
    LogBox.Text = "Memulai scan memori, tunggu sebentar...\n-----------------------------------\n"
    task.wait(0.1) -- Jeda UI

    local foundTables = 0
    local resultText = ""
    local gc = getgc(true)
    
    for i, v in pairs(gc) do
        if type(v) == "table" then
            local hasRemote = false
            local hasStringKey = false
            
            pcall(function()
                for key, val in pairs(v) do
                    if type(key) == "string" and typeof(val) == "Instance" then
                        if val:IsA("RemoteEvent") or val:IsA("RemoteFunction") then
                            hasRemote = true
                            hasStringKey = true
                            break
                        end
                    end
                end
            end)

            if hasRemote and hasStringKey then
                foundTables = foundTables + 1
                resultText = resultText .. "\n=== TABEL KANDIDAT #" .. foundTables .. " ===\n"
                
                for key, val in pairs(v) do
                    if type(key) == "string" and typeof(val) == "Instance" then
                        if val:IsA("RemoteEvent") or val:IsA("RemoteFunction") then
                            resultText = resultText .. '["' .. key .. '"] = ' .. val.Name .. '\n'
                        end
                    end
                end
            end
        end
    end

    if foundTables > 0 then
        LogBox.Text = "Berhasil menemukan " .. foundTables .. " tabel kamus!\n" .. resultText
    else
        LogBox.Text = "Tidak ada tabel kamus Remote yang ditemukan di memori."
    end

    ScanBtn.Text = "✅ SELESAI"
    ScanBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 200)
end)

