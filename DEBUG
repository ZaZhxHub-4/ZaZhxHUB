local function addLog(msg)
    outputBox.Text = outputBox.Text .. "\n" .. msg
    -- Auto scroll ke bawah
    outputBox.CursorPosition = -1
end

-- Mulai test
addLog("🔍 Mencari remote event EquipToolFromHotbar...")

local equipRemote = nil
local unequipRemote = nil

for _, obj in ipairs(game:GetDescendants()) do
    if obj:IsA("RemoteEvent") then
        if obj.Name == "EquipToolFromHotbar" then
            equipRemote = obj
            addLog("✅ Ditemukan EquipToolFromHotbar di: " .. obj:GetFullName())
        elseif obj.Name == "UnequipToolFromHotbar" then
            unequipRemote = obj
            addLog("✅ Ditemukan UnequipToolFromHotbar di: " .. obj:GetFullName())
        end
    end
end

if not equipRemote then
    addLog("❌ EquipToolFromHotbar tidak ditemukan!")
    addLog("📡 Menampilkan semua RemoteEvent dengan kata 'Equip':")
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") and obj.Name:lower():find("equip") then
            addLog("   - " .. obj.Name .. " di " .. obj:GetFullName())
        end
    end
    return
end

-- Ambil tool di hotbar
local backpack = lp:FindFirstChild("Backpack")
if not backpack then
    addLog("❌ Backpack tidak ditemukan, tunggu sebentar...")
    backpack = lp:WaitForChild("Backpack", 5)
    if not backpack then
        addLog("❌ Backpack tidak muncul, pastikan karakter sudah spawn.")
        return
    end
end

local tools = {}
for _, child in ipairs(backpack:GetChildren()) do
    if child:IsA("Tool") then
        table.insert(tools, child)
        addLog("📦 Tool di hotbar: " .. child.Name)
    end
end

if #tools == 0 then
    addLog("❌ Tidak ada tool di hotbar! Masukkan rod ke hotbar dulu.")
    return
end

local testRod = tools[1]
addLog("🔧 Akan meng-equip rod: " .. testRod.Name)

local function tryEquip(param, paramDesc)
    addLog("→ Mencoba " .. paramDesc)
    local success, err = pcall(function()
        equipRemote:FireServer(param)
    end)
    if success then
        addLog("  FireServer berhasil dikirim.")
    else
        addLog("  FireServer gagal: " .. tostring(err))
    end
    task.wait(1.5)
    -- Cek apakah rod sudah di tangan
    local char = lp.Character
    if char and char:FindFirstChild(testRod.Name) then
        addLog("🎉 BERHASIL! Rod " .. testRod.Name .. " berada di tangan!")
        return true
    end
    addLog("  ⚠️ Rod tidak muncul di tangan.")
    return false
end

addLog("========== MULAI TEST EQUIP ==========")

-- Coba parameter 1: tool instance
if tryEquip(testRod, "tool instance") then return end

-- Coba parameter 2: nomor slot (0-7)
for slot = 0, 7 do
    if tryEquip(slot, "slot " .. slot) then return end
end

-- Coba parameter 3: nama tool string
if tryEquip(testRod.Name, "string nama tool") then return end

-- Coba parameter 4: UUID jika ada
local uuid = testRod:GetAttribute("UUID") or testRod:GetAttribute("ItemId")
if uuid then
    if tryEquip(uuid, "UUID: " .. uuid) then return end
end

-- Coba parameter 5: kosong (tanpa parameter)
addLog("→ Mencoba tanpa parameter")
local success, err = pcall(function()
    equipRemote:FireServer()
end)
if success then
    addLog("  FireServer berhasil dikirim.")
    task.wait(1.5)
    local char = lp.Character
    if char and char:FindFirstChild(testRod.Name) then
        addLog("🎉 BERHASIL! Rod " .. testRod.Name .. " berada di tangan!")
        return
    end
end

addLog("❌ Semua percobaan equip gagal. Tidak ada yang berhasil.")

-- Optional: test unequip jika ada remote
if unequipRemote then
    addLog("========== TEST UNEQUIP ==========")
    addLog("→ Mencoba unequip tanpa parameter")
    pcall(function()
        unequipRemote:FireServer()
    end)
    task.wait(1)
    local char = lp.Character
    if char and not char:FindFirstChildWhichIsA("Tool") then
        addLog("✅ Unequip berhasil! Tidak ada tool di tangan.")
    else
        addLog("⚠️ Unequip gagal, tool masih di tangan.")
    end
end

addLog("========== SELESAI ==========")
addLog("Jika equip berhasil, metode ini bisa dipakai.")
addLog("Tutup GUI ini untuk mengakhiri.")
