local CONFIG_FILE = "ZhxBooth_v9_config.json"
local savedConfigs = {}
local configNameList = {"- Belum Ada Config -"}

local function loadConfigsFromFile()
    if type(readfile) ~= "function" then return end
    pcall(function()
        if isfile(CONFIG_FILE) then
            local d = HS:JSONDecode(readfile(CONFIG_FILE))
            if d.names then configNameList = d.names end
            if d.configs then savedConfigs = d.configs end
        end
    end)
end
loadConfigsFromFile()

local function saveConfigsToFile()
    if type(writefile) == "function" then
        pcall(function() writefile(CONFIG_FILE, HS:JSONEncode({names=configNameList, configs=savedConfigs})) end)
    end
end

Tabs.Config:AddParagraph({Title="Config", Content="Simpan & load konfigurasi."})
local cfgNameInput = Tabs.Config:AddInput("CfgName", {Title="Nama Config", Placeholder="Contoh: Salmon"})
local cfgSelectDD = Tabs.Config:AddDropdown("CfgList", {Title="Pilih Config", Values=configNameList})
Tabs.Config:AddButton({
    Title = "SIMPAN CONFIG",
    Callback = function()
        local name = cfgNameInput.Value
        if not name or name:match("^%s*$") then Fluent:Notify({Title="Error", Content="Isi nama!", Type="Error", Duration=2}) return end
        local cfg = {single={}, multi={}, webhook=webhookURL}
        for i=1,MAX_SLOTS do
            if slotData[i].itemId and slotData[i].price>0 then
                cfg.single[i] = {itemId=slotData[i].itemId, itemName=slotData[i].itemName, category=slotData[i].category, price=slotData[i].price}
            end
        end
        for m=1,MAX_MULTI do
            if #multiSlotData[m].items>0 then
                cfg.multi[m] = {items={}, price=multiSlotData[m].price}
                for _,it in ipairs(multiSlotData[m].items) do table.insert(cfg.multi[m].items, {itemId=it.itemId, itemName=it.itemName, category=it.category}) end
            end
        end
        savedConfigs[name] = cfg
        if configNameList[1] == "- Belum Ada Config -" then table.remove(configNameList,1) end
        if not table.find(configNameList, name) then table.insert(configNameList, name) end
        saveConfigsToFile()
        cfgSelectDD:SetValues(configNameList)
        cfgSelectDD:SetValue(name)
        Fluent:Notify({Title="Tersimpan", Content="Config '"..name.."' disimpan.", Type="Success", Duration=2})
    end
})
Tabs.Config:AddButton({
    Title = "LOAD CONFIG",
    Callback = function()
        local name = cfgSelectDD.Value
        if not name or not savedConfigs[name] then Fluent:Notify({Title="Error", Content="Pilih config!", Type="Error", Duration=2}) return end
        local list = getInventoryItemList()
        allItemsCache = list
        nameToIdMap = {}
        local singleList = {"- Kosongkan -"}
        for _,it in ipairs(list) do
            if it.name then
                table.insert(singleList, it.name)
                nameToIdMap[it.name] = {id=it.itemId, cat=it.category}
            end
        end
        for i=1,MAX_SLOTS do pcall(function() UIElements.SingleDD[i]:SetValues(singleList) end) end
        local cfg = savedConfigs[name]
        for i=1,MAX_SLOTS do
            slotData[i] = {itemId=nil,itemName=nil,category=nil,price=0,active=false,listedUUID=nil}
            if cfg.single and cfg.single[i] and nameToIdMap[cfg.single[i].itemName] then
                local s = cfg.single[i]
                slotData[i] = {itemId=s.itemId, itemName=s.itemName, category=s.category, price=s.price, active=s.price>0, listedUUID=nil}
                pcall(function() UIElements.SingleDD[i]:SetValue(s.itemName) end)
                pcall(function() UIElements.SinglePrice[i]:SetValue(tostring(s.price)) end)
            else
                pcall(function() UIElements.SingleDD[i]:SetValue("- Kosongkan -") end)
                pcall(function() UIElements.SinglePrice[i]:SetValue("") end)
            end
        end
        for m=1,MAX_MULTI do
            multiSlotData[m] = {items={}, price=0, active=false, currentItemIdx=1, listedUUID=nil}
            if cfg.multi and cfg.multi[m] then
                local valid = {}
                for _,it in ipairs(cfg.multi[m].items) do
                    if nameToIdMap[it.itemName] then
                        table.insert(valid, {itemId=it.itemId, itemName=it.itemName, category=it.category})
                    end
                end
                if #valid>0 then
                    multiSlotData[m].items = valid
                    multiSlotData[m].price = cfg.multi[m].price
                    multiSlotData[m].active = (cfg.multi[m].price>0)
                    pcall(function() UIElements.MultiPrice[m]:SetValue(tostring(cfg.multi[m].price)) end)
                end
            end
            rebuildMultiTagsLabel(m)
        end
        if cfg.webhook then webhookURL = cfg.webhook; pcall(function() Window.Elements["WH_Input"]:SetValue(cfg.webhook) end) end
        updateAllUIStatus()
        Fluent:Notify({Title="Dimuat", Content="Config '"..name.."' loaded.", Type="Success", Duration=2})
    end
})
Tabs.Config:AddButton({
    Title = "HAPUS CONFIG",
    Callback = function()
        local name = cfgSelectDD.Value
        if not name or not savedConfigs[name] then Fluent:Notify({Title="Error", Content="Pilih config!", Type="Error", Duration=2}) return end
        savedConfigs[name] = nil
        for i,n in ipairs(configNameList) do if n==name then table.remove(configNameList,i); break end end
        if #configNameList==0 then table.insert(configNameList, "- Belum Ada Config -") end
        saveConfigsToFile()
        cfgSelectDD:SetValues(configNameList)
        cfgSelectDD:SetValue(configNameList[1])
        Fluent:Notify({Title="Dihapus", Content="Config '"..name.."' dihapus.", Type="Warning", Duration=2})
    end
})

