                        if type(k) == "string" and type(v) == "boolean" then isDict = true; break end
                    end
                    
                    for _, item in ipairs(allItemsCache) do
                        local isSelected = false
                        if isDict then isSelected = selected[item.name] == true
                        else 
                            for _, v in pairs(selected) do if v == item.name then isSelected = true; break end end
                        end
                        
                        if isSelected then
