sendLog("🧪 Memulai Inject", "Mencari PromptController di memory (Metode Hook)...", 3066993)

local PromptController = nil

-- 1. Mencari PromptController dari module yang sudah dimuat oleh game
for _, module in pairs(getloadedmodules()) do
    if module.Name == "PromptController" then
        local success, result = pcall(require, module)
        if success then
            PromptController = result
            break
        end
    end
end

if PromptController then
    -- Kirim isi dari PromptController ke Discord agar kita tahu fungsi apa saja yang ada
    local keys = {}
    for k, v in pairs(PromptController) do
        table.insert(keys, tostring(k) .. " [" .. type(v) .. "]")
    end
    sendLog("✅ PromptController Ditemukan", "Isi Module:\n```\n" .. table.concat(keys, "\n") .. "\n```", 3066993)
    
    -- 2. Memasang Hook ke fungsi-fungsi yang berpotensi memanggil UI Prompt
    local targetFunctions = {"Prompt", "Show", "New", "Create", "TradeRequest"}
    local hookedCount = 0
    
    for _, funcName in ipairs(targetFunctions) do
        if type(PromptController[funcName]) == "function" then
            local oldFunc
            oldFunc = hookfunction(PromptController[funcName], function(...)
                local args = {...}
                local isTrade = false
                local debugInfo = ""
                
                -- Analisa semua argument yang masuk ke fungsi ini
                for i, v in ipairs(args) do
                    debugInfo = debugInfo .. "Arg["..i.."]: " .. tostring(v) .. " ("..type(v)..")\n"
                    if type(v) == "string" then
                        local lowerStr = string.lower(v)
                        if string.find(lowerStr, "trade") or string.find(lowerStr, "request") then
                            isTrade = true
                        end
                    elseif type(v) == "table" then
                        for tk, tv in pairs(v) do
                            local valStr = tostring(tv)
                            debugInfo = debugInfo .. "  ["..tostring(tk).."] = " .. valStr .. " ("..type(tv)..")\n"
                            if type(tv) == "string" then
                                local lowerStr = string.lower(tv)
                                if string.find(lowerStr, "trade") or string.find(lowerStr, "request") then
                                    isTrade = true
                                end
                            end
                        end
                    end
                end
                
                -- Jika data yang ditangkap mengindikasikan ini adalah Trade Request
                if isTrade then
                    sendLog("🛡️ TRADE DIBLOKIR (Hooked)", "Fungsi yang dicegat: **" .. funcName .. "**\n\n**Data Arguments (Bypass Rendering):**\n```\n" .. debugInfo .. "\n```", 16711680)
                    
                    -- KUNCI UTAMA: Kita mengembalikan 'nil' agar script game gagal mengeksekusi UI-nya
                    -- Dengan begini, pop-up tidak akan pernah tergambar (render) di layar.
                    return nil 
                end
                
                -- Jika bukan trade (misal prompt sistem lain), biarkan berjalan normal
                return oldFunc(...)
            end)
            hookedCount = hookedCount + 1
        end
    end
    
    if hookedCount > 0 then
        sendLog("🔗 Hook Terpasang", "Berhasil memasang penahan di " .. tostring(hookedCount) .. " fungsi PromptController. Menunggu ada yang trade...", 3066993)
    else
        sendLog("⚠️ Warning", "PromptController ditemukan, tapi tidak memiliki fungsi standar (Prompt/Show).", 16711680)
    end
else
    sendLog("❌ Gagal", "PromptController tidak ditemukan via getloadedmodules(). Mungkin perlu metode getgc().", 16711680)
end
