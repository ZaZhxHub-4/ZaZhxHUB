-- =========================================================
-- SCRIPT DIAGNOSA INVENTORY & FILTER TRADEABILITY
-- =========================================================
-- (PASTIKAN ANDA SUDAH ME-REQUIRE PlayerData & ItemUtility DI ATAS SINI SEPERTI DI F4)

local ItemUtility    = require(SharedFolder:WaitForChild("ItemUtility", 9e9))
local Replion        = require(PackagesFolder:WaitForChild("Replion", 9e9))
local PlayerData     = Replion.Client:WaitReplion("Data")

local function DebugInventoryEkstrem()
    local inv = PlayerData:Get("Inventory")
    if type(inv) ~= "table" then return warn("❌ Inventory tidak terbaca sebagai table!") end
    
    print("\n\n=========================================================")
    print("🔍 MEMULAI DEBUG INVENTORY EKSTREM")
    print("=========================================================")
    
    for catName, catData in pairs(inv) do
        print("\n📁 KATEGORI: " .. tostring(catName) .. " | Jumlah raw item: " .. tostring(#catData))
        print("---------------------------------------------------------")
        
        local printedCount = 0
        -- Hanya ambil 3 item pertama dari tiap kategori sebagai sampel agar console tidak spam
        for i, item in pairs(catData) do
            if type(item) == "table" and printedCount < 3 then 
                
                -- 1. BACA STRUKTUR RAW ITEM DI INVENTORY
                local rawKeys = {}
                local itemId = item.Id or item.id or item.ItemId or "TIDAK_ADA_ID"
                for k, v in pairs(item) do
                    table.insert(rawKeys, tostring(k))
                end
                
                local statusTrade = "❓ STATUS_TIDAK_DIKETAHUI"
                local itemName = "NAMA_TIDAK_DIKETAHUI"
                local itemInfo = nil
                
                -- 2. BACA DATA DARI ITEM UTILITY
                if itemId ~= "TIDAK_ADA_ID" then
                    local ok, res = pcall(function() return ItemUtility:GetItemData(itemId) end)
                    if ok and res then
                        itemInfo = res
                        itemName = res.Name or itemName
                        
                        -- Evaluasi ulang Tradeability
                        local isLocked = res.TradeLocked
                        local isSoulbound = res.Soulbound
                        local canTrade = res.CanTrade
                        
                        if isLocked == true or isSoulbound == true or canTrade == false then
                            statusTrade = "❌ UNTRADEABLE"
                        else
                            statusTrade = "✅ TRADEABLE"
                        end
                    else
                        statusTrade = "⚠️ GAGAL BACA ITEM_UTILITY"
                    end
                else
                    statusTrade = "❌ ITEM TIDAK PUNYA ID (Format Beda!)"
                end
                
                print(string.format("  -> Item: %s | ID: %s | Status: %s", tostring(itemName), tostring(itemId), statusTrade))
                print("     [RAW KEYS]: " .. table.concat(rawKeys, ", "))
                
                -- 3. BONGKAR SEMUA PROPERTY (Untuk mencari tahu kenapa Ares/Starter Rod lolos)
                if itemInfo and printedCount == 0 then
                    local utilKeys = {}
                    for k, v in pairs(itemInfo) do
                        if type(v) == "boolean" or type(v) == "string" or type(v) == "number" then
                            table.insert(utilKeys, k .. "=" .. tostring(v))
                        end
                    end
                    print("     [UTILITY DATA]: " .. table.concat(utilKeys, " | "))
                end
                
                printedCount = printedCount + 1
            end
        end
    end
    print("=========================================================\n\n")
end

task.spawn(DebugInventoryEkstrem)
