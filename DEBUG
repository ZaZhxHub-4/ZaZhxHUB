_G.ForceBoothClaimed = false

local function checkBoothOwnership()
    if _G.ForceBoothClaimed then return true end
    pcall(function()
        local d  = PlayerData:Get("Booth")
        if type(d) == "table" and (d.Active == true or d.Claimed == true) then
            _G.ForceBoothClaimed = true
        end
        local d2 = PlayerData:Get("HasBooth")
        if d2 == true then _G.ForceBoothClaimed = true end
    end)
    if _G.ForceBoothClaimed then return true end
    local dn = lp.DisplayName or lp.Name
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.ActionText == "Edit Booth" then
            _G.ForceBoothClaimed = true; return true
        elseif (obj:IsA("TextLabel") or obj:IsA("TextButton")) and
               (obj.Text == dn .. "'s Booth" or obj.Text == lp.Name .. "'s Booth") then
            _G.ForceBoothClaimed = true; return true
        end
    end
    return false
end

local isClaiming = false
local function tryClaimBooth(statusCallback)
    if isClaiming then return end
    if checkBoothOwnership() then
        if statusCallback then statusCallback("sudah_booth") end; return
    end
    isClaiming = true
    if statusCallback then statusCallback("mulai") end
    local char = lp.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        isClaiming = false
        if statusCallback then statusCallback("error_char") end; return
    end
    local originalCF = hrp.CFrame
    local claimed    = false
    for _, cf in ipairs(BOOTH_CFRAMES) do
        safeTeleport(hrp, char, cf)
        task.wait(0.1)
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.ActionText == "Claim Booth" then
                local worldPos = nil
                if obj.Parent:IsA("Attachment") then
                    pcall(function() worldPos = obj.Parent.WorldPosition end)
                    if not worldPos and obj.Parent.Parent:IsA("BasePart") then
                        worldPos = obj.Parent.Parent.Position
                    end
                elseif obj.Parent:IsA("BasePart") then
                    worldPos = obj.Parent.Position
                end
                if worldPos and (worldPos - hrp.Position).Magnitude <= 20 then
                    local oldLoS  = obj.RequiresLineOfSight
                    local oldDist = obj.MaxActivationDistance
                    obj.RequiresLineOfSight   = false
                    obj.MaxActivationDistance = 99
                    pcall(function() fireproximityprompt(obj) end)
                    task.wait(1.5)
                    if checkBoothOwnership()
                    or not obj:IsDescendantOf(Workspace)
                    or not obj.Enabled
                    or obj.ActionText ~= "Claim Booth" then
                        claimed = true; _G.ForceBoothClaimed = true; break
                    end
                    pcall(function()
                        obj.RequiresLineOfSight   = oldLoS
                        obj.MaxActivationDistance = oldDist
                    end)
                end
            end
        end
        if claimed then break end
        stopNoclip(char)
        task.wait(0.1)
    end
    isClaiming = false
    stopNoclip(char)
    if claimed then
        lastClaimTime = tick()
        _G.ForceBoothClaimed = true
        if statusCallback then statusCallback("sukses") end
    else
        pcall(function() hrp.CFrame = originalCF end)
        if statusCallback then statusCallback("penuh") end
    end
end

