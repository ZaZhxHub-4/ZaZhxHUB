-- // ZHX Net Label Dumper — Lihat Semua Remote Terbaru
local RS = game:GetService("ReplicatedStorage")
local LP = game:GetService("Players").LocalPlayer

local net = RS.Packages._Index["sleitnick_net@0.2.0"].net
local labels = {}
for _, child in ipairs(net:GetChildren()) do
    table.insert(labels, child.Name)
end
table.sort(labels)

local allText = table.concat(labels, "\n")

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "NetDumpGUI"
gui.ResetOnSpawn = false
gui.Parent = LP:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(1, -20, 0.7, 0)
frame.Position = UDim2.new(0, 10, 0.15, 0)
frame.BackgroundColor3 = Color3.fromRGB(15,15,20)
frame.BackgroundTransparency = 0.1
frame.BorderSizePixel = 0
frame.ZIndex = 2000
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0,8)
Instance.new("UIStroke", frame).Color = Color3.fromRGB(72,210,130)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,30)
title.Position = UDim2.new(0,10,0,5)
title.BackgroundTransparency = 1
title.Text = "Net Labels (" .. #labels .. " item)  |  Tap teks untuk copy"
title.TextColor3 = Color3.fromRGB(255,255,100)
title.TextSize = 12
title.Font = Enum.Font.GothamBold
title.ZIndex = 2001
title.Parent = frame

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1,-10,1,-45)
scroll.Position = UDim2.new(0,5,0,35)
scroll.BackgroundColor3 = Color3.fromRGB(20,20,25)
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 6
scroll.ScrollBarImageColor3 = Color3.fromRGB(72,210,130)
scroll.CanvasSize = UDim2.new(0,0,0, #labels * 18 + 10)
scroll.ZIndex = 2001
scroll.Parent = frame
Instance.new("UICorner", scroll).CornerRadius = UDim.new(0,6)

local textBtn = Instance.new("TextButton")
textBtn.Size = UDim2.new(1,0,0, #labels * 18)
textBtn.Position = UDim2.new(0,0,0,0)
textBtn.BackgroundTransparency = 1
textBtn.Text = allText
textBtn.TextColor3 = Color3.fromRGB(200,200,200)
textBtn.TextSize = 11
textBtn.Font = Enum.Font.Code
textBtn.TextXAlignment = Enum.TextXAlignment.Left
textBtn.TextYAlignment = Enum.TextYAlignment.Top
textBtn.AutoButtonColor = false
textBtn.ZIndex = 2002
textBtn.Parent = scroll

textBtn.MouseButton1Click:Connect(function()
    pcall(function()
        if setclipboard then setclipboard(allText)
        elseif syn and syn.set_clipboard then syn.set_clipboard(allText)
        elseif writefile then writefile("ZHX_NetLabels.txt", allText) end
    end)
    title.Text = "✅ Tersalin! (" .. #labels .. " label)  |  Tap lagi untuk copy ulang"
    task.delay(2, function()
        title.Text = "Net Labels (" .. #labels .. " item)  |  Tap teks untuk copy"
    end)
end)

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0,50,0,24)
closeBtn.Position = UDim2.new(1,-55,0,8)
closeBtn.BackgroundColor3 = Color3.fromRGB(80,20,20)
closeBtn.BorderSizePixel = 0
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
closeBtn.TextSize = 14
closeBtn.Font = Enum.Font.GothamBold
closeBtn.ZIndex = 2001
closeBtn.AutoButtonColor = false
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0,5)
closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

print("Net Label Dumper siap. Tap teks untuk copy.")
