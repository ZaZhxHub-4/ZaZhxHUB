    hapusBtn.MouseButton1Click:Connect(function()
        if autoOn then notify("Matikan Auto Booth dulu!"); return end
        if not muatDone then notify("Muat item dulu!"); return end
        local now=tick(); if now-lastDeleteTime<3 then notify("Tunggu sebentar."); return end
        if isDeleting then notify("Sedang menghapus..."); return end
        if not capturedDeleteRF then capturedDeleteRF=findRealDeleteRF() end
        if not capturedDeleteRF then notify("Coba pindah server."); return end
        lastDeleteTime=now; isDeleting=true; notify("Menghapus semua listing...")
        task.spawn(function()
            local saleData=nil; pcall(function() saleData=PlayerData:Get("SaleListings") end)
            local boothListings=saleData and saleData.Booth
            if not boothListings or next(boothListings)==nil then isDeleting=false; notify("Tidak ada item di booth."); return end
            local deleted,failed=0,0
            for listingKey,_ in pairs(boothListings) do
                task.wait(0.4)
                local ok=pcall(function() capturedDeleteRF:InvokeServer("Booth",listingKey) end)
                if ok then deleted=deleted+1 else failed=failed+1 end
            end
            for i=1,MAX_SLOTS do slotData[i].listedUUID=nil end
            for m=1,MAX_MULTI do multiSlotData[m].listedUUID=nil end
            isDeleting=false; updateAllUIStatus()
            if deleted>0 and failed==0 then notify("✅ "..deleted.." item dihapus.")
            elseif deleted>0 then notify("⚠ "..deleted.." berhasil, "..failed.." gagal.")
            else notify("❌ Tidak ada yang terhapus.") end
        end)
    end)
    return content
end

