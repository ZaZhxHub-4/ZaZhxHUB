-- ========== DATA COLLECTION TABLES ==========
local captured_loadstrings = {}
local captured_prints = {}
local ui_calls = {}
local global_vars = {}
local gc_funcs = {}
local remote_calls = {}
local gui_objects = {}

-- ========== HOOKS (harus sebelum target script di-load) ==========
-- Hook loadstring
local old_loadstring = loadstring
loadstring = function(code, chunkname)
    table.insert(captured_loadstrings, {chunk = chunkname or "?", code = code})
    return old_loadstring(code, chunkname)
end

-- Hook print
local old_print = print
print = function(...)
    local args = {...}
    table.insert(captured_prints, table.concat(args, " "))
    old_print(...)
end

-- Hook UI library (generic)
local ui_patterns = {"MakeWindow", "CreateWindow", "AddButton", "AddToggle", "AddSlider", "AddLabel", "AddTab", "NewWindow"}
for _, name in ipairs(ui_patterns) do
    if _G[name] and type(_G[name]) == "function" then
        local old = _G[name]
        _G[name] = function(...)
            table.insert(ui_calls, {func = name, args = {...}})
            return old(...)
        end
    end
end

-- Hook RemoteEvent/Function
local mt = getrawmetatable(game)
if mt and mt.__namecall then
    local old_namecall = mt.__namecall
    mt.__namecall = function(self, ...)
        local method = getnamecallmethod()
        if (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) and (method == "FireServer" or method == "InvokeServer") then
            table.insert(remote_calls, {remote = self.Name, method = method, args = {...}})
        end
        return old_namecall(self, ...)
    end
end

-- ========== LOAD TARGET SCRIPT ==========
local function load_target()
    local raw = game:HttpGet(TARGET_URL)
    local fn, err = loadstring(raw)
    if fn then
        pcall(fn)
        return true
    else
        table.insert(captured_prints, "LOAD ERROR: " .. tostring(err))
        return false
    end
end

load_target()
task.wait(4)  -- beri waktu inisialisasi

-- ========== POST-EXTRACTION DATA DUMP ==========
-- Dump _G
for k, v in pairs(_G) do
    if type(v) == "function" then
        global_vars[tostring(k)] = "<function>"
    elseif type(v) == "table" then
        global_vars[tostring(k)] = "<table>"
    else
        global_vars[tostring(k)] = tostring(v)
    end
end

-- Dump getgc
for _, func in ipairs(getgc(true)) do
    if type(func) == "function" then
        local info = debug.getinfo(func, "S")
        if info and info.source and (string.find(info.source, "Fish") or string.find(info.source, "Lynx") or string.find(info.source, "@")) then
            local constants = debug.getconstants and debug.getconstants(func) or {}
            local const_strings = {}
            for _, c in ipairs(constants) do
                if type(c) == "string" and #c > 3 then
                    table.insert(const_strings, c)
                end
            end
            if #const_strings > 0 then
                table.insert(gc_funcs, {src = info.source, consts = const_strings})
            end
        end
    end
end

-- Dump PlayerGui
local function scan_gui(parent, path)
    path = path or parent.Name
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("ScreenGui") or child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel") then
            local props = {}
            for _, prop in ipairs(child:GetProperties()) do
                if prop:match("Text") or prop:match("Visible") or prop:match("Position") or prop:match("Size") then
                    props[prop] = tostring(child[prop])
                end
            end
            table.insert(gui_objects, {name = child.Name, class = child.ClassName, path = path.."."..child.Name, props = props})
            scan_gui(child, path.."."..child.Name)
        end
    end
end
pcall(scan_gui, Players.LocalPlayer.PlayerGui)

-- ========== FORMAT OUTPUT ==========
local function build_full_report()
    local parts = {}
    
    parts[#parts+1] = "=== LOADSTRINGS ==="
    for i, ls in ipairs(captured_loadstrings) do
        parts[#parts+1] = string.format("-- [%d] %s\n%s\n", i, ls.chunk, ls.code)
    end
    
    parts[#parts+1] = "\n=== UI CALLS ==="
    for _, ui in ipairs(ui_calls) do
        parts[#parts+1] = string.format("%s(%s)", ui.func, HttpService:JSONEncode(ui.args))
    end
    
    parts[#parts+1] = "\n=== GLOBAL VARIABLES ==="
    for k, v in pairs(global_vars) do
        parts[#parts+1] = k .. " = " .. v
    end
    
    parts[#parts+1] = "\n=== GC FUNCTIONS (strings) ==="
    for _, f in ipairs(gc_funcs) do
        parts[#parts+1] = "-- " .. f.src
        for _, s in ipairs(f.consts) do
            parts[#parts+1] = "const: " .. s
        end
    end
    
    parts[#parts+1] = "\n=== REMOTE CALLS ==="
    for _, rc in ipairs(remote_calls) do
        parts[#parts+1] = string.format("%s:%s(%s)", rc.remote, rc.method, HttpService:JSONEncode(rc.args))
    end
    
    parts[#parts+1] = "\n=== GUI STRUCTURE ==="
    for _, g in ipairs(gui_objects) do
        parts[#parts+1] = g.path .. " (" .. g.class .. ")"
        for k, v in pairs(g.props) do
            parts[#parts+1] = "  " .. k .. " = " .. v
        end
    end
    
    parts[#parts+1] = "\n=== PRINT OUTPUTS ==="
    parts[#parts+1] = table.concat(captured_prints, "\n")
    
    return table.concat(parts, "\n")
end

local report = build_full_report()
local timestamp = os.time()

-- ========== SEND TO DISCORD (dengan fallback) ==========
local function send_to_discord(content)
    local json_body = HttpService:JSONEncode({content = content:sub(1, 1990)})
    local success = false
    
    if syn and syn.request then
        success = pcall(function()
            syn.request({Url = WEBHOOK, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = json_body})
        end)
    elseif http_request then
        success = pcall(function()
            http_request({Url = WEBHOOK, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = json_body})
        end)
    elseif HttpService.PostAsync then
        success = pcall(function()
            HttpService:PostAsync(WEBHOOK, json_body, Enum.HttpContentType.ApplicationJson)
        end)
    end
    
    return success
end

local function split_and_send()
    local max_len = 1900
    if #report <= max_len then
        send_to_discord(report)
    else
        for i = 1, #report, max_len do
            local part = report:sub(i, i+max_len-1)
            send_to_discord(part)
            task.wait(1)
        end
    end
end

local sent = split_and_send()

