-- // DEEP PET MODULE EXPLORER: Require & Eksplorasi Fungsi Internal
-- // Mencari fungsi Start/End Fishing, Cooldown, dll di dalam modul Pets
-- // Kirim hasil ke Discord

local webhook = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"
local HS = game:GetService("HttpService")
local RS = game:GetService("ReplicatedStorage")

local function send(msg)
    pcall(function()
        local body = HS:JSONEncode({content = "`" .. os.date("%H:%M:%S") .. "` " .. msg:sub(1, 1900)})
        if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif syn and syn.request then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        else request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body}) end
    end)
end

send("🔍 Memulai eksplorasi mendalam modul Pets...")

-- Cari modul Pets (ModuleScript) di ReplicatedStorage
local petsModule = RS:FindFirstChild("Pets")
if not petsModule then
    send("❌ ModuleScript 'Pets' tidak ditemukan di ReplicatedStorage.")
    return
end

send("📦 ModuleScript Pets ditemukan. Mencoba require...")

local petsEnv, requireSuccess
requireSuccess = pcall(function()
    petsEnv = require(petsModule)
end)

if not requireSuccess or not petsEnv then
    send("⚠️ Gagal require modul Pets. Mencoba metode alternatif...")
    -- Coba ambil environment dari module yang sudah di-load
    for _, mod in ipairs(getloadedmodules()) do
        if mod.Name == "Pets" then
            petsEnv = getsenv(mod)
            if petsEnv then
                send("✅ getsenv berhasil setelah mencari di loaded modules.")
                break
            end
        end
    end
    if not petsEnv then
        send("❌ Tidak bisa mendapatkan environment Pets.")
        return
    end
end

send("📋 Mengeksplorasi isi modul Pets...")
local keys = {}
local functionTypes = {}
for k, v in pairs(petsEnv) do
    local t = type(v)
    table.insert(keys, tostring(k) .. ":" .. t)
    if t == "function" then
        table.insert(functionTypes, k)
    end
end

-- Kirim daftar semua key (dibatasi panjang)
local allKeys = table.concat(keys, ", ")
if #allKeys > 1800 then
    send("Keys (parsial): " .. allKeys:sub(1, 1800))
else
    send("Keys: " .. allKeys)
end

-- Fokus pada fungsi-fungsi
send("Fungsi ditemukan (" .. #functionTypes .. "): " .. table.concat(functionTypes, ", "))

-- Cari fungsi yang mencurigakan
local suspicious = {}
for _, fname in ipairs(functionTypes) do
    local lower = fname:lower()
    if lower:find("fish") or lower:find("start") or lower:find("end") or lower:find("finish") or
       lower:find("catch") or lower:find("cooldown") or lower:find("reel") or lower:find("cast") or
       lower:find("complete") or lower:find("update") or lower:find("timer") then
        table.insert(suspicious, fname)
    end
end

if #suspicious > 0 then
    send("🎯 Fungsi mencurigakan: " .. table.concat(suspicious, ", "))
    -- Coba lihat upvalues dari fungsi mencurigakan pertama
    for _, fname in ipairs(suspicious) do
        local func = petsEnv[fname]
        if type(func) == "function" then
            local upvalues = {}
            pcall(function()
                local i = 1
                while true do
                    local name, val = debug.getupvalue(func, i)
                    if not name then break end
                    upvalues[#upvalues+1] = name .. "=" .. tostring(val):sub(1, 50)
                    i = i + 1
                end
            end)
            if #upvalues > 0 then
                send("📎 Upvalues " .. fname .. ": " .. table.concat(upvalues, "; "))
            end
        end
    end
else
    send("⚠️ Tidak ada fungsi mencurigakan. Coba cari table yang mungkin berisi fungsi...")
    -- Cari table
    for k, v in pairs(petsEnv) do
        if type(v) == "table" then
            local subKeys = {}
            for sk, sv in pairs(v) do
                subKeys[#subKeys+1] = tostring(sk) .. ":" .. type(sv)
            end
            send("📁 Table " .. tostring(k) .. ": " .. table.concat(subKeys, ", "):sub(1, 1800))
        end
    end
end

send("✅ Eksplorasi selesai.")
