        CopyBtn.Text = "❌ EKSEKUTOR TIDAK SUPPORT AUTO COPY"
        CopyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        task.wait(2)
        CopyBtn.Text = "📋 TAHAN TEKS DI ATAS UNTUK COPY MANUAL"
        CopyBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 100)
    end
end)
