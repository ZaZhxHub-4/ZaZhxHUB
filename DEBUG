local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local WEBHOOK_URL = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"
local httpRequest = (syn and syn.request) or request or http_request or (http and http.request)

if not httpRequest then
    warn("Executor kamu tidak mendukung HTTP Requests!")
    return
end

-- Fungsi aman untuk mengirim pesan panjang ke Discord
local function sendToDiscord(content)
    pcall(function()
        httpRequest({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                username = "ZHX Scanner",
                content = content
            })
        })
    end)
end

-- =====================
-- MEMBUAT MINI UI DEBUG
-- =====================
local sg = Instance.new("ScreenGui")
sg.Name = "ZHX_MemoryScannerWeb"
sg.ResetOnSpawn = false
pcall(function() sg.Parent = CoreGui end)
if not sg.Parent then sg.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui") end

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 250, 0, 50)
btn.Position = UDim2.new(0.5, -125, 0, 20)
btn.BackgroundColor3 = Color3.fromRGB(50, 50, 200)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 12
btn.Text = "🔍 SCAN MEMORY KE DISCORD"
btn.Parent = sg
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

btn.MouseButton1Click:Connect(function()
    btn.Text = "MENCARI... (AWAS NGE-LAG BENTAR)"
    btn.BackgroundColor3 = Color3.fromRGB(200, 150, 50)
    task.wait(0.1)

    sendToDiscord("⏳ **Memulai proses scan memori (GetGC)...**")

    local foundTables = 0
    local gc = getgc(true)
    
    for i, v in pairs(gc) do
        if type(v) == "table" then
            local hasRemote = false
            local hasStringKey = false
            
            pcall(function()
                for key, val in pairs(v) do
                    if type(key) == "string" and typeof(val) == "Instance" then
                        if val:IsA("RemoteEvent") or val:IsA("RemoteFunction") then
                            hasRemote = true
                            hasStringKey = true
                            break
                        end
                    end
                end
            end)

            if hasRemote and hasStringKey then
                foundTables = foundTables + 1
                
                -- Menyusun pesan agar rapi dan tidak lewat batas karakter Discord
                local chunk = "🔍 **TABEL KANDIDAT #" .. foundTables .. "** Ditemukan!\n```lua\n"
                
                for key, val in pairs(v) do
                    if type(key) == "string" and typeof(val) == "Instance" then
                        if val:IsA("RemoteEvent") or val:IsA("RemoteFunction") then
                            local line = "Kunci: [" .. key .. "] ---> " .. val.ClassName .. " (" .. val.Name .. ")\n"
                            
                            -- Jika chunk sudah mendekati batas Discord (2000 max, kita set 1800 agar aman)
                            if #chunk + #line > 1800 then
                                chunk = chunk .. "
```"
                                sendToDiscord(chunk)
                                task.wait(1) -- Jeda 1 detik anti rate-limit Discord
                                chunk = "```lua\n" -- Buka blok kode baru
                            end
                            chunk = chunk .. line
                        end
                    end
                end
                
                chunk = chunk .. "
```"
                sendToDiscord(chunk)
                task.wait(1.5)
            end
        end
    end

    btn.Text = "✅ SELESAI! CEK DISCORD"
    btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    sendToDiscord("✅ **SCAN SELESAI.** Total tabel mencurigakan yang ditemukan: **" .. foundTables .. "**")
    
    task.delay(4, function() sg:Destroy() end)
end)
