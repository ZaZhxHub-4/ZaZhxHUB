local RS = game:GetService("ReplicatedStorage")
local HS = game:GetService("HttpService")

local function sendWebhook(msg)
    pcall(function()
        request({
            Url = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HS:JSONEncode({content = msg})
        })
    end)
end

local targetModules = {"BoothShopController", "TradeBoothController", "Booth", "BoothShop", "TradeBoothController"}

for _, m in ipairs(getloadedmodules()) do
    for _, target in ipairs(targetModules) do
        if m.Name == target then
            local ok, mod = pcall(require, m)
            if ok and type(mod) == "table" then
                for k, v in pairs(mod) do
                    if type(v) == "function" then
                        local orig = v
                        local modName = m.Name
                        local funcName = k
                        mod[k] = function(...)
                            sendWebhook("CALLED: "..modName.."."..funcName)
                            return orig(...)
                        end
                    end
                end
                sendWebhook("Hooked: "..m.Name)
            end
            break
        end
    end
end

sendWebhook("Semua hook siap. Buka Edit Booth, pilih item, tekan Sell.")
