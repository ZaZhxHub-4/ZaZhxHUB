-- // ZHX Auto Event - Phase 11: Walk, Lock & Safe Return Test
-- // Menggunakan fungsi safeWalk yang sama seperti di Safe Walk utama
-- // Saat kembali, interpolasi CFrame + anchored di akhir, tidak jatuh

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local WS = game:GetService("Workspace")
local LP = Players.LocalPlayer

-- ========== STATE ==========
local savedPosition = nil
local isLocked = false

-- ========== NOKLIP AGRESIF ==========
local noclipConn = nil
local function enableNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        local char = LP.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanCollide = false end)
            end
        end
    end)
end
local function disableNoclip()
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
end

-- ========== DAMAGE PROTECTION ==========
local function protectCharacter()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.MaxHealth = 1e9; hum.Health = 1e9 end)
        hum.PlatformStand = true
    end
end
local function unprotectCharacter()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.MaxHealth = 100; hum.Health = 100 end)
        hum.PlatformStand = false
    end
end

-- ========== SAFE WALK (FULL INTERPOLASI + ANCHORED DI AKHIR) ==========
local function safeWalk(targetCF)
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    enableNoclip()
    protectCharacter()

    local startCF = root.CFrame
    local distance = (targetCF.Position - startCF.Position).Magnitude
    local stepSize = 2.5
    local steps = math.max(1, math.ceil(distance / stepSize))

    for i = 1, steps do
        local t = i / steps
        local newCF = startCF:Lerp(targetCF, t)
        pcall(function()
            root.CFrame = newCF
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
        end)
        task.wait(0.03 * (0.9 + math.random() * 0.2))
    end

    -- Anchored di akhir agar tidak jatuh
    pcall(function()
        root.Anchored = true
        root.CFrame = targetCF
        root.Velocity = Vector3.zero
        root.RotVelocity = Vector3.zero
        task.wait(0.5) -- beri waktu agar stabil
        root.Anchored = false
    end)

    unprotectCharacter()
    disableNoclip()
end

-- ========== FUNGSI CARI MODEL EVENT ==========
local function findEventModel(eventName)
    local propsFolder = WS:FindFirstChild("Props")
    if not propsFolder then return nil end
    for _, child in ipairs(propsFolder:GetChildren()) do
        if child.Name == eventName and child:IsA("Model") then
            return child
        end
    end
    return nil
end

-- ========== FUNGSI DAPATKAN POSISI EVENT ==========
local function getEventPosition(model)
    if not model then return nil end
    for _, child in ipairs(model:GetDescendants()) do
        if child.Name == model.Name and child:IsA("BasePart") then
            return child.Position
        end
    end
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("BasePart") then
            return child.Position
        end
    end
    return nil
end

-- ========== SIMPAN POSISI SAAT INI ==========
local function saveCurrentPosition()
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    savedPosition = root.CFrame
end

-- ========== LOCK USER ==========
local function lockUser()
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.Anchored = true
    isLocked = true
end

-- ========== UNLOCK USER ==========
local function unlockUser()
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.Anchored = false
    isLocked = false
end

