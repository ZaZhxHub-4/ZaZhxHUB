local function isItemTradeLocked(itemData)
    if not itemData then return true end
    if itemData.TradeLocked == true or itemData.Unsellable == true or itemData.IsStarter == true or itemData.Soulbound == true or itemData.CanTrade == false then return true end
    if itemData.Data and itemData.Data.TradeLocked == true then return true end
    return false
end

local function getInventorySnapshot()
    local inv = PlayerData:Get("Inventory"); if not inv then return {} end
    local t = {}
    for catName, catData in pairs(inv) do
        if type(catData) == "table" then
            local firstVal = catData[1]
            if type(firstVal) == "table" and firstVal.Id and firstVal.UUID then
                for _, item in ipairs(catData) do t[item.UUID] = item.Id end
            else
                for _, subItem in pairs(catData) do
                    if type(subItem) == "table" and subItem.Id and subItem.UUID then t[subItem.UUID] = subItem.Id end
                end
            end
        end
    end
    return t
end

local function getUUIDsForItemId(itemId, categoryReq)
    local inv = PlayerData:Get("Inventory"); if not inv then return {} end
    local uuids = {}
    local function checkAndAdd(item, catName)
        if type(item) == "table" and item.Id == itemId and item.UUID then
            if not categoryReq or catName == categoryReq then table.insert(uuids, item.UUID) end
        end
    end
    for catName, catData in pairs(inv) do
        if (not categoryReq or catName == categoryReq) and type(catData) == "table" then
            local firstVal = catData[1]
            if type(firstVal) == "table" and firstVal.Id and firstVal.UUID then
                for _, item in ipairs(catData) do checkAndAdd(item, catName) end
            else
                for _, subItem in pairs(catData) do checkAndAdd(subItem, catName) end
            end
        end
    end
    return uuids
end

local function getInventoryItemListFull()
    local inv = PlayerData:Get("Inventory"); if not inv then return {} end
    local items, seen = {}, {}
    local function processItem(item, catName)
        if type(item) == "table" and item.Id and item.UUID then
            local id = item.Id; local uniqueKey = catName .. "_" .. tostring(id)
            if not seen[uniqueKey] then
                local data = fetchItemData(catName, id)
                if data and not isItemTradeLocked(data) then
                    local name = data.Name or (data.Data and data.Data.Name) or (catName .. " ID " .. tostring(id))
                    table.insert(items, { name = name, itemId = id, category = catName, count = #getUUIDsForItemId(id, catName) })
                    seen[uniqueKey] = true
                end
            end
        end
    end
    for catName, catData in pairs(inv) do
        if type(catData) == "table" then
            local firstVal = catData[1]
            if type(firstVal) == "table" and firstVal.Id and firstVal.UUID then
                for _, item in ipairs(catData) do processItem(item, catName) end
            else
                for _, subItem in pairs(catData) do processItem(subItem, catName) end
            end
        end
    end
    local catOrder = {}
    for i, cat in ipairs(CATEGORY_ORDER) do catOrder[cat] = i end
    table.sort(items, function(a, b)
        local oa = catOrder[a.category] or 99; local ob = catOrder[b.category] or 99
        if oa ~= ob then return oa < ob end
        return a.name < b.name
    end)
    return items
end

