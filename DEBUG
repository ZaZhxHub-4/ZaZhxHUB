-- Script ekstraksi LYNX Fish It (Luraph v14.7)
-- Hasil akan disimpan ke file "extract_lynx.txt" di folder executor

local target_url = "https://raw.githubusercontent.com/4LynxX/all_Game/refs/heads/main/Fish_It.lua"
local output_file = "extract_lynx.txt"

-- Data collection
local captured = {
    loadstrings = {},
    prints = {},
    ui_calls = {},
    globals = {},
    remotes = {},
    gui = {}
}

-- Hook loadstring
local old_loadstring = loadstring
loadstring = function(code, chunkname)
    table.insert(captured.loadstrings, {chunk = chunkname or "?", code = code})
    return old_loadstring(code, chunkname)
end

-- Hook print
local old_print = print
print = function(...)
    local args = {...}
    table.insert(captured.prints, table.concat(args, " "))
    old_print(...)
end

-- Hook UI libraries (generic)
local ui_funcs = {"MakeWindow", "CreateWindow", "AddButton", "AddToggle", "AddSlider", "AddLabel", "AddTab", "NewWindow"}
for _, name in ipairs(ui_funcs) do
    if _G[name] and type(_G[name]) == "function" then
        local old = _G[name]
        _G[name] = function(...)
            table.insert(captured.ui_calls, {func = name, args = {...}})
            return old(...)
        end
    end
end

-- Hook remote events
local mt = getrawmetatable(game)
if mt and mt.__namecall then
    local old_nc = mt.__namecall
    mt.__namecall = function(self, ...)
        local method = getnamecallmethod()
        if (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) and (method == "FireServer" or method == "InvokeServer") then
            table.insert(captured.remotes, {remote = self.Name, method = method, args = {...}})
        end
        return old_nc(self, ...)
    end
end

-- Load target script
local function load_target()
    local raw = game:HttpGet(target_url)
    local fn, err = loadstring(raw)
    if fn then
        pcall(fn)
        return true
    else
        table.insert(captured.prints, "ERROR loading target: " .. tostring(err))
        return false
    end
end

print("Memuat script target...")
load_target()
task.wait(5)  -- beri waktu inisialisasi

-- Dump _G
for k, v in pairs(_G) do
    if type(v) == "function" then
        captured.globals[tostring(k)] = "<function>"
    elseif type(v) == "table" then
        captured.globals[tostring(k)] = "表"
    else
        captured.globals[tostring(k)] = tostring(v)
    end
end

-- Dump getgc
for _, func in ipairs(getgc(true)) do
    if type(func) == "function" then
        local info = debug.getinfo(func, "S")
        if info and info.source and (string.find(info.source, "Fish") or string.find(info.source, "Lynx")) then
            local constants = debug.getconstants and debug.getconstants(func) or {}
            for _, c in ipairs(constants) do
                if type(c) == "string" and #c > 10 then
                    table.insert(captured.prints, "[GC CONST] " .. c)
                end
            end
        end
    end
end

-- Dump PlayerGui
local function scan_gui(inst, path)
    path = path or inst.Name
    for _, child in ipairs(inst:GetChildren()) do
        if child:IsA("ScreenGui") or child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel") then
            local props = {}
            for _, prop in ipairs(child:GetProperties()) do
                if prop:match("Text") or prop:match("Visible") or prop:match("Position") then
                    props[prop] = tostring(child[prop])
                end
            end
            table.insert(captured.gui, {name = child.Name, class = child.ClassName, path = path .. "." .. child.Name, props = props})
            scan_gui(child, path .. "." .. child.Name)
        end
    end
end
pcall(scan_gui, game.Players.LocalPlayer.PlayerGui)

-- Build report
local function build_report()
    local lines = {}
    lines[#lines+1] = "=== LYNX FISH IT EXTRACTION ==="
    lines[#lines+1] = "Time: " .. os.date()
    lines[#lines+1] = ""
    
    lines[#lines+1] = "=== LOADSTRINGS (" .. #captured.loadstrings .. ") ==="
    for i, ls in ipairs(captured.loadstrings) do
        lines[#lines+1] = string.format("-- [%d] %s\n%s\n", i, ls.chunk, ls.code)
    end
    
    lines[#lines+1] = "\n=== UI CALLS (" .. #captured.ui_calls .. ") ==="
    for _, ui in ipairs(captured.ui_calls) do
        lines[#lines+1] = string.format("%s(%s)", ui.func, game:GetService("HttpService"):JSONEncode(ui.args))
    end
    
    lines[#lines+1] = "\n=== GLOBAL VARIABLES ==="
    for k, v in pairs(captured.globals) do
        lines[#lines+1] = k .. " = " .. v
    end
    
    lines[#lines+1] = "\n=== REMOTE CALLS (" .. #captured.remotes .. ") ==="
    for _, rc in ipairs(captured.remotes) do
        lines[#lines+1] = string.format("%s:%s(%s)", rc.remote, rc.method, game:GetService("HttpService"):JSONEncode(rc.args))
    end
    
    lines[#lines+1] = "\n=== GUI STRUCTURE ==="
    for _, g in ipairs(captured.gui) do
        lines[#lines+1] = g.path .. " (" .. g.class .. ")"
        for k, v in pairs(g.props) do
            lines[#lines+1] = "  " .. k .. " = " .. v
        end
    end
    
    lines[#lines+1] = "\n=== PRINT OUTPUTS ==="
    lines[#lines+1] = table.concat(captured.prints, "\n")
    
    return table.concat(lines, "\n")
end

local report = build_report()

-- Save to file
local success, err = pcall(function()
    if writefile then
        writefile(output_file, report)
        print("SUKSES! Data tersimpan di file: " .. output_file)
    else
        -- Fallback: print to console (bisa dilihat di output executor)
        print("===== EKSTRAKSI LYNX =====")
        print(report)
        print("===== SELESAI =====")
    end
end)

if not success then
    print("Gagal menyimpan file. Error: " .. tostring(err))
    print("Data:\n" .. report:sub(1, 1000))
end

print("Script ekstraksi selesai.")
