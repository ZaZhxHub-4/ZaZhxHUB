local HttpService = game:GetService("HttpService")
local WebhookURL = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"

-- Global Toggle (Nanti ini yang akan disambungkan ke Toggle UI di script utama)
getgenv().AutoRejectTrade = true 

local function sendLog(title, desc, color)
    pcall(function()
        request({
            Url = WebhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                username = "🛡️ Trade Blocker",
                embeds = {{
                    title = title,
                    description = desc,
                    color = color or 16711680, -- Merah
                    footer = {text = "Fish It Auto Reject • " .. os.date("%H:%M:%S")}
                }}
            })
        })
    end)
end

local PromptController = nil

-- Mencari PromptController
for _, module in pairs(getloadedmodules()) do
    if module.Name == "PromptController" then
        local success, result = pcall(require, module)
        if success then
            PromptController = result
            break
        end
    end
end

if PromptController and type(PromptController.Prompt) == "function" then
    local oldPrompt
    oldPrompt = hookfunction(PromptController.Prompt, function(...)
        local args = {...}
        
        -- Cek apakah argumen pertama adalah table (sesuai log discord)
        if getgenv().AutoRejectTrade and type(args[1]) == "table" then
            local promptData = args[1]
            
            -- Validasi apakah ini benar-benar Trade Request
            if promptData.Title == "Trade Request" or (promptData.Text and string.find(string.lower(promptData.Text), "trade")) then
                
                -- Eksekusi fungsi Decline() ke server agar kita tidak nyangkut dalam status "Trading"
                if type(promptData.Decline) == "function" then
                    task.spawn(function()
                        pcall(promptData.Decline)
                    end)
                end
                
                -- Kirim log ke Discord
                sendLog("⛔ TRADE DITOLAK OTOMATIS", "Seseorang mencoba mengajak trade:\n**" .. tostring(promptData.Text) .. "**\n\n*Trade berhasil dibatalkan dari server dan UI disembunyikan.*", 16711680)
                
                -- Return nil untuk mencegat UI agar tidak di-render di layar
                return nil
            end
        end
        
        -- Jika bukan Trade Request (misal prompt disconnect/notifikasi lain) atau fitur mati, biarkan jalan normal
        return oldPrompt(...)
    end)
    
    sendLog("✅ Auto Reject Trade Aktif", "Sistem berhasil dipasang. Menunggu ada yang request trade...", 3066993)
else
    sendLog("❌ Gagal Memuat", "PromptController tidak valid.", 16711680)
end
