-- Keyword filter — hanya tangkap yang relevan dengan equip/gear/item/hotbar
-- Kosongkan table ini untuk tangkap SEMUA (lebih banyak noise)
local FILTER_KEYWORDS = {
    "equip", "gear", "diving", "item", "hotbar", "wear",
    "oxygen", "tank", "tool", "use", "consume", "activate"
}

local function matchesFilter(name, argStr)
    if #FILTER_KEYWORDS == 0 then return true end
    local combined = (name..argStr):lower()
    for _, kw in ipairs(FILTER_KEYWORDS) do
        if combined:find(kw, 1, true) then return true end
    end
    return false
end

-- ─── hookmetamethod __namecall — tangkap FireServer & InvokeServer ───
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if monitoring and (method == "FireServer" or method == "InvokeServer" or method == "Fire") then
        local args    = {...}
        local argStr  = ""
        pcall(function() argStr = HS:JSONEncode(args):sub(1, 300) end)
        local name    = ""
        pcall(function() name = tostring(self.Name) end)
        local path    = ""
        pcall(function() path = tostring(self:GetFullName()) end)

        -- Filter noise GameAnalytics dan sejenisnya
        if name ~= "GameAnalyticsError" and name ~= "GameAnalyticsInit"
        and not name:find("Analytics") and not name:find("Heartbeat") then
            logCount = logCount + 1
            table.insert(firedLog, {
                method = method,
                name   = name,
                path   = path,
                args   = argStr,
                t      = os.date("%H:%M:%S")
            })
        end
    end
    return oldNamecall(self, ...)
end)

