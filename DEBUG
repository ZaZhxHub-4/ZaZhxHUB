local global_vars = {}
local gc_functions = {}
local remote_calls = {}
local gui_structure = {}

-- Hook loadstring
local old_loadstring = loadstring
loadstring = function(code, chunkname)
    table.insert(captured_loadstrings, { chunk = chunkname, code = code })
    return old_loadstring(code, chunkname)
end

-- Hook print
local old_print = print
print = function(...)
    local args = {...}
    local str = table.concat(args, " ")
    table.insert(captured_prints, str)
    old_print(...)
end

-- Hook UI library (deteksi otomatis)
local ui_libs = {"MakeWindow", "CreateWindow", "AddButton", "AddToggle", "AddSlider", "AddLabel", "AddTab", "NewWindow"}
for _, lib in ipairs(ui_libs) do
    if _G[lib] and type(_G[lib]) == "function" then
        local old = _G[lib]
        _G[lib] = function(...)
            local args = {...}
            table.insert(ui_elements, { func = lib, args = args })
            return old(...)
        end
    end
end

-- Hook RemoteEvent / RemoteFunction (global untuk semua instance)
local old_namecall = nil
local mt = getrawmetatable(game)
if mt and mt.__namecall then
    old_namecall = mt.__namecall
    mt.__namecall = function(self, ...)
        local method = getnamecallmethod()
        if (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) and (method == "FireServer" or method == "InvokeServer") then
            local args = {...}
            table.insert(remote_calls, { remote = self.Name, method = method, args = args })
        end
        return old_namecall(self, ...)
    end
end

-- Load script target
local function load_target_script()
    local raw = game:HttpGet(TARGET_SCRIPT_URL)
    local fn, err = loadstring(raw)
    if fn then
        pcall(fn)
    else
        send_to_discord("Gagal load script: " .. tostring(err), "")
    end
end

