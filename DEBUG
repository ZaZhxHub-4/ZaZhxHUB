-- Dump getgc (fungsi dari script target)
local function is_target_function(func)
    local info = debug.getinfo(func, "S")
    return info and info.source and (string.find(info.source, "Fish_It") or string.find(info.source, "Lynx"))
end

for _, func in ipairs(getgc(true)) do
    if type(func) == "function" and is_target_function(func) then
        local info = debug.getinfo(func, "Sln")
        local constants = debug.getconstants and debug.getconstants(func) or {}
        table.insert(gc_functions, {
            source = info.source,
            lines = info.linedefined .. "-" .. info.lastlinedefined,
            constants = constants
        })
    end
end

-- Dump GUI (PlayerGui)
local function scan_gui(instance, depth, path)
    depth = depth or 0
    path = path or instance.Name
    for _, child in ipairs(instance:GetChildren()) do
        if child:IsA("ScreenGui") or child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel") then
            local data = {
                name = child.Name,
                class = child.ClassName,
                path = path .. "." .. child.Name,
                props = {}
            }
            for _, prop in ipairs(child:GetProperties()) do
                if prop:match("Text") or prop:match("Visible") or prop:match("Position") or prop:match("Size") then
                    data.props[prop] = tostring(child[prop])
                end
            end
            table.insert(gui_structure, data)
            scan_gui(child, depth+1, data.path)
        end
    end
end
