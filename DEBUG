-- DYNAMIC HASH RESOLVER
-- ============================================================
local Remotes = {}
local resolverSuccess = false

local function resolveHashes()
    local gc = getgc(true)
    local keywordMap = {
        Create = {"CreateSaleListing", "CreateListing", "AddListing", "PostItem"},
        Delete = {"DeleteSaleListing", "DeleteListing", "RemoveListing", "CancelListing"},
        Decline = {"DeclineTradeOffer", "DeclineTrade", "RejectTrade"},
        TradeOffer = {"TradeOfferReceived", "OnTradeRequest", "TradeRequest"},
        Accept = {"AcceptTradeOffer", "AcceptTrade"},
    }
    
    for _, v in pairs(gc) do
        if type(v) == "table" then
            pcall(function()
                for key, val in pairs(v) do
                    if type(key) == "string" and typeof(val) == "Instance" and (val:IsA("RemoteEvent") or val:IsA("RemoteFunction")) then
                        for cat, keywords in pairs(keywordMap) do
                            for _, kw in ipairs(keywords) do
                                if key:find(kw) then
                                    Remotes[cat] = val
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
    
    resolverSuccess = (Remotes.Create and Remotes.Delete and Remotes.Decline and Remotes.TradeOffer)
    if not resolverSuccess then
        warn("[ZHX] Resolver gagal menemukan semua hash.")
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Resolver Gagal",
                Text = "Beberapa hash tidak ditemukan. Coba re-join server.",
                Duration = 5
            })
        end)
    else
        print("[ZHX] Hash resolved: Create=", Remotes.Create.Name, "Delete=", Remotes.Delete.Name)
    end
end

resolveHashes()

