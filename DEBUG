local function send(title, desc, color)
    pcall(function()
        request({
            Url=WEBHOOK, Method="POST",
            Headers={["Content-Type"]="application/json"},
            Body=HS:JSONEncode({
                username="🔬 ZHX Monitor v2",
                embeds={{title=title,description=desc,color=color or 3066993,
                    footer={text="v2 • "..os.date("%H:%M:%S")}}}
