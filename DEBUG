-- ─── Fungsi Tambah Log UI ───
local function addLog(text, color)
    local lbl = Instance.new("TextLabel")
    lbl.Size               = UDim2.new(1, -8, 0, 20)
    lbl.BackgroundTransparency = 1
    lbl.Text               = text
    lbl.TextColor3         = color or Color3.fromRGB(200, 220, 210)
    lbl.TextSize           = 9
    lbl.Font               = Enum.Font.Code
    lbl.TextXAlignment     = Enum.TextXAlignment.Left
    lbl.TextTruncate       = Enum.TextTruncate.AtEnd
    lbl.ZIndex             = 9999
    lbl.LayoutOrder        = #recordedPoints
    lbl.Parent             = scroll
    task.defer(function()
        scroll.CanvasPosition = Vector2.new(0, scroll.AbsoluteCanvasSize.Y)
    end)
end

-- ─── Fungsi Rekam Titik ───
local function recordPoint()
    if #recordedPoints >= MAX_POINTS then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "⚠ Sudah 18 Titik",
                Text  = "Sudah cukup! Tekan KIRIM OUTPUT KE DISCORD.",
                Duration = 3
            })
        end)
        return
    end

    local char = lp.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        pcall(function()
            StarterGui:SetCore("SendNotification", {Title="Error", Text="Karakter belum siap!", Duration=2})
        end)
        return
    end

    local cf  = hrp.CFrame
    local pos = cf.Position

    local R00, R01, R02,
          R10, R11, R12,
          R20, R21, R22 = cf:GetComponents()

    local point = {
        n   = #recordedPoints + 1,
        x   = pos.X, y = pos.Y, z = pos.Z,
        R00=R00, R01=R01, R02=R02,
        R10=R10, R11=R11, R12=R12,
        R20=R20, R21=R21, R22=R22
    }
    table.insert(recordedPoints, point)

    counterLbl.Text = "Titik terekam: " .. #recordedPoints .. " / " .. MAX_POINTS
    addLog(
        string.format("#%d  X:%.1f Y:%.1f Z:%.1f", #recordedPoints, pos.X, pos.Y, pos.Z),
        Color3.fromRGB(72, 210, 130)
    )

    -- Kirim notif per titik ke Discord juga (ringkas)
    sendEmbedDiscord(
        "📍 Titik #" .. #recordedPoints .. " Direkam",
        string.format("**X:** `%.3f`\n**Y:** `%.3f`\n**Z:** `%.3f`\nTotal: **%d / %d**",
            pos.X, pos.Y, pos.Z, #recordedPoints, MAX_POINTS)
    )

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "✅ Titik #" .. #recordedPoints .. " Direkam",
            Text  = string.format("X:%.1f  Y:%.1f  Z:%.1f", pos.X, pos.Y, pos.Z),
            Duration = 2
        })
    end)
end

-- ─── Fungsi Kirim Output ke Discord ───
local function sendOutput()
    if #recordedPoints == 0 then
        pcall(function()
            StarterGui:SetCore("SendNotification", {Title="⚠ Kosong", Text="Belum ada titik direkam!", Duration=2})
        end)
        return
    end

    -- Bangun string BOOTH_CFRAMES
    local lines = {}
    table.insert(lines, "```lua")
    table.insert(lines, "local BOOTH_CFRAMES = {")
    for _, p in ipairs(recordedPoints) do
        local line = string.format(
            "    CFrame.new(%.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f), -- #%d",
            p.x, p.y, p.z,
            p.R00, p.R01, p.R02,
            p.R10, p.R11, p.R12,
            p.R20, p.R21, p.R22,
            p.n
        )
        table.insert(lines, line)
    end
    table.insert(lines, "}")
    table.insert(lines, "```")

    local output = table.concat(lines, "\n")

    -- Discord limit 2000 karakter per pesan, split jika perlu
    -- Kirim header dulu
    sendEmbedDiscord(
        "📋 OUTPUT BOOTH_CFRAMES — " .. #recordedPoints .. " Titik",
        "Script siap! Paste isi `BOOTH_CFRAMES` di bawah ke script utama.\nDikirim: " .. os.date("%d/%m/%Y %H:%M:%S")
    )

    task.wait(0.5)

    -- Kirim kode sebagai pesan biasa (lebih mudah di-copy dari Discord)
    if #output <= 1990 then
        sendToDiscord(output)
    else
        -- Jika terlalu panjang, kirim per-chunk 1900 karakter
        local chunk = "```lua\nlocal BOOTH_CFRAMES = {\n"
        for idx, p in ipairs(recordedPoints) do
            local line = string.format(
                "    CFrame.new(%.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f, %.6f), -- #%d\n",
                p.x, p.y, p.z,
                p.R00, p.R01, p.R02,
                p.R10, p.R11, p.R12,
                p.R20, p.R21, p.R22,
                p.n
            )
            if #chunk + #line + 10 > 1950 then
                sendToDiscord(chunk .. "```")
                task.wait(0.4)
                chunk = "```lua\n"
            end
            chunk = chunk .. line
        end
        chunk = chunk .. "}\n```"
        sendToDiscord(chunk)
    end

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "📨 Terkirim!",
            Text  = "Output sudah dikirim ke Discord. Cek channel webhook kamu!",
            Duration = 5
        })
    end)
end

