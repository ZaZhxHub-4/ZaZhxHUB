local dragStart, startPos, isDragging
local clickStartPos = Vector2.new()

zhxBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragStart = input.Position
        startPos = zhxBtn.Position
        clickStartPos = Vector2.new(input.Position.X, input.Position.Y)
        isDragging = false
    end
end)

zhxBtn.InputChanged:Connect(function(input)
    if dragStart and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if delta.Magnitude > 3 then isDragging = true end
        if isDragging then
            local vp = Workspace.CurrentCamera.ViewportSize
            local newX = math.clamp(startPos.X.Offset + delta.X, 0, vp.X - 48)
            local newY = math.clamp(startPos.Y.Offset + delta.Y, 0, vp.Y - 48)
            zhxBtn.Position = UDim2.new(0, newX, 0, newY)
        end
    end
end)

zhxBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        local dist = (Vector2.new(input.Position.X, input.Position.Y) - clickStartPos).Magnitude
        if not isDragging and dist < 6 then
            if _G.ZHX_TogglePanel then _G.ZHX_TogglePanel() end
        end
        dragStart, startPos, isDragging = nil, nil, false
    end
end)

