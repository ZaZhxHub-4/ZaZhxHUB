    muatBtn.TextSize = 11; muatBtn.Font = Enum.Font.GothamBold; muatBtn.AutoButtonColor = false
    muatBtn.Parent = content; Instance.new("UICorner", muatBtn).CornerRadius = UDim.new(0,5)
    muatBtn.MouseButton1Click:Connect(function()
        local now=tick()
        if now-lastMuatTime<5 then notify("Tunggu 5 detik!"); return end
        if isClaiming or (now-lastClaimTime<3) then notify("Tunggu setelah claim!"); return end
        if not checkBoothOwnership() then notify("Claim booth dulu!"); return end
        lastMuatTime=now
        notify("Memuat inventory...")
        task.spawn(function()
            local ok,list=pcall(getInventoryItemListFull)
            if not ok or not list or #list==0 then notify("Inventory kosong / gagal!"); return end
            allItemsCache=list
            nameToIdMap={}
            for _,it in ipairs(list) do if it.name~="" then nameToIdMap[it.name]={id=it.itemId,cat=it.category} end end
            updateAllUIStatus()
            notify("✅ "..#list.." item siap.")
            if not capturedRF then capturedRF=findRealRF() end
            if not capturedDeleteRF then capturedDeleteRF=findRealDeleteRF() end
            muatDone=true
        end)
    end)
    y = y + 32
    makeToggle(content, y, "AUTO BOOTH",
        function()
            if not capturedRF then notify("Muat item dulu!"); return end
            local hasSlot=false
            for i=1,MAX_SLOTS do if slotData[i].itemId and slotData[i].price>0 then hasSlot=true; break end end
            if not hasSlot then for m=1,MAX_MULTI do if #multiSlotData[m].items>0 and multiSlotData[m].price>0 then hasSlot=true; break end end end
            if not hasSlot then notify("Isi minimal 1 slot!"); return end
            autoOn=true; boothInitializing=true; notify("Auto Booth aktif!")
            task.spawn(function()
                for i=1,MAX_SLOTS do if not autoOn then break end if slotData[i].itemId and slotData[i].active then listSingleSlot(i); updateAllUIStatus(); task.wait(0.6) end end
                for m=1,MAX_MULTI do if not autoOn then break end if multiSlotData[m].active and #multiSlotData[m].items>0 then listMultiSlot(m); updateAllUIStatus(); task.wait(0.6) end end
                boothInitializing=false
                while autoOn do
                    task.wait(1.5)
                    if not autoOn then break end
                    local snap=getInventorySnapshot()
                    for i=1,MAX_SLOTS do
                        local s=slotData[i]; if not s.itemId or not s.active then continue end
                        if s.listedUUID and not snap[s.listedUUID] then
                            local sn,sp=s.itemName,s.price; s.listedUUID=nil
                            local rem=#getUUIDsForItemId(s.itemId, s.category)
                            sendEmbed("🛒 Terjual — Slot "..i,"**"..sn.."**\n💰 **"..sp.." Token**\n📦 Sisa: **"..rem.."**\n💎 "..getCurrentToken(),3066993)
                            if rem>0 then task.delay(0.5,function() if autoOn and not slotListing[i] then listSingleSlot(i); updateAllUIStatus() end end)
                            else s.active=false; sendEmbed("⚠ Habis — Slot "..i,sn.." habis.",15158332); updateAllUIStatus() end
                        elseif not s.listedUUID and not slotListing[i] then
                            task.spawn(function() if autoOn and not slotListing[i] then listSingleSlot(i); updateAllUIStatus() end end)
                        end
                    end
                    for m=1,MAX_MULTI do
                        local ms=multiSlotData[m]; if not ms.active or #ms.items==0 then continue end
                        if ms.listedUUID and not snap[ms.listedUUID] then
                            local ci=ms.currentItemIdx; local sn=(ms.items[ci] and ms.items[ci].itemName) or "?"; ms.listedUUID=nil; ms.currentItemIdx=ci+1
                            if ms.currentItemIdx>#ms.items then ms.currentItemIdx=1 end
                            local tot=getTotalMultiStock(m)
                            sendEmbed("🛒 Terjual — Multi "..m,"**"..sn.."**\n💰 **"..ms.price.." Token**\n📦 Total: **"..tot.."**\n💎 "..getCurrentToken(),3066993)
                            if tot==0 then ms.active=false; sendEmbed("⚠ Multi "..m.." Habis","Semua habis.",15158332); updateAllUIStatus()
                            else task.delay(0.5,function() if autoOn and not multiListing[m] then listMultiSlot(m); updateAllUIStatus() end end) end
                        elseif not ms.listedUUID and not multiListing[m] then
                            task.spawn(function() if autoOn and not multiListing[m] then listMultiSlot(m); updateAllUIStatus() end end)
                        end
                    end
                    updateAllUIStatus()
                end
            end)
        end,
        function() autoOn=false; boothInitializing=false; notify("Auto Booth dihentikan.") end,
        function() return autoOn end
    )
    y = y + 30
    local hapusBtn = Instance.new("TextButton")
    hapusBtn.Size = UDim2.new(1,-16,0,28); hapusBtn.Position = UDim2.new(0,8,0,y)
    hapusBtn.BackgroundColor3 = THEME.BtnDanger; hapusBtn.BorderSizePixel = 0
