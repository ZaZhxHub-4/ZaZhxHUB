local noclipConn = nil

local function startNoclip(char)
    if noclipConn then noclipConn:Disconnect() end
    noclipConn = RunService.Stepped:Connect(function()
        if not char or not char.Parent then
            noclipConn:Disconnect(); noclipConn = nil; return
        end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end

local function stopNoclip(char)
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.CanCollide = true
        end
    end
end

local function safeTeleport(hrp, char, cf)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local origWalk  = hum.WalkSpeed
    local origJump  = hum.JumpPower
    local origAuto  = hum.AutoRotate
    hum.WalkSpeed   = 0
    hum.JumpPower   = 0
    hum.AutoRotate  = false
    startNoclip(char)
    hrp.Anchored = true
    hrp.CFrame   = cf
    task.wait(0.05)
    hrp.CFrame   = cf
    task.wait(0.1)
    hrp.CFrame   = cf
    hrp.Anchored = false
    task.wait(0.35)
    hum.WalkSpeed  = origWalk
    hum.JumpPower  = origJump
    hum.AutoRotate = origAuto
end

