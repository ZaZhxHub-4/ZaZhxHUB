local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local char = lp.Character or lp.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")

local function scanPP()
    local pos = hrp.Position
    print("=== SCAN PP ===")
    for _, obj in ipairs(game:GetService("Workspace"):GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local part = obj.Parent
            local partPos = nil
            if part then
                if part:IsA("BasePart") then
                    partPos = part.Position
                elseif part:IsA("Model") and part.PrimaryPart then
                    partPos = part.PrimaryPart.Position
                end
            end
            if partPos then
                local dist = (partPos - pos).Magnitude
                if dist <= 40 then
                    print(string.format("DIST:%.1f | PP:%s | Parent:%s(%s) | Action:%s", 
                        dist, obj.Name, part.Name, part.ClassName, obj.ActionText))
                end
            end
        end
    end
    print("=== END ===")
end

while task.wait(2) do scanPP() end
