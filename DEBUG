local function send(title, desc, color)
    pcall(function()
        request({
            Url=WEBHOOK, Method="POST",
            Headers={["Content-Type"]="application/json"},
            Body=HS:JSONEncode({
                username="🔬 Monitor v4",
                embeds={{title=title,description=desc,color=color or 3066993,
                    footer={text=os.date("%H:%M:%S")}}}
            })
        })
    end)
end

while not Players.LocalPlayer do task.wait() end
local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local firedLog = {}
local monitoring = false
local logCount = 0

local function addLog(method, name, path, args)
    logCount = logCount + 1
    table.insert(firedLog, {
        method = method,
        name   = name,
        path   = (path or ""):sub(1, 100),
        args   = (args or ""):sub(1, 200)
    })
end

-- 1. hookmetamethod — tangkap SEMUA FireServer/InvokeServer
local oldNC
oldNC = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if monitoring then
        if method == "FireServer" or method == "InvokeServer" then
            local argStr = ""
            pcall(function() argStr = HS:JSONEncode({...}):sub(1, 200) end)
            local name = ""; pcall(function() name = tostring(self.Name) end)
            local path = ""; pcall(function() path = tostring(self:GetFullName()) end)
            if not name:find("Analytics") then
                addLog(method, name, path, argStr)
            end
        end
    end
    return oldNC(self, ...)
end)

-- 2. Watch backpack
pcall(function()
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        bp.ChildAdded:Connect(function(c)
            if monitoring then addLog("BackpackAdd", c.Name, c:GetFullName(), c.ClassName) end
        end)
        bp.ChildRemoved:Connect(function(c)
            if monitoring then addLog("BackpackRemove", c.Name, c:GetFullName(), c.ClassName) end
        end)
    end
end)

-- 3. Watch character
pcall(function()
    local function watchChar(char)
        if not char then return end
        char.ChildAdded:Connect(function(c)
            if monitoring then addLog("CharAdd", c.Name, c:GetFullName(), c.ClassName) end
        end)
        char.ChildRemoved:Connect(function(c)
            if monitoring then addLog("CharRemove", c.Name, c:GetFullName(), c.ClassName) end
        end)
    end
    if lp.Character then watchChar(lp.Character) end
    lp.CharacterAdded:Connect(watchChar)
end)

-- 4. Watch PlayerData via Replion (wrapped aman)
task.spawn(function()
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local Replion = require(RS.Packages.Replion)
        local PlayerData = Replion.Client:WaitReplion("Data", 5)
        if not PlayerData then return end
        PlayerData.Changed:Connect(function(path, value)
            if monitoring then
                local valStr = ""
                pcall(function() valStr = HS:JSONEncode(value):sub(1, 150) end)
                addLog("DataChanged", tostring(path), "Replion", valStr)
            end
        end)
    end)
end)

