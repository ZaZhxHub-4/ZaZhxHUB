-- ══════════════════════════════════════════════════════════════════
local floatingGui, zhxBtn
local function createFloatingButton(toggleCallback)
    floatingGui = createInstance("ScreenGui", {
        Name = "ZHX_FloatingGui",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = pg
    })

    zhxBtn = createInstance("ImageButton", {
        Size = UDim2.new(0, 46, 0, 46),
        Position = UDim2.new(0, 12, 0, 100),
        BackgroundColor3 = DARK_BG,
        BorderSizePixel = 0,
        Image = ZHX_FLOAT,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = 100,
        Parent = floatingGui
    })
    createInstance("UICorner", { CornerRadius = UDim.new(0, 10), Parent = zhxBtn })
    createInstance("UIStroke", { Color = ZHX_GREEN, Thickness = 1.5, Parent = zhxBtn })

    local dragStart, startPos, isDragging
    local clickStartPos = Vector2.new()

    zhxBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragStart = input.Position
            startPos = zhxBtn.Position
            clickStartPos = Vector2.new(input.Position.X, input.Position.Y)
            isDragging = false
        end
    end)

    zhxBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local dist = (Vector2.new(input.Position.X, input.Position.Y) - clickStartPos).Magnitude
            if dist < 6 then
                if toggleCallback then toggleCallback() end
            end
            dragStart = nil
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragStart and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local vp = Workspace.CurrentCamera.ViewportSize
            local newX = math.clamp(startPos.X.Offset + delta.X, 0, vp.X - 46)
            local newY = math.clamp(startPos.Y.Offset + delta.Y, 0, vp.Y - 46)
            zhxBtn.Position = UDim2.new(0, newX, 0, newY)
        end
    end)
end

