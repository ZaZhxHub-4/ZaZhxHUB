Instance.new("UICorner", zhxBtn).CornerRadius = UDim.new(0, 10)
local zs = Instance.new("UIStroke", zhxBtn)
zs.Color = Color3.fromRGB(72, 210, 130)
zs.Thickness = 1.5

-- Drag logic untuk tombol ZHX
local dragB = false
local dragIB, dragSB, startPB

zhxBtn.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        dragB = true
        dragSB = inp.Position
        startPB = zhxBtn.Position
        inp.Changed:Connect(function()
            if inp.UserInputState == Enum.UserInputState.End then dragB = false end
        end)
    end
end)

zhxBtn.InputChanged:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
        dragIB = inp
    end
end)

UIS.InputChanged:Connect(function(inp)
    if inp == dragIB and dragB then
        local d = inp.Position - dragSB
        local vp = workspace.CurrentCamera.ViewportSize
        zhxBtn.Position = UDim2.new(0, math.clamp(startPB.X.Offset + d.X, 0, vp.X - 46), 0, math.clamp(startPB.Y.Offset + d.Y, 0, vp.Y - 46))
    end
end)

local uiVis = true
zhxBtn.MouseButton1Click:Connect(function()
    if dragB then return end
    uiVis = not uiVis
    if mainGui then mainGui.Enabled = uiVis end
    zs.Color = uiVis and Color3.fromRGB(72, 210, 130) or Color3.fromRGB(100, 100, 100)
    sendLog("🔘 ZHX TOGGLE", "Panel Utama diubah menjadi: " .. (uiVis and "TERLIHAT" or "DISEMBUNYIKAN"))
end)
table.insert(out, "✅ Tombol ZHX Berhasil Dibuat.")

