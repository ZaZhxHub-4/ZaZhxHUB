-- CUSTOM DROPDOWN SYSTEM
-- ══════════════════════════════════════════════════════════════════
local customDropGui, customDropFrame, customDropConn = nil, nil, nil
local activeDropType, activeDropIdx = nil, nil
local multiSelected = {}; local slotButtonLabel = {}
local PANEL_W, DROP_W, DROP_H, ITEM_H, SEARCH_H, DIVIDER_H = 300, 180, 310, 28, 32, 20

local function getThemeColors()
    return Compkiller.Colors.Highlight or Color3.fromRGB(72,210,130), Compkiller.Colors.BlockBackground or Color3.fromRGB(32,35,42), Compkiller.Colors.DropColor or Color3.fromRGB(45,50,58)
end
local function closeCustomDropdown()
    if customDropConn then customDropConn:Disconnect(); customDropConn=nil end
    if customDropGui then customDropGui:Destroy(); customDropGui=nil; customDropFrame=nil end
    activeDropType = nil; activeDropIdx = nil
end
local function getDropdownPosition()
    local vp, scale = workspace.CurrentCamera.ViewportSize, currentGlobalScale
    local winRoot, panelFrame = Window.Root, nil
    if winRoot then for _, obj in ipairs(winRoot:GetChildren()) do if obj:IsA("Frame") and obj.ZIndex == 4 then panelFrame = obj; break end end end
    local px, py = 0, 0
    if panelFrame then
        local absPos, absSize = panelFrame.AbsolutePosition, panelFrame.AbsoluteSize
        px, py = absPos.X + absSize.X + 6, absPos.Y
    else px, py = vp.X/2 + (PANEL_W * scale)/2 + 6, vp.Y/2 - (DROP_H * scale)/2 end
    local dropW, dropH = DROP_W * scale, DROP_H * scale
    if px + dropW > vp.X then px = vp.X - dropW - 4 end
    if py + dropH > vp.Y then py = vp.Y - dropH - 4 end
    if py < 0 then py = 4 end
    return px, py, dropW, dropH, scale
end

local function openCustomDropdown(dropType, slotIdx, itemList, onSelect, selectedSet)
    closeCustomDropdown(); activeDropType, activeDropIdx = dropType, slotIdx
    local hl, bg, dropBg = getThemeColors(); local px, py, dropW, dropH, sc = getDropdownPosition()

    customDropGui = Instance.new("ScreenGui")
    customDropGui.Name, customDropGui.ZIndexBehavior, customDropGui.ResetOnSpawn, customDropGui.Parent = "ZHX_CustomDropdown", Enum.ZIndexBehavior.Sibling, false, pg

    customDropFrame = Instance.new("Frame")
    customDropFrame.Size, customDropFrame.Position = UDim2.new(0, dropW, 0, dropH), UDim2.new(0, px, 0, py)
    customDropFrame.BackgroundColor3, customDropFrame.BorderSizePixel, customDropFrame.ZIndex, customDropFrame.Parent = bg, 0, 200, customDropGui
    Instance.new("UICorner", customDropFrame).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", customDropFrame); stroke.Color, stroke.Thickness = hl, 1.5

    local headerH = 26 * sc; local header = Instance.new("Frame")
    header.Size, header.BackgroundColor3, header.BorderSizePixel, header.ZIndex, header.Parent = UDim2.new(1, 0, 0, headerH), hl, 0, 201, customDropFrame
    Instance.new("UICorner", header).CornerRadius = UDim.new(0,8)
    local hfix = Instance.new("Frame"); hfix.Size, hfix.Position = UDim2.new(1,0,0,8), UDim2.new(0,0,1,-8); hfix.BackgroundColor3, hfix.BorderSizePixel, hfix.ZIndex, hfix.Parent = hl, 0, 201, header

    local headerLbl = Instance.new("TextLabel")
    headerLbl.Size, headerLbl.Position, headerLbl.BackgroundTransparency = UDim2.new(1,-28,1,0), UDim2.new(0,8,0,0), 1
    headerLbl.Text, headerLbl.TextColor3, headerLbl.TextSize, headerLbl.Font = ">> Pilih Item", Color3.fromRGB(255,255,255), math.floor(12 * sc), Enum.Font.GothamBold
    headerLbl.TextXAlignment, headerLbl.ZIndex, headerLbl.Parent = Enum.TextXAlignment.Left, 202, header

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size, closeBtn.Position, closeBtn.BackgroundTransparency = UDim2.new(0, headerH, 0, headerH), UDim2.new(1, -headerH, 0, 0), 1
    closeBtn.Text, closeBtn.TextColor3, closeBtn.TextSize, closeBtn.Font = "X", Color3.fromRGB(255,255,255), math.floor(13 * sc), Enum.Font.GothamBold
    closeBtn.ZIndex, closeBtn.Parent = 203, header; closeBtn.MouseButton1Click:Connect(closeCustomDropdown)

    local searchH = math.floor(SEARCH_H * sc); local searchBg = Instance.new("Frame")
    searchBg.Size, searchBg.Position, searchBg.BackgroundColor3, searchBg.BorderSizePixel = UDim2.new(1,-12,0,searchH), UDim2.new(0,6,0,headerH+4), dropBg, 0
    searchBg.ZIndex, searchBg.Parent = 201, customDropFrame; Instance.new("UICorner", searchBg).CornerRadius = UDim.new(0,6)
    local sStroke = Instance.new("UIStroke", searchBg); sStroke.Color, sStroke.Thickness = Color3.fromRGB(80,90,100), 1

    local searchBox = Instance.new("TextBox")
    searchBox.Size, searchBox.Position, searchBox.BackgroundTransparency = UDim2.new(1,-8,1,-4), UDim2.new(0,4,0,2), 1
    searchBox.Text, searchBox.PlaceholderText, searchBox.PlaceholderColor3 = "", "🔍 Cari item...", Color3.fromRGB(130,140,150)
    searchBox.TextColor3, searchBox.TextSize, searchBox.Font = Color3.fromRGB(220,225,230), math.floor(11 * sc), Enum.Font.Gotham
    searchBox.ClearTextOnFocus, searchBox.ZIndex, searchBox.Parent = false, 202, searchBg

    local topOffset, listH = headerH + searchH + 10, dropH - (headerH + searchH + 10) - 6
    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size, scrollFrame.Position, scrollFrame.BackgroundTransparency = UDim2.new(1,-6,0,listH), UDim2.new(0,3,0,topOffset), 1
    scrollFrame.BorderSizePixel, scrollFrame.ScrollBarThickness, scrollFrame.ScrollBarImageColor3 = 0, 4, hl
    scrollFrame.CanvasSize, scrollFrame.ZIndex, scrollFrame.Parent = UDim2.new(0,0,0,0), 201, customDropFrame
    local listLayout = Instance.new("UIListLayout"); listLayout.SortOrder, listLayout.Padding, listLayout.Parent = Enum.SortOrder.LayoutOrder, UDim.new(0,2), scrollFrame

    local currentSelected = {}
    if selectedSet then for id, v in pairs(selectedSet) do currentSelected[id] = v end end

    local function buildItemRows(filterText)
        for _, c in ipairs(scrollFrame:GetChildren()) do if c:IsA("Frame") or c:IsA("TextButton") then c:Destroy() end end
        local ft, lastCat, rowCount, totalH = filterText:lower():gsub("^%s*(.-)%s*$", "%1"), nil, 0, 0
        local iH, dH = math.floor(ITEM_H * sc), math.floor(DIVIDER_H * sc)

        for _, item in ipairs(itemList) do
            if not ((ft == "") or item.name:lower():find(ft, 1, true)) then continue end
            if item.category ~= lastCat then
                lastCat = item.category
                local divFrame = Instance.new("Frame")
                divFrame.Size, divFrame.BackgroundTransparency, divFrame.BorderSizePixel, divFrame.LayoutOrder = UDim2.new(1,-4,0,dH), 1, 0, rowCount * 2
                divFrame.ZIndex, divFrame.Parent = 202, scrollFrame
                local d1 = Instance.new("Frame"); d1.Size, d1.Position, d1.BackgroundColor3, d1.BorderSizePixel, d1.ZIndex, d1.Parent = UDim2.new(0.35,0,0,1), UDim2.new(0,4,0.5,-1), Color3.fromRGB(80,90,100), 0, 203, divFrame
                local d2 = Instance.new("Frame"); d2.Size, d2.Position, d2.BackgroundColor3, d2.BorderSizePixel, d2.ZIndex, d2.Parent = UDim2.new(0.35,0,0,1), UDim2.new(0.65,0,0.5,-1), Color3.fromRGB(80,90,100), 0, 203, divFrame
                local dLbl = Instance.new("TextLabel")
                dLbl.Size, dLbl.Position, dLbl.BackgroundTransparency, dLbl.Text = UDim2.new(0.3,0,1,0), UDim2.new(0.35,0,0,0), 1, item.category
                dLbl.TextColor3, dLbl.TextSize, dLbl.Font = Color3.fromRGB(160,170,180), math.floor(9 * sc), Enum.Font.GothamBold
                dLbl.TextXAlignment, dLbl.ZIndex, dLbl.Parent = Enum.TextXAlignment.Center, 203, divFrame
                totalH = totalH + dH + 2; rowCount = rowCount + 1
            end

            local isChosen = (dropType == "multi") and currentSelected[item.itemId]
            local rowBtn = Instance.new("TextButton")
            rowBtn.Size, rowBtn.BackgroundColor3, rowBtn.BackgroundTransparency = UDim2.new(1,-4,0,iH), isChosen and hl or dropBg, isChosen and 0.3 or 0.4
            rowBtn.BorderSizePixel, rowBtn.Text, rowBtn.LayoutOrder, rowBtn.ZIndex, rowBtn.Parent = 0, "", rowCount * 2 + 1, 202, scrollFrame
            Instance.new("UICorner", rowBtn).CornerRadius = UDim.new(0,5)

            if dropType == "multi" then
                local checkLbl = Instance.new("TextLabel")
                checkLbl.Size, checkLbl.Position, checkLbl.BackgroundTransparency, checkLbl.Text = UDim2.new(0, iH, 1, 0), UDim2.new(0,0,0,0), 1, isChosen and "✓" or ""
                checkLbl.TextColor3, checkLbl.TextSize, checkLbl.Font = hl, math.floor(11 * sc), Enum.Font.GothamBold
                checkLbl.TextXAlignment, checkLbl.ZIndex, checkLbl.Parent = Enum.TextXAlignment.Center, 203, rowBtn
            end

            local nameOffset = (dropType == "multi") and iH or 6
            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size, nameLbl.Position, nameLbl.BackgroundTransparency, nameLbl.Text = UDim2.new(1,-nameOffset-4,1,0), UDim2.new(0, nameOffset, 0, 0), 1, item.name
            nameLbl.TextColor3, nameLbl.TextSize, nameLbl.Font = isChosen and Color3.fromRGB(255,255,255) or Color3.fromRGB(200,205,210), math.floor(10 * sc), Enum.Font.Gotham
            nameLbl.TextXAlignment, nameLbl.TextTruncate, nameLbl.ZIndex, nameLbl.Parent = Enum.TextXAlignment.Left, Enum.TextTruncate.AtEnd, 203, rowBtn

            local stokLbl = Instance.new("TextLabel")
            stokLbl.Size, stokLbl.Position, stokLbl.BackgroundTransparency, stokLbl.Text = UDim2.new(0,30,1,0), UDim2.new(1,-32,0,0), 1, "x"..item.count
            stokLbl.TextColor3, stokLbl.TextSize, stokLbl.Font = Color3.fromRGB(120,130,140), math.floor(9 * sc), Enum.Font.Gotham
            stokLbl.TextXAlignment, stokLbl.ZIndex, stokLbl.Parent = Enum.TextXAlignment.Right, 203, rowBtn

            rowBtn.MouseEnter:Connect(function()
                if not (dropType=="multi" and currentSelected[item.itemId]) then rowBtn.BackgroundColor3, rowBtn.BackgroundTransparency, nameLbl.TextColor3 = hl, 0.6, Color3.fromRGB(255,255,255) end
            end)
            rowBtn.MouseLeave:Connect(function()
                if not (dropType=="multi" and currentSelected[item.itemId]) then rowBtn.BackgroundColor3, rowBtn.BackgroundTransparency, nameLbl.TextColor3 = dropBg, 0.4, Color3.fromRGB(200,205,210) end
            end)

            local cap = {itemId=item.itemId, name=item.name, category=item.category, count=item.count}
            rowBtn.MouseButton1Click:Connect(function()
                if dropType == "single" then
                    onSelect(cap); closeCustomDropdown()
                elseif dropType == "multi" then
                    currentSelected[cap.itemId] = not currentSelected[cap.itemId]
                    onSelect(cap, currentSelected); buildItemRows(searchBox.Text)
                end
            end)
            totalH = totalH + iH + 2; rowCount = rowCount + 1
        end
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, totalH + 8)
    end
    buildItemRows("")
    searchBox:GetPropertyChangedSignal("Text"):Connect(function() buildItemRows(searchBox.Text) end)

    customDropConn = UIS.InputBegan:Connect(function(inp, gameProc)
        if gameProc then return end
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            if customDropFrame then
                local pos, absPos, absSize = inp.Position, customDropFrame.AbsolutePosition, customDropFrame.AbsoluteSize
                local inside = pos.X >= absPos.X and pos.X <= absPos.X + absSize.X and pos.Y >= absPos.Y and pos.Y <= absPos.Y + absSize.Y
                if not inside then closeCustomDropdown() end
            end
        end
    end)
end

local function setSlotButtonText(key, text)
    local btn = slotButtonLabel[key]
    if btn and btn.SetText then btn:SetText(text) end
end

