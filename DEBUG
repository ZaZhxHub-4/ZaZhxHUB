tabConfig:button("💾 Simpan Config", function()
    local name = cfgNameInput and cfgNameInput.value or ""
    if not name or name:match("^%s*$") then
        w:notify("Error", "Isi nama config terlebih dahulu!", 2); return
    end
    local hasAny = false
    for i = 1, MAX_SLOTS do
        if slotData[i].itemId and slotData[i].price > 0 then hasAny = true; break end
    end
    if not hasAny then
        for mm = 1, MAX_MULTI do
            if #multiSlotData[mm].items > 0 and multiSlotData[mm].price > 0 then hasAny = true; break end
        end
    end
    if not hasAny then
        w:notify("Error", "Tidak ada slot aktif untuk disimpan!", 2); return
    end
    local cfg = { single = {}, multi = {}, webhook = webhookURL }
    for i = 1, MAX_SLOTS do
        if slotData[i].itemId and slotData[i].price > 0 then
            cfg.single[i] = {
                itemId   = slotData[i].itemId,
                itemName = slotData[i].itemName,
                category = slotData[i].category,
                price    = slotData[i].price,
                enabled  = slotData[i].enabled,
            }
        end
    end
    for mm = 1, MAX_MULTI do
        if #multiSlotData[mm].items > 0 then
            cfg.multi[mm] = { items = {}, price = multiSlotData[mm].price, enabled = multiSlotData[mm].enabled }
            for _, it in ipairs(multiSlotData[mm].items) do
                table.insert(cfg.multi[mm].items, {
                    itemId   = it.itemId,
                    itemName = it.itemName,
                    category = it.category,
                })
            end
        end
    end
    savedConfigs[name] = cfg
    if configNameList[1] == "— Belum Ada Config —" then table.remove(configNameList, 1) end
    if not table.find(configNameList, name) then table.insert(configNameList, name) end
    saveConfigsToFile()
    pcall(function() cfgSelectDD:set(name) end)
    w:notify("💾 Tersimpan", "Config '" .. name .. "' berhasil disimpan.", 2)
end)

tabConfig:button("📂 Load Config", function()
    local name = cfgSelectDD and cfgSelectDD.value or ""
    if not name or not savedConfigs[name] or name == "— Belum Ada Config —" then
        w:notify("Error", "Pilih config yang valid!", 2); return
    end
    if autoOn then
        w:notify("Terkunci", "Matikan Auto Booth dulu untuk memuat config!", 3); return
    end
    local ok2, list = pcall(getInventoryItemList)
    if not ok2 then list = {} end
    allItemsCache = list; nameToIdMap = {}
    for _, it in ipairs(list) do
        if it.name and it.name ~= "" then
            nameToIdMap[it.name] = { id = it.itemId, cat = it.category }
        end
    end
    isLoadingConfig = true
    local cfg = savedConfigs[name]
    for i = 1, MAX_SLOTS do
        slotData[i] = { itemId = nil, itemName = nil, category = nil, price = 0, active = false, enabled = false, listedUUID = nil }
        if cfg.single and cfg.single[i] and nameToIdMap[cfg.single[i].itemName] then
            local s = cfg.single[i]
            slotData[i] = {
                itemId    = s.itemId,
                itemName  = s.itemName,
                category  = s.category,
                price     = s.price,
                enabled   = s.enabled or false,
                active    = (s.enabled or false) and s.price > 0,
                listedUUID = nil
            }
            pcall(function() elSingleToggle[i]:set(slotData[i].enabled) end)
            pcall(function() elSingleDD[i]:set(s.itemName) end)
        end
    end
    for mm = 1, MAX_MULTI do
        multiSlotData[mm] = { items = {}, price = 0, active = false, enabled = false, currentItemIdx = 1, listedUUID = nil }
        if cfg.multi and cfg.multi[mm] and #cfg.multi[mm].items > 0 then
            local valid = {}
            for _, it in ipairs(cfg.multi[mm].items) do
                if nameToIdMap[it.itemName] then
                    table.insert(valid, { itemId = it.itemId, itemName = it.itemName, category = it.category })
                end
            end
            if #valid > 0 then
                multiSlotData[mm].items   = valid
                multiSlotData[mm].price   = cfg.multi[mm].price
                multiSlotData[mm].enabled = cfg.multi[mm].enabled or false
                multiSlotData[mm].active  = multiSlotData[mm].enabled and cfg.multi[mm].price > 0
                pcall(function() elMultiToggle[mm]:set(multiSlotData[mm].enabled) end)
            end
        end
    end
    if cfg.webhook and cfg.webhook ~= "" then
        webhookURL = cfg.webhook
        pcall(function()
            -- update input webhook
        end)
    end
    isLoadingConfig = false
    updateAllUIStatus()
    w:notify("📂 Dimuat", "Config '" .. name .. "' berhasil dimuat!", 2)
end)

