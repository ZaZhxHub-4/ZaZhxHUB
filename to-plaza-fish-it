-- ============================================================
-- AUTO TELEPORT FISH IT ZHX -> FISH IT PLAZA
-- ============================================================

local ENABLE_AUTO_TELEPORT = true   -- true = aktif, false = nonaktif

local ROOT_PLACE_ID   = 121864768012064   -- Fish It biasa
local TARGET_PLACE_ID = 79378095465365    -- Fish It Plaza

local CHECK_INTERVAL  = 5   -- cek setiap 5 detik
local INITIAL_WAIT    = 10  -- jeda awal sebelum mulai cek

local TeleportService = game:GetService("TeleportService")

-- ============================================================
-- JANGAN UBAH BAGIAN DI BAWAH INI
-- ============================================================

local alreadyTeleported = false

task.spawn(function()
    if not ENABLE_AUTO_TELEPORT then
        return
    end

    -- Jeda awal agar tidak bentrok saat first join
    task.wait(INITIAL_WAIT)

    while true do
        local currentPlaceId = game.PlaceId

        if currentPlaceId == ROOT_PLACE_ID and not alreadyTeleported then
            alreadyTeleported = true

            print("[AutoTeleport] Berada di Fish It root. Teleport ke plaza...")
            pcall(function()
                TeleportService:Teleport(TARGET_PLACE_ID)
            end)

            -- Beri waktu loading teleport
            task.wait(10)
        elseif currentPlaceId == TARGET_PLACE_ID then
            -- Sudah di target, jangan lakukan apa-apa
            alreadyTeleported = true
            print("[AutoTeleport] Sudah berada di Fish It Plaza.")
        else
            -- Berada di place lain, reset flag agar bisa teleport nanti
            alreadyTeleported = false
        end

        task.wait(CHECK_INTERVAL)
    end
end)
