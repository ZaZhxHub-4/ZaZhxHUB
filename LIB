local function applyLightingPotato()
    Lighting.GlobalShadows = false; Lighting.Brightness = 1
    Lighting.ClockTime = 14; Lighting.TimeOfDay = "14:00:00"
    Lighting.EnvironmentDiffuseScale = 0.2; Lighting.EnvironmentSpecularScale = 0.1
    Lighting.Technology = Enum.Technology.ShadowMap; Lighting.ShadowSoftness = 0
    Lighting.Ambient = Color3.fromRGB(100, 100, 100); Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120)
    Lighting.FogColor = Color3.fromRGB(150, 150, 150); Lighting.FogEnd = 1000; Lighting.FogStart = 500
    Lighting.ColorShift_Top = Color3.new(0,0,0); Lighting.ColorShift_Bottom = Color3.new(0,0,0)
end

local function restoreLighting()
    for prop, value in pairs(originalLighting) do pcall(function() Lighting[prop] = value end) end
end

local function setPartMaterialPlastic(part)
    if part:IsA("BasePart") and not part:IsA("Terrain") then
        pcall(function() if part.Material ~= Enum.Material.Plastic then part.Material = Enum.Material.Plastic end end)
    end
end

local function disableVFX(obj)
    if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Trail") or obj:IsA("Beam") then
        pcall(function() obj.Enabled = false end)
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        pcall(function() obj.Transparency = 1 end)
    end
    for _, child in ipairs(obj:GetChildren()) do disableVFX(child) end
end

local function simplifyCharacter(character)
    if not character then return end
    for _, accessory in ipairs(character:GetChildren()) do
        if accessory:IsA("Accessory") then
            pcall(function() accessory.Handle.Transparency = 1; accessory.Handle.Size = Vector3.new(0.1,0.1,0.1) end)
        elseif accessory:IsA("Clothing") or accessory:IsA("Shirt") or accessory:IsA("Pants") then
            pcall(function() accessory:Destroy() end)
        end
    end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            pcall(function() part.Material = Enum.Material.Plastic; part.Reflectance = 0 end)
        end
    end
end

local function simplifyAllCharacters()
    for _, player in ipairs(Players:GetPlayers()) do if player.Character then simplifyCharacter(player.Character) end end
end

local function applyBoostFPS(enable)
    if enable then
        if next(originalLighting) == nil then storeOriginalLighting() end
        applyLightingPotato()
        task.spawn(function()
            local allParts = Workspace:GetDescendants()
            for i, obj in ipairs(allParts) do
                if not boostFPSEnabled then break end
                if obj:IsA("BasePart") and not obj:IsA("Terrain") then setPartMaterialPlastic(obj) end
                disableVFX(obj)
                if i % 100 == 0 then task.wait() end
            end
            simplifyAllCharacters()
            if descendantsConnection then descendantsConnection:Disconnect() end
            descendantsConnection = Workspace.DescendantAdded:Connect(function(child)
                if boostFPSEnabled then
                    if child:IsA("BasePart") and not child:IsA("Terrain") then setPartMaterialPlastic(child) end
                    disableVFX(child)
                    if child:IsA("Accessory") then task.wait(0.05); simplifyCharacter(child.Parent) end
                end
            end)
            if playersAddedConnection then playersAddedConnection:Disconnect() end
            playersAddedConnection = Players.PlayerAdded:Connect(function(player)
                player.CharacterAdded:Connect(function(character)
                    if boostFPSEnabled then task.wait(0.5); simplifyCharacter(character) end
                end)
            end)
        end)
    else
        restoreLighting()
        if descendantsConnection then descendantsConnection:Disconnect(); descendantsConnection = nil end
        if playersAddedConnection then playersAddedConnection:Disconnect(); playersAddedConnection = nil end
    end
end

