-- ========== LIGHTWEIGHT STATS PANEL (FPS ONLY) ==========
local showStatsPanel = false
local statGui = nil
local statFrame = nil
local statTextLabel = nil
local startTime = tick()
local currentFPS = 60
local frameCount = 0
local lastFrameTime = tick()

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
end)

task.spawn(function()
    while true do
        task.wait(1)
        if not showStatsPanel then continue end
        local now = tick()
        local delta = now - lastFrameTime
        if delta > 0 then
            currentFPS = frameCount / delta
            frameCount = 0
            lastFrameTime = now
        end
        local up = tick() - startTime
        local hrs = math.floor(up / 3600)
        local mins = math.floor((up % 3600) / 60)
        local secs = math.floor(up % 60)
        local uptimeStr = string.format("%02d:%02d:%02d", hrs, mins, secs)
        if statTextLabel then
            statTextLabel.Text = string.format("FPS: %.1f  |  Uptime: %s", currentFPS, uptimeStr)
        end
    end
end)

local function createStatsPanel()
    if statGui then statGui:Destroy() end
    statGui = Instance.new("ScreenGui")
    statGui.Name = "ZHX_StatsPanel"
    statGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    statGui.ResetOnSpawn = false
    statGui.Parent = lp:WaitForChild("PlayerGui")
    
    statFrame = Instance.new("Frame")
    statFrame.Size = UDim2.new(0, 180, 0, 32)
    statFrame.Position = UDim2.new(0, 10, 0, 50)
    statFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    statFrame.BackgroundTransparency = 0.5
    statFrame.BorderSizePixel = 0
    statFrame.Parent = statGui
    Instance.new("UICorner", statFrame).CornerRadius = UDim.new(0, 16)
    local statStroke = Instance.new("UIStroke", statFrame)
    statStroke.Color = Color3.fromRGB(72, 210, 130); statStroke.Thickness = 1.5
    
    statTextLabel = Instance.new("TextLabel")
    statTextLabel.Size = UDim2.new(1, 0, 1, 0)
    statTextLabel.BackgroundTransparency = 1
    statTextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    statTextLabel.TextSize = 12
    statTextLabel.Font = Enum.Font.GothamBold
    statTextLabel.TextXAlignment = Enum.TextXAlignment.Center
    statTextLabel.TextYAlignment = Enum.TextYAlignment.Center
    statTextLabel.Text = "FPS: --  |  Uptime: --"
    statTextLabel.Parent = statFrame
    
    local dragging = false
    local dragStart, startPos
    statFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = statFrame.Position
        end
    end)
    statFrame.InputEnded:Connect(function()
        dragging = false
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local vpSize = workspace.CurrentCamera.ViewportSize
            local newX = math.clamp(startPos.X.Offset + delta.X, 0, vpSize.X - statFrame.AbsoluteSize.X)
            local newY = math.clamp(startPos.Y.Offset + delta.Y, 0, vpSize.Y - statFrame.AbsoluteSize.Y)
            statFrame.Position = UDim2.new(0, newX, 0, newY)
        end
    end)
end

local function setStatsPanelVisible(visible)
    if visible then
        if not statGui then createStatsPanel() end
        statGui.Enabled = true
    else
        if statGui then statGui.Enabled = false end
    end
end

