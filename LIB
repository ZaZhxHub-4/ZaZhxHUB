Tabs.Setup:AddToggle("AutoBoothToggle", {
    Title = "▶ MULAI AUTO BOOTH", Default = false,
    Callback = function(state)
        if state then
            if not capturedRF then
                Fluent:Notify({Title="⛔ Stop", Content="Tangkap sinyal dulu (Langkah 1)!", Type="Error", Duration=2})
                task.defer(function() pcall(function() Window.Elements["AutoBoothToggle"]:SetValue(false) end) end)
                return
            end
            local hasSlot = false
            for i = 1, MAX_SLOTS do if slotData[i].itemId and slotData[i].price > 0 then hasSlot=true; break end end
            if not hasSlot then
                for m = 1, MAX_MULTI do if #multiSlotData[m].items>0 and multiSlotData[m].price>0 then hasSlot=true; break end end
            end
            if not hasSlot then
                Fluent:Notify({Title="⛔ Stop", Content="Isi minimal 1 slot dengan item & harga!", Type="Error", Duration=2})
                task.defer(function() pcall(function() Window.Elements["AutoBoothToggle"]:SetValue(false) end) end)
                return
            end

            autoOn = true; boothInitializing = true
            Fluent:Notify({Title="▶ Auto Booth", Content="Sistem aktif, memantau booth...", Type="Success", Duration=2})

            task.spawn(function()
                for i = 1, MAX_SLOTS do
                    if not autoOn then break end
                    if slotData[i].itemId and slotData[i].active then
                        listSingleSlot(i); updateAllUIStatus(); task.wait(0.6)
                    end
                end
                for m = 1, MAX_MULTI do
                    if not autoOn then break end
                    if multiSlotData[m].active and #multiSlotData[m].items > 0 then
                        listMultiSlot(m); updateAllUIStatus(); task.wait(0.6)
                    end
                end
                boothInitializing = false

                while autoOn do
                    task.wait(1.5)
                    if not autoOn then break end
                    local snap = getInventorySnapshot()

                    for i = 1, MAX_SLOTS do
                        local s = slotData[i]
                        if not s.itemId or not s.active then continue end
                        if s.listedUUID and not snap[s.listedUUID] then
                            local soldName, soldPrice = s.itemName, s.price
                            s.listedUUID = nil
                            local rem = #getUUIDsForItemId(s.itemId)
                            sendEmbed("🛒 Terjual — Slot "..i,
                                "**"..soldName.."**\n💰 **"..soldPrice.." Token**\n📦 Sisa: **"..rem.."**\n💎 "..getCurrentToken(),
                                3066993)
                            if rem > 0 then
                                task.delay(0.5, function()
                                    if autoOn and not slotListing[i] then
                                        listSingleSlot(i); updateAllUIStatus()
                                    end
                                end)
                            else
                                s.active = false
                                sendEmbed("⚠ Habis — Slot "..i, soldName.." habis.", 15158332)
                                updateAllUIStatus()
                            end
                        elseif not s.listedUUID and not slotListing[i] then
                            task.spawn(function()
                                if autoOn and not slotListing[i] then
                                    listSingleSlot(i); updateAllUIStatus()
                                end
                            end)
                        end
                    end

                    for m = 1, MAX_MULTI do
                        local ms = multiSlotData[m]
                        if not ms.active or #ms.items == 0 then continue end
                        if ms.listedUUID and not snap[ms.listedUUID] then
                            local ci = ms.currentItemIdx
                            local soldName = (ms.items[ci] and ms.items[ci].itemName) or "?"
                            ms.listedUUID = nil
                            ms.currentItemIdx = ci + 1
                            if ms.currentItemIdx > #ms.items then ms.currentItemIdx = 1 end
                            local totalStock = getTotalMultiStock(m)
                            sendEmbed("🛒 Terjual — Multi "..m,
                                "**"..soldName.."**\n💰 **"..ms.price.." Token**\n📦 Total Antrian: **"..totalStock.."**\n💎 "..getCurrentToken(),
                                3066993)
                            if totalStock == 0 then
                                ms.active = false
                                sendEmbed("⚠ Multi "..m.." Habis", "Semua item habis.", 15158332)
                                updateAllUIStatus()
                            else
                                task.delay(0.5, function()
                                    if autoOn and not multiListing[m] then
                                        listMultiSlot(m); updateAllUIStatus()
                                    end
                                end)
                            end
                        elseif not ms.listedUUID and not multiListing[m] then
                            task.spawn(function()
                                if autoOn and not multiListing[m] then
                                    listMultiSlot(m); updateAllUIStatus()
                                end
                            end)
                        end
                    end

                    updateAllUIStatus()
                end
            end)
        else
            autoOn = false; boothInitializing = false
            Fluent:Notify({Title="⏹ Auto Booth", Content="Sistem dihentikan.", Type="Warning", Duration=2})
        end
    end
})

