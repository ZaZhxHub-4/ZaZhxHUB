UIS.InputBegan:Connect(function(inp)
    if not multiOverlayActive or not multiOverlayFrame then return end
    if inp.UserInputType ~= Enum.UserInputType.MouseButton1
    and inp.UserInputType ~= Enum.UserInputType.Touch then return end
    local mx, my = inp.Position.X, inp.Position.Y
    local ap = multiOverlayFrame.AbsolutePosition
    local as = multiOverlayFrame.AbsoluteSize
    if not (mx >= ap.X and mx <= ap.X+as.X and my >= ap.Y and my <= ap.Y+as.Y) then
        closeMultiOverlay()
    end
end)

