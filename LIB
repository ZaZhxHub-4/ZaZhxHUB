        boostFPSEnabled = state
        applyBoostFPS(state)
        Fluent:Notify({Title="Boost FPS", Content=state and "✅ Diaktifkan" or "⛔ Dinonaktifkan", Type=state and "Success" or "Warning", Duration=3})
