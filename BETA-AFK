local webhook = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"
local HS = game:GetService("HttpService")
local RS = game:GetService("ReplicatedStorage")
local WS = game:GetService("Workspace")
local LP = game:GetService("Players").LocalPlayer
local UIS = game:GetService("UserInputService")

local function send(msg)
    pcall(function()
        local body = HS:JSONEncode({content = "`" .. os.date("%H:%M:%S") .. "` " .. msg})
        if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif syn and syn.request then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        else request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body}) end
    end)
end

send("🔄 PET BUG MAINTAINER aktif. Menjaga bug tetap berjalan...")

-- Cari remote untuk auto fishing (tanpa hash, langsung)
local netFolder = RS.Packages._Index["sleitnick_net@0.2.0"].net
local autoRF = netFolder:FindFirstChild("RF/UpdateAutoFishingState")
local markRF = netFolder:FindFirstChild("RF/MarkAutoFishingUsed")

if not autoRF and not markRF then
    send("❌ Remote AutoFishing tidak ditemukan. Mencari manual...")
    -- Cari remote yang namanya mengandung "auto" di seluruh net
    for _, obj in pairs(netFolder:GetDescendants()) do
        if obj:IsA("RemoteFunction") and obj.Name:lower():find("auto") then
            autoRF = obj
            send("🎯 Ditemukan remote auto alternatif: " .. obj.Name)
            break
        end
    end
end

-- Fungsi untuk toggle auto fishing (dengan aman)
local function toggleAuto()
    -- Klik tombol AutoFishingButton di GUI sebagai alternatif yang lebih aman
    local btn = LP.PlayerGui.Backpack:FindFirstChild("AutoFishingButton")
    if btn then
        pcall(function()
            local pos = btn.AbsolutePosition + btn.AbsoluteSize/2
            firesignal(UIS.InputBegan, {UserInputType=Enum.UserInputType.MouseButton1, Position=pos})
            task.wait(0.05)
            firesignal(UIS.InputEnded, {UserInputType=Enum.UserInputType.MouseButton1, Position=pos})
        end)
        return true
    end
    -- Fallback ke remote jika tombol tidak ada
    if autoRF then
        pcall(function() autoRF:InvokeServer(true) end)
        task.wait(0.1)
        pcall(function() autoRF:InvokeServer(false) end)
        return true
    end
    return false
end

-- Pemicu periodik setiap 30 detik (cukup 2x toggle)
spawn(function()
    while true do
        task.wait(30)
        send("🔄 Menyegarkan bug: toggle auto...")
        for i = 1, 2 do
            toggleAuto()
            task.wait(0.3)
        end
    end
end)

-- Monitoring Fill bar untuk memastikan bug aktif (opsional, jika Fill bisa ditemukan)
local function findPetFills()
    local fills = {}
    for _, obj in pairs(WS:GetDescendants()) do
        if obj:IsA("BillboardGui") and obj.Name == "PetFishingStatus" then
            local fill = obj:FindFirstChild("Frame") and obj.Frame:FindFirstChild("Fill")
            if fill then
                local petModel = obj.Parent
                table.insert(fills, {Name = petModel and petModel.Name or "Unknown", Fill = fill})
            end
        end
    end
    return fills
end

task.wait(2)
local fills = findPetFills()
if #fills > 0 then
    send("🐾 Ditemukan " .. #fills .. " pet Fill bar. Memonitor lompatan cooldown...")
    local lastScales = {}
    for _, f in ipairs(fills) do lastScales[f.Fill] = f.Fill.Size.X.Scale end
    spawn(function()
        while true do
            for _, f in ipairs(fills) do
                if f.Fill.Parent then
                    local scale = f.Fill.Size.X.Scale
                    local last = lastScales[f.Fill]
                    if math.abs(scale - last) > 0.2 and last > 0.1 then
                        send("🚨 Lompatan terdeteksi pada " .. f.Name .. ": " .. string.format("%.2f", last) .. " -> " .. string.format("%.2f", scale))
                    end
                    lastScales[f.Fill] = scale
                end
            end
            task.wait(0.3)
        end
    end)
else
    send("⚠️ Tidak bisa menemukan Fill bar pet. Monitoring visual tidak aktif.")
end

send("✅ Script berjalan. Bug akan dipertahankan dengan toggle setiap 30 detik.")
