-- 1. Cari SEMUA model di Workspace yang memiliki BillboardGui bernama "PetFishingStatus"
local petModels = {}
for _, model in pairs(WS:GetChildren()) do
    if model:IsA("Model") then
        local gui = model:FindFirstChild("PetFishingStatus")
        if gui and gui:IsA("BillboardGui") then
            table.insert(petModels, model)
            send("🐾 Ditemukan pet dengan status: " .. model.Name)
            -- Dump semua turunan di dalam BillboardGui
            local dump = ""
            for _, child in pairs(gui:GetDescendants()) do
                dump = dump .. child.Name .. " [" .. child.ClassName .. "] "
                if child:IsA("Frame") or child:IsA("ImageLabel") then
                    dump = dump .. "Size=" .. tostring(child.Size) .. " "
                end
                if child:IsA("TextLabel") then
                    dump = dump .. "Text='" .. child.Text .. "' "
                end
                dump = dump .. "\n"
            end
            if #dump > 0 then send("```\n" .. dump .. "\n```") end
        end
    end
end

if #petModels == 0 then
    send("❌ Tidak ada pet dengan BillboardGui PetFishingStatus ditemukan. Cek apakah pet benar-benar muncul di sampingmu.")
    -- Mungkin pet ada di folder lain?
    for _, folder in pairs(WS:GetChildren()) do
        if folder:IsA("Folder") then
            for _, model in pairs(folder:GetChildren()) do
                if model:IsA("Model") and model:FindFirstChild("PetFishingStatus") then
                    send("🐾 Ditemukan di folder " .. folder.Name .. ": " .. model.Name)
                end
            end
        end
    end
end

-- 2. Cari semua tombol yang mengandung kata "auto" di SEMUA ScreenGui
send("🔎 Mencari tombol 'Auto'...")
local autoButtons = {}
for _, gui in pairs(LP.PlayerGui:GetChildren()) do
    if gui:IsA("ScreenGui") then
        for _, obj in pairs(gui:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
