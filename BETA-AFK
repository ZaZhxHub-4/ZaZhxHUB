-- Fungsi kirim ke Discord (kompatibel Delta/CodeX)
local function sendDiscord(msg, title)
    local payload = {
        content = msg or "",
        embeds = title and {{
            title = title,
            description = msg,
            color = 0x00ff00
        }} or nil
    }
    local body = game:GetService("HttpService"):JSONEncode(payload)
    local ok, err = pcall(function()
        -- Gunakan http_request (lebih universal)
        if http_request then
            http_request({
                Url = webhook,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = body
            })
        elseif syn and syn.request then
            syn.request({
                Url = webhook,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = body
            })
        else
            -- fallback ke request (executor lama)
            request({
                Url = webhook,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = body
            })
        end
    end)
    if not ok then
        warn("Webhook gagal: " .. tostring(err))
    end
end

