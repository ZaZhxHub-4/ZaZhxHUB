-- // FULL MONITOR: Hook semua RemoteEvent & RemoteFunction di seluruh game
-- // Tidak ada filter, catat SEMUA panggilan ke Discord.
-- // Gunakan hookfunction jika assignment gagal.
local webhook = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"
local HS = game:GetService("HttpService")

local function send(msg)
    pcall(function()
        local body = HS:JSONEncode({content = "`" .. os.date("%H:%M:%S") .. "` " .. msg})
        if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif syn and syn.request then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        else request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body}) end
    end)
end

send("🔍 Full Monitor dimulai. Mencari semua remote dan memasang hook...")

-- Kumpulkan semua RemoteEvent dan RemoteFunction
local allRemotes = {}
for _, obj in pairs(game:GetDescendants()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        table.insert(allRemotes, obj)
    end
end

send("📋 Ditemukan " .. #allRemotes .. " remote. Memasang hook...")

-- Coba hook dengan assignment langsung, jika gagal gunakan hookfunction
local hooked = 0
for _, remote in ipairs(allRemotes) do
    local isEvent = remote:IsA("RemoteEvent")
    local success = false
    
    -- Metode 1: assignment langsung
    if isEvent then
        local ok, err = pcall(function()
            local old = remote.FireServer
            remote.FireServer = function(self, ...)
                local a = ""
                for i, v in ipairs({...}) do a = a .. tostring(v):sub(1,30) .. (i==#args and "" or ",") end
                send("📤 " .. remote:GetFullName() .. " FireServer(" .. a .. ")")
                return old(self, ...)
            end
        end)
        success = ok
    else
        local ok, err = pcall(function()
            local old = remote.InvokeServer
            remote.InvokeServer = function(self, ...)
                local a = ""
                for i, v in ipairs({...}) do a = a .. tostring(v):sub(1,30) .. (i==#args and "" or ",") end
                send("📤 " .. remote:GetFullName() .. " InvokeServer(" .. a .. ")")
                return old(self, ...)
            end
        end)
        success = ok
    end
    
    -- Metode 2: jika gagal, coba hookfunction
    if not success and hookfunction then
        pcall(function()
            if isEvent then
                hookfunction(remote.FireServer, function(...)
                    local a = ""
                    for i, v in ipairs({...}) do a = a .. tostring(v):sub(1,30) .. (i==#args and "" or ",") end
                    send("📤 " .. remote:GetFullName() .. " FireServer(" .. a .. ")")
                    return hookfunction.old(...)
                end)
            else
                hookfunction(remote.InvokeServer, function(...)
                    local a = ""
                    for i, v in ipairs({...}) do a = a .. tostring(v):sub(1,30) .. (i==#args and "" or ",") end
                    send("📤 " .. remote:GetFullName() .. " InvokeServer(" .. a .. ")")
                    return hookfunction.old(...)
                end)
            end
        end)
    end
    
    hooked = hooked + 1
end

send("✅ Hook terpasang pada " .. hooked .. " remote. Sekarang jalankan LYNX dan lakukan triknya. Semua panggilan akan terekam.")
