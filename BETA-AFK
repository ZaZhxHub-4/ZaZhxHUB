-- ========== EQUIP ROD ==========
local function equipRod()
    if equipRE then
        pcall(function() equipRE:FireServer(1) end)
    else
        local hotbar = LP.PlayerGui:FindFirstChild("Backpack")
        if hotbar then
            local slot1 = hotbar:FindFirstChild("1") or hotbar:FindFirstChild("Slot1")
            if slot1 and slot1:IsA("ImageButton") then
                pcall(function()
                    local pos = slot1.AbsolutePosition + slot1.AbsoluteSize/2
                    firesignal(UIS.InputBegan, {UserInputType = Enum.UserInputType.MouseButton1, Position = pos})
                    task.wait(0.03)
                    firesignal(UIS.InputEnded, {UserInputType = Enum.UserInputType.MouseButton1, Position = pos})
                end)
            end
        end
    end
end

-- ========== FAST REEL CYCLE (ULTRA CEPAT) ==========
-- Charge > minigame > catch tanpa cancel, tanpa delay antar siklus
local function fastReelCycle()
    -- Charge rod (langsung, tanpa delay)
    pcall(function() chargeRF:InvokeServer(1755848498.4834) end)
    -- Minigame start (hampir bersamaan)
    pcall(function() minigameRF:InvokeServer(1.2854545116425, 1) end)
    -- Tunggu waktu minimum agar ikan tergigit (bisa diadjust)
    task.wait(config.minigameDelay)
    -- Catch ikan
    for i = 1, config.catchCount do
        pcall(function() catchRE:FireServer() end)
        -- tanpa delay catch jika count = 1
    end
end

local function startFastReel()
    if config.fastReelActive then return end
    equipRod()
    task.wait(0.1)
    config.fastReelActive = true
    fastReelThread = task.spawn(function()
        while config.fastReelActive do
            fastReelCycle()
            -- langsung looping tanpa jeda (loopInterval 0)
            -- tapi beri sedikit napas agar tidak overload
            if config.loopInterval > 0 then
                task.wait(config.loopInterval)
            end
        end
    end)
end

local function stopFastReel()
    config.fastReelActive = false
    if fastReelThread then task.cancel(fastReelThread); fastReelThread = nil end
end

-- ========== PET BUG TRIGGER (TIDAK MENGGANGGU FAST REEL) ==========
-- Kirim toggle auto TAPI kita hentikan dulu fast reel sejenak? Tidak.
-- Solusi: gunakan markAuto saja (reset cooldown internal) tanpa toggle state.
-- Jika markAuto tidak cukup, kita toggle dengan jeda yang sangat pendek.
local function triggerPetBug()
    -- Coba dulu hanya mark auto (jika ada)
    if markAutoRF then
        pcall(function() markAutoRF:InvokeServer() end)
    end
    -- Jika autoStateRF tersedia, kita toggle dengan cepat tapi hanya 1x ON-OFF
    if autoStateRF then
        -- Pastikan state OFF dulu
        pcall(function() autoStateRF:InvokeServer(false) end)
        task.wait(0.02)
        -- ON sekejap
        pcall(function() autoStateRF:InvokeServer(true) end)
        task.wait(0.02)
        -- OFF lagi
        pcall(function() autoStateRF:InvokeServer(false) end)
    end
end

local function startPetBug()
    if config.petBugActive then return end
    config.petBugActive = true
    petBugThread = task.spawn(function()
        while config.petBugActive do
            triggerPetBug()
            task.wait(config.petBugInterval)
        end
    end)
end

local function stopPetBug()
    config.petBugActive = false
    if petBugThread then task.cancel(petBugThread); petBugThread = nil end
end

