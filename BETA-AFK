-- Fungsi kirim log ke Discord
local function sendLog(msg)
    local payload = {
        content = "```lua\n" .. tostring(msg) .. "\n```"
    }
    local body = game:GetService("HttpService"):JSONEncode(payload)
    local suc, err = pcall(function()
        syn.request({
            Url = webhook,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = body
        })
    end)
    if not suc then
        warn("Gagal kirim webhook: " .. err)
    end
end

