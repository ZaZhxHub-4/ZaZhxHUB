local function sendLong(msg, title)
    local maxLen = 1900
    local chunk = ""
    local function flush()
        if chunk ~= "" then
            pcall(function()
                local body = game:GetService("HttpService"):JSONEncode({content = chunk})
                if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
                elseif syn and syn.request then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
                else request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
                end
            end)
            chunk = ""
        end
    end
    if title then
        sendLong("**" .. title .. "**")
    end
    for line in msg:gmatch("[^\r\n]+") do
        if #chunk + #line + 5 > maxLen then
            flush()
        end
        chunk = chunk .. line .. "\n"
    end
    flush()
end

local RS = game:GetService("ReplicatedStorage")
local function getSource(module)
    -- ModuleScript source via getsenv atau debug.getinfo (executor harus support)
    local success, source = pcall(function()
        return getsenv(module).script.Source -- alternatif
    end)
    if not success or not source then
        -- fallback: coba loadstring
        success, source = pcall(function()
            return module.Source
        end)
    end
    if not success then
        -- coba debug.getconstant
        pcall(function()
            local constants = debug.getconstants(module)
            source = table.concat(constants, "\n")
        end)
    end
    return tostring(source)
end

-- Modul yang ingin diperiksa
local modules = {"Pets", "CmdrClient", "FishingRodModifiers", "FishWeightChances"}
for _, name in ipairs(modules) do
    local mod = RS:FindFirstChild(name)
    if mod and mod:IsA("ModuleScript") then
        local src = getSource(mod)
        if src and #src > 10 then
            sendLong(src, "📄 " .. name .. " source")
        else
            sendLong("Tidak bisa membaca source " .. name .. " (mungkin dikaburkan).", "⚠️ " .. name)
        end
    end
end

