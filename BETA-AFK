-- // Instant Fast Reel + Pet Bug Trigger
-- // Meniru metode Lynx: spam cancel -> charge -> minigame -> catch
-- // Menggunakan akses remote hash (seperti Auto Booth script)
-- // Tidak ada hook, hanya memanggil remote.

local webhook = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"
local HS = game:GetService("HttpService")
local RS = game:GetService("ReplicatedStorage")

local function send(msg)
    pcall(function()
        local body = HS:JSONEncode({content = "`" .. os.date("%H:%M:%S") .. "` " .. msg})
        if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif syn and syn.request then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        else request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body}) end
    end)
end

-- Fungsi mencari remote berdasarkan label folder (seperti di Auto Booth)
local function findRemoteByLabel(label)
    local net = RS.Packages._Index["sleitnick_net@0.2.0"].net
    local children = net:GetChildren()
    for i, child in ipairs(children) do
        if child.Name == label then
            -- cari di dalam folder label dulu
            local inside = child:FindFirstChildOfClass("RemoteFunction") or child:FindFirstChildOfClass("RemoteEvent")
            if inside then
                local h = inside.Name:match("^R[FE]/([a-fA-F0-9]+)$")
                if h and #h == 64 then return inside end
            end
            -- cari di indeks berikutnya
            local nxt = children[i+1]
            if nxt and (nxt:IsA("RemoteFunction") or nxt:IsA("RemoteEvent")) then
                local h = nxt.Name:match("^R[FE]/([a-fA-F0-9]+)$")
                if h and #h == 64 then return nxt end
            end
            break
        end
    end
    return nil
end

send("🔍 Mencari remote untuk Fast Reel...")

local cancelRF = findRemoteByLabel("RF/CancelFishingInputs")
local chargeRF = findRemoteByLabel("RF/ChargeFishingRod")
local minigameRF = findRemoteByLabel("RF/RequestFishingMinigameStarted")
local catchRE = findRemoteByLabel("RE/CatchFishCompleted") or findRemoteByLabel("RE/FishCaught")

if not cancelRF or not chargeRF or not minigameRF or not catchRE then
    send("❌ Remote tidak lengkap: Cancel="..tostring(cancelRF).." Charge="..tostring(chargeRF).." Minigame="..tostring(minigameRF).." Catch="..tostring(catchRE))
    return
end

send("✅ Remote ditemukan. Memulai Instant Fast Reel...")

-- Parameter dari Auto Fish V4
local chargeParam = 1755848498.4834
local minigameParam1 = 1.2854545116425
local minigameParam2 = 1

-- Fungsi satu siklus fast reel
local function fastReelCycle()
    -- Cancel dulu untuk reset
    pcall(function() cancelRF:InvokeServer() end)
    task.wait(0.01)

    -- Charge rod
    pcall(function() chargeRF:InvokeServer(chargeParam) end)
    task.wait(0.01)

    -- Mulai minigame
    pcall(function() minigameRF:InvokeServer(minigameParam1, minigameParam2) end)
    task.wait(0.05) -- beri waktu sedikit sebelum catch

    -- Tangkap ikan langsung (beberapa kali untuk memastikan)
    for i = 1, 3 do
        pcall(function() catchRE:FireServer() end)
        task.wait(0.01)
    end
end

-- Loop fast reel agresif (setiap 0.3 detik)
spawn(function()
    while true do
        fastReelCycle()
        task.wait(0.3)
    end
end)

send("⚡ Fast Reel aktif. Amati pet, seharusnya ikut terpancing bug.")
