-- Fungsi untuk memindai semua descendants dan mencari remote/keywords
local function scanRemote(parent, depth, results)
    if depth > 8 then return end
    for _, obj in ipairs(parent:GetChildren()) do
        local fullName = obj:GetFullName()
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(results, {type=obj.ClassName, name=obj.Name, path=fullName})
        end
        -- rekursi ke folder/model
        if obj:IsA("Folder") or obj:IsA("Model") or obj:IsA("Configuration") then
            scanRemote(obj, depth+1, results)
        end
    end
end

local foundRemotes = {}
scanRemote(game, 0, foundRemotes)

-- Filter yang mengandung kata kunci
local keywords = {"fish", "pet", "auto", "cast", "reel", "catch", "hook", "bait"}
local filtered = {}
for _, r in ipairs(foundRemotes) do
    local lower = r.name:lower()
    for _, kw in ipairs(keywords) do
        if lower:find(kw) then
            table.insert(filtered, r)
            break
        end
    end
end

-- Kirim semua remote (maks 1900 karakter per pesan)
