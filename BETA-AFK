-- Monitoring Fill bar untuk deteksi lompatan
local function monitorPets()
    local pets = {}
    -- Cari semua pet model yang memiliki PetFishingStatus
    for _, model in pairs(WS:GetChildren()) do
        if model:IsA("Model") then
            local gui = model:FindFirstChild("PetFishingStatus")
            if gui then
                local fill = gui:FindFirstChild("Frame") and gui.Frame:FindFirstChild("Fill")
                if fill and fill:IsA("Frame") then
                    table.insert(pets, {
                        Name = model.Name,
                        Fill = fill,
                        LastScale = fill.Size.X.Scale,
                        StartTime = nil,
                        ExpectedDuration = 22 -- default
                    })
                    send("🐾 Monitoring " .. model.Name .. " (Fill bar siap)")
                end
            end
        end
    end

    if #pets == 0 then
        send("❌ Tidak ada pet dengan Fill bar. Monitoring tidak berjalan.")
        return
    end

    spawn(function()
        while true do
            local now = tick()
            for _, pet in pairs(pets) do
                if pet.Fill and pet.Fill.Parent then
                    local scale = pet.Fill.Size.X.Scale
                    local lastScale = pet.LastScale
                    if math.abs(scale - lastScale) > 0.001 then
                        local delta = scale - lastScale
                        if delta > 0.3 and lastScale > 0.1 then
                            send("🚨 LOMPAT BESAR " .. pet.Name .. ": " .. string.format("%.2f", lastScale) .. " -> " .. string.format("%.2f", scale))
                            if pet.StartTime then
                                local elapsed = now - pet.StartTime
                                send("⏱️ " .. pet.Name .. " selesai dalam " .. string.format("%.2f", elapsed) .. "s (expected " .. pet.ExpectedDuration .. "s)")
                                pet.StartTime = nil
                            end
                        end
                        if pet.StartTime == nil and scale < 0.05 and lastScale == 0 then
                            pet.StartTime = now
                        end
                        if scale > 0.99 and pet.StartTime then
                            local elapsed = now - pet.StartTime
                            send("✅ " .. pet.Name .. " selesai normal " .. string.format("%.2f", elapsed) .. "s")
                            pet.StartTime = nil
                        end
                        pet.LastScale = scale
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end

-- Jalankan monitoring setelah 2 detik (beri waktu pet muncul)
task.wait(2)
monitorPets()

send("✅ Script siap. Race condition berjalan, pantau Discord untuk lompatan cooldown.")
