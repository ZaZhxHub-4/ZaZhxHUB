local function clickButton(btn)
    if not btn then return end
    pcall(function()
        local pos = btn.AbsolutePosition + btn.AbsoluteSize/2
        -- Simulasi klik yang lebih "agresif" agar terdeteksi game
        -- Beberapa game hanya merespon fireproximityprompt atau firesignal, kita coba fireclickbutton dulu
        if fireclickbutton then
            fireclickbutton(btn)
        else
            firesignal(UIS.InputBegan, {UserInputType=Enum.UserInputType.MouseButton1, Position=pos})
            task.wait(0.03)
            firesignal(UIS.InputEnded, {UserInputType=Enum.UserInputType.MouseButton1, Position=pos})
        end
    end)
end

