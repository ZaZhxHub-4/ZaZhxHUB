-- Pindai struktur folder penting
local function dumpFolderStructure(parent, depth, output)
    local indent = string.rep("  ", depth)
    for _, child in ipairs(parent:GetChildren()) do
        local info = indent .. child.Name .. " (" .. child.ClassName .. ")"
        table.insert(output, info)
        if child:IsA("Folder") or child:IsA("Model") then
            if #child:GetChildren() > 0 and depth < 4 then
                dumpFolderStructure(child, depth+1, output)
            end
        end
    end
end

