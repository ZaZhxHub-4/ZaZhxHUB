-- Cari folder/remote yang mengatur pet/fishing (sesuaikan dengan struktur game)
-- Biasanya di ReplicatedStorage ada remotes seperti FishingSystem, PetSystem, dll.
local remotes = {}
local function scanRemotes(parent, depth)
    if depth > 5 then return end
    for _, obj in pairs(parent:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(remotes, obj)
            sendLog("Ditemukan remote: " .. obj:GetFullName())
        end
        if obj:IsA("Folder") or obj:IsA("Model") then
            scanRemotes(obj, depth+1)
        end
    end
end
