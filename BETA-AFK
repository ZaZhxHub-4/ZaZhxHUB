-- ------------------------------------------------------------
-- BAGIAN 3: Monitoring Fill Bar + Deteksi Lompatan + Catat Durasi
-- ------------------------------------------------------------
local pets = {}
for _, model in pairs(WS:GetChildren()) do
    if model:IsA("Model") then
        local gui = model:FindFirstChild("PetFishingStatus")
        if gui then
            local fill = gui.Frame.Fill
            local label = gui.Frame.Label
            if fill then
                table.insert(pets, {
                    Name = model.Name,
                    Fill = fill,
                    Label = label,
                    LastScale = fill.Size.X.Scale,
                    StartTime = nil,
                    ExpectedDuration = model.Name == "Axolotl" and 22 or 22 -- default
                })
                send("🐾 Monitoring " .. model.Name .. " (expected ~22s)")
            end
        end
    end
end

spawn(function()
    while true do
        local now = tick()
        for _, pet in pairs(pets) do
            if pet.Fill and pet.Fill.Parent then
                local scale = pet.Fill.Size.X.Scale
                local lastScale = pet.LastScale
                if scale ~= lastScale then
                    -- Deteksi lompatan besar (skip cooldown)
                    local delta = scale - lastScale
                    if delta > 0.2 and lastScale > 0.1 then
                        send("🚨 LOMPAT BESAR " .. pet.Name .. ": " .. string.format("%.2f", lastScale) .. " -> " .. string.format("%.2f", scale))
                        if pet.StartTime then
                            local elapsed = now - pet.StartTime
                            send("⏱️ " .. pet.Name .. " selesai dalam " .. string.format("%.2f", elapsed) .. "s (expected " .. pet.ExpectedDuration .. "s)")
                            pet.StartTime = nil
                        end
                    end

                    -- Mulai timer jika fill baru naik dari nol
                    if pet.StartTime == nil and lastScale == 0 and scale > 0.01 then
                        pet.StartTime = now
                        send("🕐 " .. pet.Name .. " mulai memancing.")
                    end

                    -- Selesai jika fill penuh (scale > 0.99)
                    if scale > 0.99 and pet.StartTime then
                        local elapsed = now - pet.StartTime
                        send("✅ " .. pet.Name .. " selesai normal dalam " .. string.format("%.2f", elapsed) .. "s")
                        pet.StartTime = nil
                    end

                    pet.LastScale = scale
                end
            end
        end
        task.wait(0.15)
    end
end)

