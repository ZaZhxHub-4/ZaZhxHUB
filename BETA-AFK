    local line = string.format("[%d] %s %s\n", i, r.type, r.path)
    if #msg + #line > 1900 then
        msg = msg .. "```"
        sendDiscord(msg)
        msg = "```\n"
    end
    msg = msg .. line
end
if msg ~= "```\n" then
