-- // Jika game menggunakan Fill bar sebagai trigger server, ini akan menghasilkan tangkapan instan.
local webhook = "https://discordapp.com/api/webhooks/1450517804037046508/yi2ZuXEbsPhSQU6MaJ2fgmvm4YPGSz1G0q1oHpApUiYpRrDFCAd1-kuYC4q0sxZ8YOKY"
local HS = game:GetService("HttpService")
local WS = game:GetService("Workspace")

local function send(msg)
    pcall(function()
        local body = HS:JSONEncode({content = "`" .. os.date("%H:%M:%S") .. "` " .. msg})
        if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif syn and syn.request then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        else request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body}) end
    end)
end

send("⚡ DIRECT FILL EXPLOIT AKTIF: Memaksa semua pet menyelesaikan fishing setiap 0.3 detik...")

-- Kumpulkan semua Fill bar
local fills = {}
for _, model in pairs(WS:GetChildren()) do
    if model:IsA("Model") then
        pcall(function()
            local fill = model.PetFishingStatus.Frame.Fill
            if fill and fill:IsA("Frame") then
                table.insert(fills, {Name = model.Name, Fill = fill})
                send("🐾 Ditemukan " .. model.Name .. " Fill, siap exploit.")
            end
        end)
    end
end

if #fills == 0 then
    send("❌ Tidak ada pet Fill bar. Pastikan pet muncul.")
    return
end

-- Loop exploit
spawn(function()
    while true do
        for _, pet in ipairs(fills) do
            pcall(function()
                if pet.Fill and pet.Fill.Parent then
                    -- Set Fill ke 100% (scale X = 1)
                    pet.Fill.Size = UDim2.new(1, 0, 1, 0)
                    -- Trigger sinyal Changed untuk memastikan game mendeteksi
                    local changed = pet.Fill.Changed
                    changed:Fire(pet.Fill, "Size")
                end
            end)
        end
        task.wait(0.3)
    end
end)

