local oldRequire = require
local function hookedRequire(module)
    log("📚 require: " .. tostring(module))
    local result = oldRequire(module)
    -- Jika result adalah table, kita bisa hook fungsi-fungsi di dalamnya (nanti kita kembangkan)
    return result
end
require = hookedRequire

