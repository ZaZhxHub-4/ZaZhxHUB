-- Fungsi untuk mencari semua pet milik LocalPlayer dari data game
local function getOwnedPets()
    -- Bisa dari LocalPlayer.PlayerScripts.PetData atau semacamnya
    local player = LocalPlayer
    local petDataModule = player:FindFirstChild("PetData") or player.PlayerScripts:FindFirstChild("PetData")
    if petDataModule and petDataModule.Value then
        return petDataModule.Value -- asumsi berisi table
    end
    -- Fallback: lewat remote GetOwnedPets
    local getPetsRemote = ReplicatedStorage:FindFirstChild("GetPets")
    if getPetsRemote then
        local pets = getPetsRemote:InvokeServer()
        return pets
    end
    return {}
end

