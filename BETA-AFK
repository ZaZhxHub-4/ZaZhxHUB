local netFolder = RS.Packages._Index["sleitnick_net@0.2.0"].net
local keywords = {"Fish","Pet","Auto","Fishing","Catch","Bait","Minigame","Reel","Cast","Finish","Complete","Cooldown","Update","State","Mark","Cancel"}

for _, obj in pairs(netFolder:GetDescendants()) do
    if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then
        local name = obj.Name
        local lower = name:lower()
        for _, kw in ipairs(keywords) do
            if lower:find(kw:lower()) then
                if obj:IsA("RemoteEvent") then
                    pcall(function()
                        local old = obj.FireServer
                        obj.FireServer = function(self, ...)
                            local args = {...}
                            local astr = ""
                            for i, v in ipairs(args) do astr = astr .. tostring(v):sub(1,30) .. (i==#args and "" or ", ") end
                            send("📤 " .. name .. "(" .. astr .. ")")
                            return old(self, ...)
                        end
                    end)
                elseif obj:IsA("RemoteFunction") then
                    pcall(function()
                        local old = obj.InvokeServer
                        obj.InvokeServer = function(self, ...)
                            local args = {...}
                            local astr = ""
                            for i, v in ipairs(args) do astr = astr .. tostring(v):sub(1,30) .. (i==#args and "" or ", ") end
                            send("📤 " .. name .. "(" .. astr .. ")")
                            return old(self, ...)
                        end
                    end)
                end
                break
            end
        end
    end
end

