-- Variabel untuk tracking cooldown
local petCooldownData = {} -- {petName: {lastStart, expectedDuration, actualDuration, bugCount}}
local function recordPetStart(petName, expectedDuration)
    petCooldownData[petName] = {
        lastStart = tick(),
        expected = expectedDuration,
        started = true
    }
end
local function recordPetEnd(petName)
    local data = petCooldownData[petName]
    if not data or not data.started then return end
    local actual = tick() - data.lastStart
    data.actual = actual
    data.started = false
    local info = ("[%s] Cooldown seharusnya: %.1fs, Real: %.1fs, Selisih: %.1fs"):format(petName, data.expected, actual, data.expected - actual)
    sendLog(info)
    if actual < data.expected * 0.8 then
        sendLog("BUG TERDETEKSI pada " .. petName .. "! Cooldown lebih cepat dari seharusnya!")
        data.bugCount = (data.bugCount or 0) + 1
    end
    -- Jika actual sangat kecil (<1 detik) berarti exploit max speed mungkin terjadi
    if actual < 1 then
        sendLog("EXPLOIT POTENSIAL: " .. petName .. " menyelesaikan dalam <1 detik!")
    end
end

