-- Loop monitoring: deteksi otomatis saat pet mulai fishing dengan melihat UI
local function monitorUI()
    if not petUI then return end
    -- Asumsikan ada ProgressBar untuk setiap pet, dengan nama PetName_Cooldown
    for _, child in pairs(petUI:GetDescendants()) do
        if child:IsA("Frame") then -- container pet
            local petName = child.Name
            local cdBar = child:FindFirstChild("Cooldown") or child:FindFirstChild("Progress")
            if cdBar and cdBar:IsA("GuiObject") then
                local txtLabel = child:FindFirstChild("PetName") or child:FindFirstChild("Title")
                if txtLabel then petName = txtLabel.Text end
                local barSize = cdBar.Size
                -- Deteksi jika bar mulai terisi (artinya fishing dimulai)
                if cdBar:GetAttribute("Active") then
                    recordPetStart(petName, tonumber(cdBar:GetAttribute("MaxDuration")))
                end
                -- Deteksi jika bar penuh (fishing selesai)
                if cdBar:GetAttribute("Completed") then
                    recordPetEnd(petName)
                end
            end
        end
    end
end

