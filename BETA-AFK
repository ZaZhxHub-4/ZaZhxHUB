-- 3. Polling GUI Fishing setiap 0.5 detik (monitor teks dan progres bar)
local fishingGUI = LP.PlayerGui:FindFirstChild("Fishing")
if fishingGUI then
    send("🎣 Memulai polling GUI Fishing...")
    -- Ambil snapshot awal semua label dan bar
    local tracked = {}
    for _, obj in pairs(fishingGUI:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("Frame") then
            tracked[obj] = {
                text = obj:IsA("TextLabel") and obj.Text or nil,
                size = obj.Size,
                pos = obj.Position,
                color = obj.BackgroundColor3
            }
        end
    end
    -- Loop deteksi perubahan
    spawn(function()
        while true do
            for obj, last in pairs(tracked) do
                if obj.Parent then
                    if obj:IsA("TextLabel") then
                        if obj.Text ~= last.text then
                            send("📝 GUI Text: " .. obj.Name .. " -> \"" .. obj.Text .. "\"")
                            last.text = obj.Text
                        end
                    end
                    if obj:IsA("Frame") and (obj.Name:lower():find("pet") or obj.Name:lower():find("cooldown")) then
                        if obj.Size ~= last.size then
                            send("📏 GUI Size: " .. obj.Name .. " -> " .. tostring(obj.Size))
                            last.size = obj.Size
                        end
                    end
                else
                    tracked[obj] = nil
                end
            end
            task.wait(0.5)
        end
    end)
else
    send("❌ GUI Fishing tidak ditemukan.")
end

-- 4. Polling Workspace untuk objek pet (Axolotl, Otter, dll)
local petModels = {}
for _, obj in pairs(WS:GetChildren()) do
    if obj:IsA("Model") and obj.Name:lower():find("pet") or obj.Name:lower():find("axolotl") or obj.Name:lower():find("otter") then
        table.insert(petModels, obj)
        send("🐾 Pet model ditemukan: " .. obj.Name)
    end
end

if #petModels > 0 then
    spawn(function()
        while true do
            for _, pet in pairs(petModels) do
                -- cek apakah ada humanoid yang sedang animasi memancing
                local hum = pet:FindFirstChildOfClass("Humanoid")
                if hum then
                    send("🤖 " .. pet.Name .. " Humanoid state: " .. tostring(hum.MoveDirection))
                end
            end
            task.wait(1)
        end
    end)
else
