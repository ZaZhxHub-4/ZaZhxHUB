-- Monitoring Fill bar (dengan pencarian ulang berkala)
local fills = {}
local function findFills()
    fills = {}
    for _, obj in pairs(WS:GetDescendants()) do
        if obj:IsA("BillboardGui") and obj.Name == "PetFishingStatus" then
            local fill = obj:FindFirstChild("Frame") and obj.Frame:FindFirstChild("Fill")
            if fill then
                local petModel = obj.Parent
                local name = petModel and petModel.Name or "Unknown"
                fills[#fills + 1] = {Name = name, Fill = fill, LastScale = fill.Size.X.Scale, StartTime = nil}
            end
        end
    end
    if #fills > 0 then
        send("🐾 Ditemukan " .. #fills .. " pet Fill bar untuk monitoring.")
    end
end

-- Cari fill setiap 5 detik sampai ketemu
spawn(function()
    while #fills == 0 do
        findFills()
        task.wait(5)
    end
    -- Mulai monitoring
    while true do
        local now = tick()
        for _, pet in pairs(fills) do
            if pet.Fill and pet.Fill.Parent then
                local scale = pet.Fill.Size.X.Scale
                local last = pet.LastScale
                if math.abs(scale - last) > 0.001 then
                    local delta = scale - last
                    if delta > 0.2 and last > 0.1 then
                        send("🚨 LOMPAT " .. pet.Name .. ": " .. string.format("%.2f", last) .. " -> " .. string.format("%.2f", scale))
                        if pet.StartTime then
                            local elapsed = now - pet.StartTime
                            send("⏱️ " .. pet.Name .. " selesai dalam " .. string.format("%.2f", elapsed) .. "s (seharusnya 22s)")
                            pet.StartTime = nil
                        end
                    end
                    if pet.StartTime == nil and scale < 0.05 and last == 0 then
                        pet.StartTime = now
                    end
                    if scale > 0.99 and pet.StartTime then
                        local elapsed = now - pet.StartTime
                        send("✅ " .. pet.Name .. " selesai normal " .. string.format("%.2f", elapsed) .. "s")
                        pet.StartTime = nil
                    end
                    pet.LastScale = scale
                end
            end
        end
        task.wait(0.2)
    end
end)

