-- // CUTSCENE SPAMMER untuk memicu Race Condition pada Pet Fishing
-- // Mencari dan memanggil remote/event terkait cutscene/efek tangkapan ikan langka

local RS = game:GetService("ReplicatedStorage")
local net = RS.Packages._Index["sleitnick_net@0.2.0"].net

-- Cari remote yang berpotensi memicu cutscene
local cutsceneRemotes = {}
for _, obj in pairs(net:GetDescendants()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        local n = obj.Name:lower()
        if n:find("cutscene") or n:find("effect") or n:find("visual") or n:find("caught") or n:find("notification") or n:find("complete") then
            table.insert(cutsceneRemotes, obj)
        end
    end
end

if #cutsceneRemotes == 0 then
    -- Fallback: gunakan remote yang kita tahu bisa dipakai
    cutsceneRemotes = {
        net:FindFirstChild("RE/PlayFishingEffect"),
        net:FindFirstChild("RE/CaughtFishVisual"),
        net:FindFirstChild("RE/CatchFishCompleted")
    }
end

-- Fungsi spam cutscene
local function spamCutscene()
    for _, remote in ipairs(cutsceneRemotes) do
        if remote then
            pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer()
                else
                    remote:InvokeServer()
                end
            end)
        end
    end
end

-- Lakukan spam setiap 0.5 detik
while true do
    spamCutscene()
    task.wait(5.0)
end
