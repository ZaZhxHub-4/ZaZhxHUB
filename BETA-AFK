local function send(msg)
    pcall(function()
        local body = HS:JSONEncode({content = "`" .. os.date("%H:%M:%S") .. "` " .. tostring(msg)})
        if http_request then
            http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
