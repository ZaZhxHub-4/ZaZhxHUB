-- 3. Monitoring perubahan ukuran objek apa pun di dalam PetFishingStatus (polling 0.2s)
if #petModels > 0 then
    send("📏 Memulai monitoring perubahan ukuran pada bar cooldown...")
    local tracked = {}
    for _, model in pairs(petModels) do
        local gui = model.PetFishingStatus
        for _, obj in pairs(gui:GetDescendants()) do
            if obj:IsA("Frame") or obj:IsA("ImageLabel") then
                tracked[obj] = {lastSize = obj.Size, pet = model.Name}
            end
        end
    end

    spawn(function()
        while true do
            for obj, data in pairs(tracked) do
                if obj.Parent then
                    if obj.Size ~= data.lastSize then
                        send("📊 " .. data.pet .. " | " .. obj.Name .. " Size: " .. tostring(data.lastSize) .. " -> " .. tostring(obj.Size))
                        data.lastSize = obj.Size
                        -- Deteksi jika ukuran mendekati penuh (X scale > 0.9)
                        if obj.Size.X.Scale > 0.9 and data.lastSize.X.Scale <= 0.9 then
                            send("⏱️ " .. data.pet .. " bar penuh terdeteksi!")
                        end
                    end
                else
                    tracked[obj] = nil
                end
            end
            task.wait(0.2)
        end
    end)
end

