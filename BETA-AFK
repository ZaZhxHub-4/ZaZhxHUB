-- 1. Hook Instance.new untuk menangkap objek baru
local oldNew = Instance.new
local function hookNew(className, parent)
    local obj = oldNew(className, parent)
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("BindableEvent") or obj:IsA("BindableFunction") then
        log("🆕 Instance baru: " .. className .. " - " .. tostring(obj.Name) .. " di " .. tostring(parent))
        -- Hook fungsi komunikasi pada objek baru
        if obj:IsA("RemoteEvent") then
            local oldFire = obj.FireServer
            obj.FireServer = function(self, ...)
                log("📤 [RemoteEvent:FireServer] " .. self.Name .. " args: " .. table.concat({...}, ", "))
                return oldFire(self, ...)
            end
        elseif obj:IsA("RemoteFunction") then
            local oldInvoke = obj.InvokeServer
            obj.InvokeServer = function(self, ...)
                log("📤 [RemoteFunction:InvokeServer] " .. self.Name .. " args: " .. table.concat({...}, ", "))
                return oldInvoke(self, ...)
            end
        elseif obj:IsA("BindableEvent") then
            local oldFire = obj.Fire
            obj.Fire = function(self, ...)
                log("🔗 [BindableEvent:Fire] " .. self.Name .. " args: " .. table.concat({...}, ", "))
                return oldFire(self, ...)
            end
        elseif obj:IsA("BindableFunction") then
            local oldInvoke = obj.Invoke
            obj.Invoke = function(self, ...)
                log("🔗 [BindableFunction:Invoke] " .. self.Name .. " args: " .. table.concat({...}, ", "))
                return oldInvoke(self, ...)
            end
        end
    end
    return obj
end
Instance.new = hookNew

