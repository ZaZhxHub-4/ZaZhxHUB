local HS = game:GetService("HttpService")
local RS = game:GetService("ReplicatedStorage")
local LP = game:GetService("Players").LocalPlayer

local function send(msg)
    pcall(function()
        local body = HS:JSONEncode({content = "`" .. os.date("%H:%M:%S") .. "` " .. msg})
        if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif syn and syn.request then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        else request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body}) end
    end)
end

send("🔎 Mencari Remote Fishing/Pets di dalam sleitnick_net...")

-- Dapatkan folder net
local netFolder
pcall(function()
    netFolder = RS.Packages._Index["sleitnick_net@0.2.0"].net
end)
if not netFolder then
    -- Mungkin nama berbeda, cari manual
    for _, obj in pairs(RS.Packages._Index:GetChildren()) do
        if obj.Name:find("sleitnick_net") then
            netFolder = obj.net
            break
        end
    end
end

if not netFolder then
    send("❌ Folder sleitnick_net tidak ditemukan!")
    return
end

-- Kumpulkan semua RemoteEvent/Function di dalam netFolder
local allRemotes = {}
local function scan(parent, depth)
    if depth > 5 then return end
    for _, child in pairs(parent:GetChildren()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            table.insert(allRemotes, child)
        end
        if child:IsA("Folder") then
            scan(child, depth+1)
        end
    end
end
scan(netFolder, 0)

send("📋 Total Remote di net: " .. #allRemotes)

-- Cari yang mengandung keyword fishing/pet
local keywords = {"fish", "pet", "cast", "reel", "catch", "hook", "bait", "auto", "cooldown", "end", "start"}
local targets = {}
for _, remote in ipairs(allRemotes) do
    local nameLower = remote.Name:lower()
    for _, kw in ipairs(keywords) do
        if nameLower:find(kw) then
            table.insert(targets, remote)
            send("🎯 Ditemukan: " .. remote.Name .. " (" .. remote.ClassName .. ") | Path: " .. remote:GetFullName())
            break
        end
    end
end

if #targets == 0 then
    send("❌ Tidak ada remote fishing/pet ditemukan. Mencetak semua nama remote:")
    local list = {}
    for _, r in ipairs(allRemotes) do
        table.insert(list, r.Name)
    end
    send(table.concat(list, "\n"))
    return
end

send("🔥 Menyiapkan exploit: akan mencoba memanggil Remote 'EndFishing' untuk semua pet setiap 0.5 detik...")

-- Cari remote yang namanya mengandung "end" atau "finish"
local endRemote
for _, r in ipairs(targets) do
    if r.Name:lower():find("end") or r.Name:lower():find("finish") then
        endRemote = r
        send("🚀 Menggunakan Remote: " .. r.Name .. " untuk mempercepat fishing.")
        break
    end
end

if not endRemote then
    -- Cari remote apa saja yang mungkin menjadi pengganti
    send("⚠️ Tidak ada remote End. Mencoba remote lain yang mungkin (Start/Cast/Toggle)...")
    for _, r in ipairs(targets) do
        send("-> " .. r.Name)
    end
    -- Mungkin pet fishing dimulai/diakhiri via server otomatis tanpa remote khusus.
    -- Kita bisa coba kirim sinyal dengan nama pet ke remote yang ada, atau kita perlu melihat lebih dalam modul.
    return
end

