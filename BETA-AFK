local HS = game:GetService("HttpService")
local WS = game:GetService("Workspace")
local LP = game:GetService("Players").LocalPlayer
local UIS = game:GetService("UserInputService")

local function send(msg)
    pcall(function()
        local body = HS:JSONEncode({content = "`" .. os.date("%H:%M:%S") .. "` " .. msg})
        if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif syn and syn.request then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        else request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body}) end
    end)
end

send("🔍 Memulai monitoring pet khusus (ArcticFox, Axolotl, Penguin, Capybara)...")

-- Daftar pet yang bisa memancing
local fishingPets = {"ArcticFox", "Axolotl", "Penguin", "Capybara"}

-- Temukan semua model pet di workspace dengan PetFishingStatus
local pets = {}
for _, model in pairs(WS:GetChildren()) do
    if model:IsA("Model") and fishingPets[model.Name] then
        local gui = model:FindFirstChild("PetFishingStatus")
        if gui and gui:IsA("BillboardGui") then
            local frame = gui:FindFirstChild("Frame")
            if frame then
                local fill = frame:FindFirstChild("Fill")
                local label = frame:FindFirstChild("Label")
                if fill then
                    table.insert(pets, {
                        Name = model.Name,
                        Gui = gui,
                        Fill = fill,
                        Label = label,
                        LastFillSize = fill.Size,
                        LastText = label and label.Text or "",
                        StartTime = nil,
                        ExpectedDuration = model.Name == "Penguin" and 35 or (model.Name == "Capybara" and 65 or 22)
                    })
                    send("✅ " .. model.Name .. " terdaftar (expected " .. (model.Name == "Penguin" and 35 or (model.Name == "Capybara" and 65 or 22)) .. "s)")
                end
            end
        end
    end
end

if #pets == 0 then
    send("❌ Tidak ada pet dengan skill memancing ditemukan. Pastikan pet sudah di-equip.")
    return
end

-- Cari tombol Auto-Fish di semua ScreenGui
local autoBtn = nil
for _, screenGui in pairs(LP.PlayerGui:GetChildren()) do
    if screenGui:IsA("ScreenGui") then
        for _, obj in pairs(screenGui:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                local text = obj:IsA("TextButton") and obj.Text or ""
                if text:lower():find("auto") then
                    autoBtn = obj
                    send("🎯 Tombol Auto ditemukan: " .. obj:GetFullName() .. " Text: " .. text)
                end
            end
        end
    end
end

if not autoBtn then
    send("⚠️ Tombol Auto tidak ditemukan. Cari manual: biasanya ada tombol bertuliskan 'Auto' di dekat mini-game.")
end

-- Fungsi klik tombol (simulasi)
local function clickButton(btn)
    if not btn then return end
    pcall(function()
        local pos = btn.AbsolutePosition + btn.AbsoluteSize/2
        firesignal(UIS.InputBegan, {
            UserInputType = Enum.UserInputType.MouseButton1,
            Position = pos,
            Delta = Vector2.new(0, 0)
        })
        task.wait(0.03)
        firesignal(UIS.InputEnded, {
            UserInputType = Enum.UserInputType.MouseButton1,
            Position = pos,
            Delta = Vector2.new(0, 0)
        })
    end)
end

-- Loop monitoring fill bar
spawn(function()
    while true do
        local now = tick()
        for _, pet in pairs(pets) do
            if pet.Fill and pet.Fill.Parent then
                local newSize = pet.Fill.Size
                local newText = pet.Label and pet.Label.Text or ""

                if newSize ~= pet.LastFillSize then
                    local scale = newSize.X.Scale
                    send(string.format("📊 %s Fill: %.0f%% (Text: %s)", pet.Name, scale*100, newText))

                    -- Mulai memancing jika fill baru naik dari 0
                    if pet.StartTime == nil and scale > 0.02 and scale < 0.5 then
                        pet.StartTime = now
                        send("⏱️ " .. pet.Name .. " mulai memancing...")
                    end

                    -- Selesai jika fill penuh
                    if scale > 0.95 and pet.StartTime then
                        local elapsed = now - pet.StartTime
                        send(string.format("✅ %s selesai dalam %.2fs (expected %ds)", pet.Name, elapsed, pet.ExpectedDuration))
                        if elapsed < pet.ExpectedDuration * 0.8 then
                            send("🚨 BUG COOLDOWN SKIP TERDETEKSI pada " .. pet.Name .. "!")
                        end
                        pet.StartTime = nil
                    end

                    pet.LastFillSize = newSize
                end
            end
        end
        task.wait(0.1)
    end
end)

