-- 1. Dump seluruh isi GUI Fishing (nama, kelas, properti penting)
local fishingGUI = LP.PlayerGui:FindFirstChild("Fishing")
if fishingGUI then
    send("📦 GUI Fishing ditemukan. Mengurai struktur...")
    local dump = ""
    for _, child in pairs(fishingGUI:GetDescendants()) do
        local info = child.Name .. " [" .. child.ClassName .. "] "
        if child:IsA("TextLabel") then
            info = info .. "Text='" .. child.Text .. "' "
        elseif child:IsA("Frame") then
            info = info .. "Size=" .. tostring(child.Size) .. " "
        elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
            info = info .. "Image=" .. tostring(child.Image) .. " "
        elseif child:IsA("LocalScript") or child:IsA("ModuleScript") then
            info = info .. "ScriptSourceAvailable=" .. (pcall(function() return child.Source end) and "yes" or "no") .. " "
        end
        if child:GetAttribute("Cooldown") then
            info = info .. "CooldownAttr=" .. tostring(child:GetAttribute("Cooldown")) .. " "
        end
        if child:GetAttribute("PetName") then
            info = info .. "PetNameAttr=" .. tostring(child:GetAttribute("PetName")) .. " "
        end
        if #dump + #info + 2 > 1900 then
            send("```\n" .. dump .. "\n```")
            dump = ""
        end
        dump = dump .. info .. "\n"
    end
    if #dump > 0 then send("```\n" .. dump .. "\n```") end
else
    send("❌ GUI Fishing tidak ada.")
end

-- 2. Inspeksi model pet Otter dan Axolotl (cari script, humanoid, animasi)
local petNames = {"Otter", "Axolotl"}
for _, name in ipairs(petNames) do
    local pet = WS:FindFirstChild(name)
    if pet then
        send("🐾 Inspeksi " .. name .. ":")
        local details = ""
        for _, child in pairs(pet:GetDescendants()) do
            details = details .. child.Name .. " [" .. child.ClassName .. "]\n"
            if child:IsA("LocalScript") or child:IsA("ModuleScript") then
                -- coba ambil source
                local ok, src = pcall(function() return child.Source end)
                if ok and src then
                    send("📜 Source " .. child.Name .. ":\n```lua\n" .. src:sub(1, 1500) .. "\n```")
                end
            end
            if child:IsA("Animation") then
                details = details .. "  AnimationId: " .. tostring(child.AnimationId) .. "\n"
            end
        end
        if #details > 0 then send("```\n" .. details .. "\n```") end
    end
end

-- 3. Polling agresif pada label yang mengandung teks cooldown (22s, 35s, dll.)
send("🔍 Memulai polling teks cooldown...")
local cooldownLabels = {}
if fishingGUI then
    for _, obj in pairs(fishingGUI:GetDescendants()) do
        if obj:IsA("TextLabel") then
            if obj.Text:match("%d+s") then
                table.insert(cooldownLabels, obj)
                send("Target label: " .. obj.Name .. " Text: " .. obj.Text)
            end
        end
    end
end

if #cooldownLabels == 0 then
    send("❌ Tidak ada label cooldown ditemukan. Mencari alternatif...")
    -- Cari semua label teks
    if fishingGUI then
        for _, obj in pairs(fishingGUI:GetDescendants()) do
            if obj:IsA("TextLabel") then
                table.insert(cooldownLabels, obj)
            end
        end
    end
end

-- Polling setiap 0.2 detik, catat perubahan
local lastTexts = {}
for _, label in pairs(cooldownLabels) do
    lastTexts[label] = label.Text
end

spawn(function()
    while true do
        for _, label in pairs(cooldownLabels) do
            if label.Parent then
                if label.Text ~= lastTexts[label] then
                    send("⏱️ " .. label.Name .. ": \"" .. lastTexts[label] .. "\" -> \"" .. label.Text .. "\"")
                    lastTexts[label] = label.Text
                end
            end
        end
        task.wait(0.2)
    end
end)

send("✅ Inspeksi selesai, polling berjalan. Lakukan mancing + pemicu bug.")
