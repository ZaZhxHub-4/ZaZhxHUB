-- ------------------------------------------------------------
-- 1. Hook fungsi di dalam modul Pets (getsenv)
-- ------------------------------------------------------------
local function hookModule(name)
    local found = false
    for _, mod in ipairs(getloadedmodules()) do
        if mod.Name == name and mod:IsA("ModuleScript") then
            local env = getsenv(mod)
            if not env then
                send("⚠️ getsenv " .. name .. " gagal.")
                break
            end
            for k, v in pairs(env) do
                if type(v) == "function" then
                    local fname = tostring(k)
                    pcall(function()
                        local old = v
                        env[k] = function(...)
                            local args = {...}
                            local argsStr = ""
                            for i, a in ipairs(args) do
                                argsStr = argsStr .. tostring(a):sub(1, 30) .. (i == #args and "" or ", ")
                            end
                            send("⚙️ [Internal:" .. name .. "] " .. fname .. "(" .. argsStr .. ")")
                            return old(...)
                        end
                    end)
                end
            end
            send("✅ Hook dipasang pada semua fungsi di " .. name)
            found = true
            break
        end
    end
    if not found then
        send("❌ Modul " .. name .. " tidak ditemukan di memori.")
    end
end

hookModule("Pets")
hookModule("CmdrClient")

