-- 3. Fungsi untuk klik tombol
local function clickButton(btn)
    if not btn then return end
    pcall(function()
        local pos = btn.AbsolutePosition + btn.AbsoluteSize/2
        -- Simulasi klik kiri
        firesignal(UIS.InputBegan, {
            UserInputType = Enum.UserInputType.MouseButton1,
            Position = pos,
            Delta = Vector2.new(0, 0)
        })
        task.wait(0.05)
        firesignal(UIS.InputEnded, {
            UserInputType = Enum.UserInputType.MouseButton1,
            Position = pos,
            Delta = Vector2.new(0, 0)
        })
    end)
end

-- 4. Loop monitoring dan trigger
spawn(function()
    while true do
        local now = tick()
        for _, pet in ipairs(pets) do
            if pet.Fill.Parent then
                local newSize = pet.Fill.Size
                local newText = pet.Label.Text

                -- Deteksi jika fill berubah (progress)
                if newSize ~= pet.LastFillSize then
                    local info = string.format("📊 %s Fill: %s -> %s (Text: %s)", pet.Name, tostring(pet.LastFillSize), tostring(newSize), newText)
                    send(info)

                    -- Jika fill mulai dari 0 (mulai fishing)
                    if newSize.X.Scale < 0.05 and (pet.StartTime == nil or (now - pet.StartTime) > 1) then
                        pet.StartTime = now
                        send("⏱️ " .. pet.Name .. " mulai memancing.")
                    end

                    -- Jika fill penuh (selesai)
                    if newSize.X.Scale > 0.95 and pet.StartTime then
                        local duration = now - pet.StartTime
                        local expected = 22 -- default, bisa disesuaikan
                        if pet.Name == "Penguin" then expected = 35
                        elseif pet.Name == "Capybara" then expected = 65
                        end
                        send("✅ " .. pet.Name .. " selesai dalam " .. string.format("%.2f", duration) .. "s (expected " .. expected .. "s)")
                        if duration < expected * 0.8 then
                            send("🚨 BUG SKIP TERJADI! " .. pet.Name .. " terlalu cepat!")
                        end
                        pet.StartTime = nil
                    end

                    pet.LastFillSize = newSize
                end

                if newText ~= pet.LastText then
                    send("💬 " .. pet.Name .. " Label: \"" .. pet.LastText .. "\" -> \"" .. newText .. "\"")
                    pet.LastText = newText
                end
            end
        end
        task.wait(0.1)
    end
end)

