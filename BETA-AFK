-- 1. Kumpulkan semua pet dengan PetFishingStatus BillboardGui
local pets = {}
for _, model in pairs(WS:GetChildren()) do
    if model:IsA("Model") and model:FindFirstChild("PetFishingStatus") then
        local gui = model.PetFishingStatus
        local fill = gui.Frame.Fill
        local label = gui.Frame.Label
        table.insert(pets, {
            Name = model.Name,
            Model = model,
            Gui = gui,
            Fill = fill,
            Label = label,
            LastFillSize = fill.Size,
            LastText = label.Text,
            StartTime = nil
        })
        send("🐾 Pet terdaftar: " .. model.Name .. " - Fill size: " .. tostring(fill.Size))
    end
end

if #pets == 0 then
    send("❌ Tidak ada pet dengan PetFishingStatus.")
    return
end

