-- 2. Hook RemoteEvent/Fungsi di sleitnick_net yang relevan (hanya log)
-- ------------------------------------------------------------
local netFolder = RS.Packages._Index["sleitnick_net@0.2.0"].net
local keywords = {"Fish", "Pet", "Auto", "Fishing", "Catch", "Bait", "Minigame"}

local function hookRemote(obj, label)
    if obj:IsA("RemoteEvent") then
        pcall(function()
            local oldFire = obj.FireServer
            obj.FireServer = function(self, ...)
                local args = {...}
                local argsStr = ""
                for i, a in ipairs(args) do
                    argsStr = argsStr .. tostring(a):sub(1, 30) .. (i == #args and "" or ", ")
                end
                send("📤 [Server:" .. label .. "] FireServer(" .. argsStr .. ")")
                return oldFire(self, ...)
            end
        end)
    elseif obj:IsA("RemoteFunction") then
        pcall(function()
            local oldInvoke = obj.InvokeServer
            obj.InvokeServer = function(self, ...)
                local args = {...}
                local argsStr = ""
                for i, a in ipairs(args) do
                    argsStr = argsStr .. tostring(a):sub(1, 30) .. (i == #args and "" or ", ")
                end
                send("📤 [Server:" .. label .. "] InvokeServer(" .. argsStr .. ")")
                return oldInvoke(self, ...)
            end
        end)
    end
end

for _, obj in ipairs(netFolder:GetChildren()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        local name = obj.Name
        for _, kw in ipairs(keywords) do
            if name:lower():find(kw:lower()) then
                hookRemote(obj, name)
                send("🪝 Hook " .. name)
                break
            end
        end
    end
end

